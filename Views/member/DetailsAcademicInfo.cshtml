@model MOHRecognition.Services.RecognitionRequestRecord
@using System
@using System.Linq
@{
    Layout = null;
    ViewData["Title"] = "Request Details - Academic Info";
    var adminReadOnly = (bool)(ViewBag.AdminReadOnly ?? false);
    var memberViewOnly = (bool)(ViewBag.MemberViewOnly ?? false);
    var readOnlyMode = adminReadOnly || memberViewOnly;
    ViewData["ActiveNav"] = memberViewOnly ? "archive" : "requests";
    var adminMeetingId = (int)(ViewBag.AdminMeetingId ?? 0);
    var requestId = ViewBag.RequestId ?? Model?.Id ?? 0;
    var inst = ViewBag.InstitutionName ?? Model?.UniversityName ?? "—";
    var previousLink = adminReadOnly
        ? Url.Action("AdminDetailsAdmissionDuration", "Home", new { id = requestId, meetingId = adminMeetingId })
        : Url.Action("DetailsAdmissionDuration", "Home", new { id = requestId });
    var nextLink = adminReadOnly
        ? Url.Action("AdminDetailsAccreditationBodies", "Home", new { id = requestId, meetingId = adminMeetingId })
        : Url.Action("DetailsAccreditationBodies", "Home", new { id = requestId });
    var isManual = (bool)(ViewBag.IsManual ?? false);
    var A = Model?.AcademicInfo ?? new DTOs.AcademicInfoDto();

    string YesNo(bool value) => value ? "Yes" : "No";
    var teachingMethods = (A.TeachingMethodsCsv ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
    var assessmentMethods = (A.AssessmentMethodsCsv ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
    var platforms = (A.PlatformsCsv ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
    var eAssessmentMethods = (A.EAssessmentMethodsCsv ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToList();
    var studyPlanRows = Model?.StudyPlanComplianceRows ?? new List<DTOs.StudyPlanComplianceRowDto>();
    var programs = Model?.Programs ?? new List<DTOs.ProgramRowDto>();
    var attachments = Model?.Attachments?.Rows ?? new List<DTOs.AttachmentRowDto>();
    var medDen = Model?.MedicineDentistry ?? new DTOs.MedicineDentistryDto();
    var hospitals = Model?.Hospitals ?? new DTOs.HospitalsDto();
    var hospitalFacilities = hospitals.Facilities ?? new List<DTOs.HospitalFacilityDto>();
    string NormalizeHospitalDocType(string? rawType)
    {
        var type = (rawType ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(type))
            return string.Empty;

        if (string.Equals(type, "LocalRecognition", StringComparison.OrdinalIgnoreCase))
            return "LocalRecognition";
        if (string.Equals(type, "LocalAccreditation", StringComparison.OrdinalIgnoreCase))
            return "LocalAccreditation";
        if (string.Equals(type, "RegionalAccreditation", StringComparison.OrdinalIgnoreCase))
            return "RegionalAccreditation";
        if (string.Equals(type, "InternationalAccreditation", StringComparison.OrdinalIgnoreCase))
            return "InternationalAccreditation";
        if (string.Equals(type, "OtherAccreditation", StringComparison.OrdinalIgnoreCase))
            return "OtherAccreditation";
        if (string.Equals(type, "HospitalAgreement", StringComparison.OrdinalIgnoreCase))
            return "HospitalAgreement";

        if (string.Equals(type, "University-Hospital Agreement", StringComparison.OrdinalIgnoreCase))
            return "HospitalAgreement";
        if (string.Equals(type, "Local Recognition Document", StringComparison.OrdinalIgnoreCase))
            return "LocalRecognition";
        if (string.Equals(type, "Recognition Document", StringComparison.OrdinalIgnoreCase))
            return "LocalRecognition";

        if (type.StartsWith("Recognition Document (", StringComparison.OrdinalIgnoreCase))
            return "LocalRecognition";

        if (type.StartsWith("Accreditation Document (", StringComparison.OrdinalIgnoreCase))
        {
            var open = type.IndexOf('(');
            var close = type.LastIndexOf(')');
            var inner = (open >= 0 && close > open)
                ? type.Substring(open + 1, close - open - 1).Trim()
                : string.Empty;

            if (inner.Equals("Local", StringComparison.OrdinalIgnoreCase))
                return "LocalAccreditation";
            if (inner.Equals("Regional", StringComparison.OrdinalIgnoreCase))
                return "RegionalAccreditation";
            if (inner.Equals("International", StringComparison.OrdinalIgnoreCase))
                return "InternationalAccreditation";

            return "OtherAccreditation";
        }

        if (string.Equals(type, "Accreditation Document", StringComparison.OrdinalIgnoreCase))
            return "OtherAccreditation";

        return type;
    }

    var typedHospitalDocuments = (hospitals.Documents ?? new List<DTOs.HospitalFileDto>())
        .Where(x => !string.IsNullOrWhiteSpace(x.FileUrl))
        .Select(x => new { Doc = x, Type = NormalizeHospitalDocType(x.DocumentType) })
        .Where(x => !string.IsNullOrWhiteSpace(x.Type))
        .OrderBy(x => x.Type)
        .ThenByDescending(x => x.Doc.UploadedAt ?? DateTime.MinValue)
        .ThenBy(x => x.Doc.OriginalFileName)
        .ToList();

    var localRecognitionDocs = typedHospitalDocuments.Where(x => x.Type == "LocalRecognition").Select(x => x.Doc).ToList();
    var localAccreditationDocs = typedHospitalDocuments.Where(x => x.Type == "LocalAccreditation").Select(x => x.Doc).ToList();
    var regionalAccreditationDocs = typedHospitalDocuments.Where(x => x.Type == "RegionalAccreditation").Select(x => x.Doc).ToList();
    var internationalAccreditationDocs = typedHospitalDocuments.Where(x => x.Type == "InternationalAccreditation").Select(x => x.Doc).ToList();
    var otherAccreditationDocs = typedHospitalDocuments.Where(x => x.Type == "OtherAccreditation").Select(x => x.Doc).ToList();
    var hospitalAgreementDocs = typedHospitalDocuments.Where(x => x.Type == "HospitalAgreement").Select(x => x.Doc).ToList();
    var facilityAgreementDocs = hospitalAgreementDocs
        .Where(x => !string.IsNullOrWhiteSpace(x.FacilityId))
        .GroupBy(x => x.FacilityId.Trim(), StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);

    int NV(int? v) => v ?? 0;

    bool RowCompliant(DTOs.StudyPlanComplianceRowDto r)
    {
        var totalPlanHours = r.UniversityRequirementsHours + r.FacultyRequirementsHours + r.SpecializationRequirementsHours;
        var p = programs.FirstOrDefault(x => x.Id == r.ProgramId);
        var hasProgram = p != null;
        var creditMatch = !hasProgram || totalPlanHours > 0;
        var uniValid = r.UniversityRequirementsHours >= 21 && r.UniversityRequirementsHours <= 27;
        var facValid = totalPlanHours > 0 && r.FacultyRequirementsHours <= Math.Floor(totalPlanHours * 0.15m);
        var specValid = totalPlanHours > 0 && r.SpecializationRequirementsHours >= Math.Ceiling(totalPlanHours * 0.60m);
        var splitValid = (r.SpecializationTheoreticalPercent + r.SpecializationPracticalPercent) == 100
                         && r.SpecializationTheoreticalPercent >= 40 && r.SpecializationTheoreticalPercent <= 50
                         && r.SpecializationPracticalPercent >= 50 && r.SpecializationPracticalPercent <= 60;
        var domainsValid = r.BasicDomainsCount >= 4;
        var trainingValid = r.PracticalTrainingMonths >= 3;
        var projectValid = r.GraduationProjectHours >= 3;

        return uniValid && facValid && specValid && splitValid && domainsValid && trainingValid && projectValid && creditMatch;
    }

    var studyPlanOkCount = studyPlanRows.Count(RowCompliant);
    var studyPlanLevel = studyPlanRows.Count == 0 ? 2 : (studyPlanOkCount == studyPlanRows.Count ? 0 : 1);

    var anyDegree = A.DegreeDiploma || A.DegreeBSC || A.DegreeHigherDiploma || A.DegreeMaster || A.DegreePhD;
    var hasType = !string.IsNullOrWhiteSpace(A.TypeOfAcademicInstitution);
    var recognitionMissing = !string.Equals(A.OfficialRecognitionInHomeCountry, "Yes", StringComparison.OrdinalIgnoreCase);
    var accreditationMissing = !string.Equals(A.OfficialAccreditationQualityInHomeCountry, "Yes", StringComparison.OrdinalIgnoreCase);
    var degreeTypeMismatch = string.Equals(A.TypeOfAcademicInstitution, "International", StringComparison.OrdinalIgnoreCase)
                     && A.DegreeDiploma && !A.DegreeBSC && !A.DegreeMaster && !A.DegreePhD;

    var identityLevel = 0;
    if (!hasType || !anyDegree || recognitionMissing || accreditationMissing) identityLevel = 2;
    else if (degreeTypeMismatch) identityLevel = 1;

    var anySystem = A.SystemYearlyProgram || A.SystemSemesterProgram || A.SystemCreditHours || A.SystemECTS;

    var structureLevel = 0;
    if (!anySystem) structureLevel = 2;

    var hasTeaching = teachingMethods.Any();
    var hasAssessment = assessmentMethods.Any();
    var usesELearningYes = string.Equals(A.UsesELearning, "Yes", StringComparison.OrdinalIgnoreCase);
    var usesELearningNo = string.Equals(A.UsesELearning, "No", StringComparison.OrdinalIgnoreCase);
    var ePct = A.ELearningPercentage ?? -1;
    var ePctValid = ePct >= 0 && ePct <= 100;
    var deliveryValid = !string.IsNullOrWhiteSpace(A.DeliveryType);
    var eLearningRequiredValid = !usesELearningYes || (deliveryValid && ePctValid);
    var programLooksMedical = teachingMethods.Any(x => string.Equals(x, "Clinical Training", StringComparison.OrdinalIgnoreCase));
    var professionalRegValid = !programLooksMedical || !string.IsNullOrWhiteSpace(A.ForeignGraduatesAllowedToPractice);

    var teachingLevel = 0;
    if (!hasTeaching || !hasAssessment || !eLearningRequiredValid) teachingLevel = 2;
    else if (!professionalRegValid) teachingLevel = 1;

    var overallLevel = Math.Max(Math.Max(identityLevel, structureLevel), Math.Max(teachingLevel, studyPlanLevel));

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl   = culture == "ar";
    var dir     = isRtl ? "rtl" : "ltr";

    string ClinicalRatioClass(double? r) => r == null ? "" : r <= 16.5 ? "ok" : r <= 20.625 ? "warn" : "fail";
    string ClinicalRatioText(double? r) => r == null ? "N/A" : r <= 16.5 ? (isRtl ? "مقبول" : "Acceptable") : r <= 20.625 ? (isRtl ? "تحذير" : "Warning") : (isRtl ? "يتجاوز الحد" : "Exceeds Limit");
    string Fmt2(double d) => d.ToString("F2");
}
<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "تفاصيل الطلب — المعلومات الأكاديمية" : "Request Details - Academic Info")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/member/RecognitionMemberDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member/DetailsAcademicInfo.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="rm-page @(isRtl ? "rtl-body" : "")">
    <header class="rm-header">
        <div class="rm-brandbar"></div><div class="rm-top">
            <div class="rm-top-inner">
                <div class="rm-brand"><img class="rm-logo" src="@Url.Content("~/images/mohelogo.png")" alt="MOHE Logo" /></div>
                <div class="rm-user">
                    <a class="rm-user-card" href="/Home/Profile">
                        <div class="rm-user-avatar">@(adminReadOnly ? "A" : ((ViewBag.CurrentRecognitionMember as string)?.Substring(0,1)?.ToUpper() ?? "M"))</div>
                        <div class="rm-user-card-text">
                            <strong>@(adminReadOnly ? (isRtl ? "مراجعة المدير" : "Admin Review") : (ViewBag.CurrentRecognitionMember ?? (isRtl ? "عضو لجنة الاعتراف" : "Recognition Committee Member")))</strong>
                            <span>@(adminReadOnly ? (isRtl ? "عرض المدير" : "Admin View") : (isRtl ? "عضو لجنة الاعتراف" : "Recognition Committee Member"))</span>
                        </div>
                        <i class="bi bi-gear-fill rm-gear-icon"></i>
                    </a>
                    <a class="rm-btn rm-btn-light" href="@Url.Action("Logout", "Home")"><i class="bi bi-box-arrow-right"></i> @(isRtl ? "تسجيل الخروج" : "Logout")</a>
                </div>
            </div>
        </div>
    </header>

    <div class="rm-shell">
        @if (adminReadOnly)
        {
            @await Html.PartialAsync("_AdminReviewSidebar")
        }
        else
        {
            @await Html.PartialAsync("_MemberSidebar")
        }

        <main class="rm-main">
            <section class="rm-card rd-head">
                <div>
                    <h1>@(isRtl ? "تفاصيل الطلب" : "Request Details")</h1>
                    <p class="rd-inst">@(isRtl ? "المؤسسة: " : "Institution: ")<b>@inst</b></p>
                    <p>@(isRtl ? "الخطوة 4 من 7 — مراجعة المعلومات الأكاديمية." : "Step 4 of 7 — Academic Information Review.")</p>
                </div>
                <div class="rd-meta">
                    <div class="meta-pill"><span>@(isRtl ? "رقم الطلب" : "Request ID")</span><b>#@requestId</b></div>
                    <div class="meta-pill"><span>@(isRtl ? "الخطوة" : "Step")</span><b>4 / 7</b></div>
                </div>
            </section>

            @if (readOnlyMode)
            {
                <section class="rm-card" style="border:1px solid #fedf89; background:#fffaeb; color:#7a2e0e; font-weight:700;">
                    <i class="bi bi-eye"></i> @(isRtl ? "وضع العرض فقط: هذه الجامعة معيّنة لعضو آخر." : "Read-only mode: this university is assigned to another member.")
                </section>
            }

            @if (isManual && !readOnlyMode)
            {
                <section class="rm-card" style="border:1px solid #bfdbfe; background:#eff6ff; color:#1e40af; font-weight:600; display:flex; align-items:center; gap:10px;">
                    <i class="bi bi-pencil-square" style="font-size:1.1rem;"></i>
                    @(isRtl ? "طلب يدوي — راجع المؤشرات الأكاديمية المحسوبة أدناه. بيانات الموظفين والطلاب أُدخلت في الخطوة السابقة." : "Manual Request — Review the computed academic indicators below. Staff and student data was entered in the previous step.")
                    <a class="rm-btn rm-btn-primary" href="@nextLink" style="@(isRtl ? "margin-right:auto" : "margin-left:auto"); white-space:nowrap;">
                        <i class="bi bi-arrow-@(isRtl ? "left" : "right")-circle"></i> @(isRtl ? "المتابعة إلى الخطوة التالية" : "Continue to Next Step")
                    </a>
                </section>
            }

            <section id="sec-hospitals" class="rm-card rd-card">
                <div class="rd-card-hd">
                    <h2><i class="bi bi-hospital"></i> @(isRtl ? "المستشفيات" : "Hospitals")</h2>
                    <p>@(isRtl ? "بيانات المستشفيات المُقدَّمة ومعلومات الاعتراف / الاعتماد." : "Submitted hospital data and recognition / accreditation information.")</p>
                </div>

                <div class="rd-card-hd" style="margin-top:10px;">
                    <h2 style="font-size:18px;"><i class="bi bi-building"></i> @(isRtl ? "بيانات المستشفيات المُقدَّمة من الجامعة" : "University Submitted Hospital Data")</h2>
                </div>
                <div class="clean-table-wrap">
                    <table class="clean-review-table">
                        <thead>
                            <tr>
                                <th style="width:72px;">#</th>
                                <th>@(isRtl ? "التخصص" : "Specialization")</th>
                                <th>@(isRtl ? "اسم المنشأة" : "Facility Name")</th>
                                <th>@(isRtl ? "الأسرّة" : "Beds")</th>
                                <th>@(isRtl ? "كراسي الأسنان" : "Dental Chairs")</th>
                                <th>@(isRtl ? "ملف الاتفاقية" : "Agreement File")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hospitalFacilities.Any())
                            {
                                for (var i = 0; i < hospitalFacilities.Count; i++)
                                {
                                    var row = hospitalFacilities[i];
                                    var rowId = (row.Id ?? string.Empty).Trim();
                                    var rowDocs = facilityAgreementDocs.TryGetValue(rowId, out var docs) ? docs : new List<DTOs.HospitalFileDto>();
                                    <tr>
                                        <td class="cell-index">@(i + 1)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Specialization) ? "—" : row.Specialization)</td>
                                        <td>@(string.IsNullOrWhiteSpace(row.Name)           ? "—" : row.Name)</td>
                                        <td>@(row.BedCapacity.HasValue        ? row.BedCapacity.Value.ToString()        : "—")</td>
                                        <td>@(row.DentalChairCapacity.HasValue ? row.DentalChairCapacity.Value.ToString() : "—")</td>
                                        <td>
                                            @if (rowDocs.Any())
                                            {
                                                <div class="table-actions">
                                                    <a class="rm-mini" href="@rowDocs[0].FileUrl" target="_blank" rel="noopener">@(isRtl ? $"عرض الملفات ({rowDocs.Count})" : $"View Files ({rowDocs.Count})")</a>
                                                </div>
                                            }
                                            else
                                            {
                                                @:—
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6">@(isRtl ? "لم يتم إدخال بيانات مستشفيات." : "No hospital data submitted.")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

            </section>

            <section id="sec-doctors-colleges" class="rm-card rd-card doctors-review-section">
                <div class="rd-card-hd">
                    <h2><i class="bi bi-person-vcard"></i> @(isRtl ? "الأطباء / كليات الطب" : "Doctors / Medicine Colleges")</h2>
                    <p>@(isRtl ? "أعداد العيادات بدوام جزئي مدرجة في الإجماليات." : "Part-time clinical counts are included in the totals.")</p>
                </div>

                <div class="studyplan-table-wrap">
                    <table class="rd-table doctors-review-table sst-ro-table">
                        <thead>
                            <tr>
                                <th class="sst-ro-cat-col">@(isRtl ? "الفئة" : "Category")</th>
                                <th>@(isRtl ? "كلية الطب" : "College of Medicine")</th>
                                <th>@(isRtl ? "كلية طب الأسنان" : "College of Dentistry")</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr class="sst-ro-total">
                                <td class="sst-ro-cat">@(isRtl ? "إجمالي الطلاب" : "Total Students")</td>
                                <td class="sst-ro-cell">
                                    <div class="value-stack">
                                        <div class="value-row">
                                            <span>@(isRtl ? "الطلاب" : "Students")</span>
                                            <b>@NV(medDen.Med_TotalStudents)</b>
                                        </div>
                                    </div>
                                </td>
                                <td class="sst-ro-cell">
                                    <div class="value-stack">
                                        <div class="value-row">
                                            <span>@(isRtl ? "الطلاب" : "Students")</span>
                                            <b>@NV(medDen.Den_TotalStudents)</b>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr class="sst-ro-phd-row">
                                <td class="sst-ro-cat">@(isRtl ? "أستاذ" : "Professor")</td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Med_PartTimeClinicalProfessor)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Den_PartTimeClinicalProfessor)</b></div></div></td>
                            </tr>

                            <tr class="sst-ro-phd-row">
                                <td class="sst-ro-cat">@(isRtl ? "أستاذ مشارك" : "Associate Professor")</td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeAssociateProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Med_PartTimeClinicalAssociateProfessor)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeAssociateProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Den_PartTimeClinicalAssociateProfessor)</b></div></div></td>
                            </tr>

                            <tr class="sst-ro-phd-row">
                                <td class="sst-ro-cat">@(isRtl ? "أستاذ مساعد" : "Assistant Professor")</td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeAssistantProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Med_PartTimeClinicalAssistantProfessor)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeAssistantProfessor)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Den_PartTimeClinicalAssistantProfessor)</b></div></div></td>
                            </tr>

                            <tr class="sst-ro-phd-row">
                                <td class="sst-ro-cat">@(isRtl ? "محاضر" : "Lecturer") <span class="sst-qual">(PhD)</span></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeLecturerPhd)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Med_PartTimeClinicalLecturerPhd)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeLecturerPhd)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Den_PartTimeClinicalLecturerPhd)</b></div></div></td>
                            </tr>

                            <tr>
                                <td class="sst-ro-cat">@(isRtl ? "محاضر" : "Lecturer") <span class="sst-qual">(MSc)</span>
                                    <div style="font-size:10px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:3px;padding:2px 5px;margin-top:4px;line-height:1.45;">
                                        <i class="bi bi-exclamation-triangle-fill" style="font-size:8px;"></i>
                                        @(isRtl ? "طب فقط: يجب حمل البورد الأول / مستوى أخصائي" : "Medicine only: must hold First Board / Specialist-level qualification")
                                    </div>
                                </td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeLecturerMsc)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeLecturerMsc)</b></div></div></td>
                            </tr>

                            <tr>
                                <td class="sst-ro-cat">@(isRtl ? "مدرس مساعد" : "Assistant Lecturer") <span class="sst-qual">(MSc)</span>
                                    <div style="font-size:10px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:3px;padding:2px 5px;margin-top:4px;line-height:1.45;">
                                        <i class="bi bi-exclamation-triangle-fill" style="font-size:8px;"></i>
                                        @(isRtl ? "طب فقط: يجب حمل البورد الأول / مستوى أخصائي" : "Medicine only: must hold First Board / Specialist-level qualification")
                                    </div>
                                </td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeAssistantLecturerMsc)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeAssistantLecturerMsc)</b></div></div></td>
                            </tr>

                            <tr class="sst-ro-phd-row">
                                <td class="sst-ro-cat">@(isRtl ? "مدرس مساعد" : "Assistant Lecturer") <span class="sst-qual">(PhD)</span>
                                    <div style="font-size:10px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:3px;padding:2px 5px;margin-top:4px;line-height:1.45;">
                                        <i class="bi bi-exclamation-triangle-fill" style="font-size:8px;"></i>
                                        @(isRtl ? "طب فقط: يجب حمل البورد المزدوج / مستوى استشاري" : "Medicine only: must hold Double Board / Consultant-level qualification")
                                    </div>
                                </td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimeAssistantLecturerPhd)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Med_PartTimeClinicalAssistantLecturerPhd)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimeAssistantLecturerPhd)</b></div><div class="value-row pt"><span>@(isRtl ? "دوام جزئي" : "Part-Time")</span><b>@NV(medDen.Den_PartTimeClinicalAssistantLecturerPhd)</b></div></div></td>
                            </tr>

                            <tr>
                                <td class="sst-ro-cat">@(isRtl ? "ممارس" : "Practitioner") <span class="sst-qual">(MSc)</span>
                                    <div style="font-size:10px;color:#065f46;background:#d1fae5;border:1px solid #6ee7b7;border-radius:3px;padding:2px 5px;margin-top:4px;line-height:1.45;">
                                        <i class="bi bi-stethoscope" style="font-size:8px;"></i>
                                        @(isRtl ? "للتدريب السريري/العملي فقط — لا يُحتسب محاضراً للتدريس النظري" : "Clinical/practical training only — not counted as lecturer for theoretical teaching")
                                    </div>
                                    <div style="font-size:10px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:3px;padding:2px 5px;margin-top:4px;line-height:1.45;">
                                        <i class="bi bi-exclamation-triangle-fill" style="font-size:8px;"></i>
                                        @(isRtl ? "طب فقط: يجب حمل البورد الأول / مستوى أخصائي" : "Medicine only: must hold First Board / Specialist-level qualification")
                                    </div>
                                </td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Med_FullTimePractitionerMsc)</b></div></div></td>
                                <td class="sst-ro-cell"><div class="value-stack"><div class="value-row"><span>@(isRtl ? "دوام كامل" : "Full-Time")</span><b>@NV(medDen.Den_FullTimePractitionerMsc)</b></div></div></td>
                            </tr>

                        </tbody>
                    </table>
                </div>


                @{
                    int _medFtTotal = (medDen.Med_FullTimeProfessor ?? 0) + (medDen.Med_FullTimeAssociateProfessor ?? 0) + (medDen.Med_FullTimeAssistantProfessor ?? 0)
                                    + (medDen.Med_FullTimeLecturerPhd ?? 0) + (medDen.Med_FullTimeAssistantLecturerPhd ?? 0)
                                    + (medDen.Med_FullTimeLecturerMsc ?? 0) + (medDen.Med_FullTimeAssistantLecturerMsc ?? 0)
                                    + (medDen.Med_FullTimePractitionerMsc ?? 0);
                    int _denFtTotal = (medDen.Den_FullTimeProfessor ?? 0) + (medDen.Den_FullTimeAssociateProfessor ?? 0) + (medDen.Den_FullTimeAssistantProfessor ?? 0)
                                    + (medDen.Den_FullTimeLecturerPhd ?? 0) + (medDen.Den_FullTimeAssistantLecturerPhd ?? 0)
                                    + (medDen.Den_FullTimeLecturerMsc ?? 0) + (medDen.Den_FullTimeAssistantLecturerMsc ?? 0)
                                    + (medDen.Den_FullTimePractitionerMsc ?? 0) + (medDen.Den_FullTimePractitionerPsc ?? 0);
                    int _medPtTotal = medDen.Med_TotalPartTime;
                    int _denPtTotal = medDen.Den_TotalPartTime;
                    int _medAllStaff = _medFtTotal + _medPtTotal;
                    int _denAllStaff = _denFtTotal + _denPtTotal;
                    string SV(int v) => v > 0 ? v.ToString("N0") : "—";
                }

                @if (!medDen.HasMedicine && !medDen.HasDentistry)
                {
                    <div style="background:#fef9c3;border:1px solid #fde68a;color:#78350f;border-radius:8px;padding:12px 16px;font-size:13px;text-align:center;margin:16px 0;">
                        <i class="bi bi-info-circle-fill"></i>
                        @(isRtl ? "لم يتم اختيار كلية سريرية (طب أو طب أسنان)" : "No clinical college (Medicine or Dentistry) selected — summary not applicable.")
                    </div>
                }
                else
                {
                <div style="margin-top:20px;margin-bottom:20px;">
                    <div style="font-size:11px;font-weight:800;color:#7f1627;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;padding-bottom:6px;border-bottom:1.5px solid #f0e8de;">@(isRtl ? "ملخص محسوب (للعرض فقط)" : "Computed Read-Only Summary")</div>
                    <div style="display:grid;grid-template-columns:@(medDen.HasMedicine && medDen.HasDentistry ? "1fr 1fr" : "1fr");gap:12px;">

                        @if (medDen.HasMedicine)
                        {
                        <div style="border:1px solid #ede4da;border-radius:10px;padding:14px;">
                            <div style="font-size:11px;font-weight:800;color:#7f1627;margin-bottom:10px;"><i class="bi bi-heart-pulse"></i> @(isRtl ? "كلية الطب" : "College of Medicine")</div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "حاملو دكتوراه (دوام كامل)" : "Full-Time PhD")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Med_PhdHolders)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "حاملو ماجستير (دوام كامل)" : "Full-Time MSc")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Med_MscLecturers)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "ممارسون (دوام كامل)" : "Full-Time Practitioner")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Med_PractitionerTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الدوام الجزئي" : "Part-Time Total")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_medPtTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الدوام الكامل" : "Total Full-Time")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_medFtTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الكادر (كامل + جزئي)" : "Total Staff (FT + PT)")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_medAllStaff)</div></div>
                            </div>
                            <div style="background:#d1fae5;border:1px solid #6ee7b7;color:#065f46;border-radius:6px;padding:8px 10px;font-size:11px;margin-top:10px;">
                                <i class="bi bi-info-circle-fill"></i>
                                @(isRtl ? "الممارسون محسوبون للتدريب السريري العملي فقط ولا يُحسبون محاضرين للتعليم النظري." : "Medicine note: Practitioners are counted for clinical/practical training only and are not counted as lecturers for theoretical teaching.")
                            </div>
                        </div>
                        }

                        @if (medDen.HasDentistry)
                        {
                        <div style="border:1px solid #ede4da;border-radius:10px;padding:14px;">
                            <div style="font-size:11px;font-weight:800;color:#7f1627;margin-bottom:10px;"><i class="bi bi-tooth"></i> @(isRtl ? "كلية طب الأسنان" : "College of Dentistry")</div>
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "حاملو دكتوراه (دوام كامل)" : "Full-Time PhD")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Den_PhdHolders)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "حاملو ماجستير (دوام كامل)" : "Full-Time MSc")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Den_MscLecturers)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "ممارسون (دوام كامل)" : "Full-Time Practitioner")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(medDen.Den_PractitionerTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الدوام الجزئي" : "Part-Time Total")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_denPtTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الدوام الكامل" : "Total Full-Time")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_denFtTotal)</div></div>
                                <div style="background:#faf7f3;border:1px solid #eee7de;border-radius:8px;padding:10px 12px;"><div style="font-size:10px;font-weight:800;color:#999;text-transform:uppercase;letter-spacing:.5px;">@(isRtl ? "إجمالي الكادر (كامل + جزئي)" : "Total Staff (FT + PT)")</div><div style="margin-top:5px;font-size:13.5px;font-weight:600;color:#111;">@SV(_denAllStaff)</div></div>
                            </div>
                        </div>
                        }

                    </div>
                </div>
                }

                <div style="display:flex;align-items:center;gap:8px;margin-top:18px;margin-bottom:10px;">
                    <h3 class="doctors-group-title" style="margin:0;">@(isRtl ? "نسبة الطبيب السريري إلى الطالب" : "Clinical Doctor-to-Student Ratio")</h3>
                    <button class="eq-info-btn" onclick="openEqModal('modal-clinical')" title="@(isRtl ? "كيف يُحسب ذلك؟" : "How is this calculated?")"><i class="bi bi-info-circle-fill"></i></button>
                </div>
                <div class="doctors-sfr-grid">

                    @if (medDen.HasMedicine)
                    {
                    <div class="doctors-sfr-card">
                        <div class="doctors-sfr-head">@(isRtl ? "كلية الطب" : "College of Medicine")</div>
                        <div class="doctors-sfr-body">
                            <span class="doctors-sfr-label">@(isRtl ? "نسبة الطبيب السريري إلى الطالب" : "Clinical Doctor-to-Student Ratio")</span>
                            <div class="doctors-sfr-result">
                                <span class="doctors-sfr-value">@(medDen.Med_StudentFacultyRatio.HasValue ? "1 : " + ((int)Math.Floor(medDen.Med_StudentFacultyRatio.Value)).ToString() : "—")</span>
                                <span class="status-badge @ClinicalRatioClass(medDen.Med_StudentFacultyRatio)">@ClinicalRatioText(medDen.Med_StudentFacultyRatio)</span>
                            </div>
                        </div>
                    </div>
                    }

                    @if (medDen.HasDentistry)
                    {
                    <div class="doctors-sfr-card">
                        <div class="doctors-sfr-head">@(isRtl ? "كلية طب الأسنان" : "College of Dentistry")</div>
                        <div class="doctors-sfr-body">
                            <span class="doctors-sfr-label">@(isRtl ? "نسبة الطبيب السريري إلى الطالب" : "Clinical Doctor-to-Student Ratio")</span>
                            <div class="doctors-sfr-result">
                                <span class="doctors-sfr-value">@(medDen.Den_StudentFacultyRatio.HasValue ? "1 : " + ((int)Math.Floor(medDen.Den_StudentFacultyRatio.Value)).ToString() : "—")</span>
                                <span class="status-badge @ClinicalRatioClass(medDen.Den_StudentFacultyRatio)">@ClinicalRatioText(medDen.Den_StudentFacultyRatio)</span>
                            </div>
                        </div>
                    </div>
                    }

                    @if (!medDen.HasMedicine && !medDen.HasDentistry)
                    {
                        <div style="color:#78350f;font-style:italic;font-size:13px;padding:12px;">@(isRtl ? "لم يتم اختيار كلية سريرية." : "No clinical college selected — ratio not applicable.")</div>
                    }

                </div>

            </section>

            <section class="rm-card rd-actions">
                <div class="rd-actions-left">
                    <a class="rm-btn rm-btn-light" href="@previousLink">@(isRtl ? "السابق" : "Previous")</a>
                </div>
                <div class="rd-actions-right">
                    <a class="rm-btn rm-btn-light" href="@nextLink">@(isRtl ? "التالي" : "Next")</a>
                </div>
            </section>
        </main>
    </div>

<div id="eq-modal-overlay" class="eq-modal-overlay" onclick="closeEqModalIfOverlay(event)">
    <div id="modal-clinical" class="eq-modal" role="dialog" aria-modal="true">
        <button class="eq-modal-close" onclick="closeEqModal()" aria-label="@(isRtl ? "إغلاق" : "Close")">✕</button>
        <div class="eq-modal-icon">🏥</div>
        <div class="eq-modal-title">@(isRtl ? "نسبة الطبيب السريري إلى الطالب" : "Clinical Doctor-to-Student Ratio")</div>
        <div class="eq-modal-subtitle">@(isRtl ? "كيف تُحسب نسبة الطلاب إلى أعضاء هيئة التدريس السريريين من حاملي الدكتوراه في الطب وطب الأسنان؟" : "How is the ratio of students to clinical PhD faculty calculated for Medicine and Dentistry?")</div>

        <div class="eq-threshold-row" style="margin-bottom:18px;">
            <span class="eq-thr-tag eq-thr-green"><i class="bi bi-check-circle-fill"></i> @(isRtl ? "النسبة ≤ 1 : 16.5 — مقبول" : "Ratio ≤ 1 : 16.5 — Acceptable")</span>
            <span class="eq-thr-tag eq-thr-orange"><i class="bi bi-exclamation-circle-fill"></i> @(isRtl ? "1 : 16.5 < النسبة ≤ 1 : 20.6 — تحذير" : "1 : 16.5 < Ratio ≤ 1 : 20.6 — Warning")</span>
            <span class="eq-thr-tag eq-thr-red"><i class="bi bi-x-circle-fill"></i> @(isRtl ? "النسبة > 1 : 20.6 — يتجاوز الحد" : "Ratio > 1 : 20.6 — Exceeds Limit")</span>
        </div>

        <div class="eq-step">
            <div class="eq-step-hd">@(isRtl ? "الخطوة 1 — تحديد أعضاء هيئة التدريس السريريين من حاملي الدكتوراه بدوام كامل" : "Step 1 — Identify Full-Time Clinical PhD Staff")</div>
            <div class="eq-step-body">
                @if (isRtl)
                {
                    <span>احسب جميع أعضاء هيئة التدريس السريريين <b>بدوام كامل</b> الحاملين لدرجة <b>الدكتوراه</b>. يُحسب ذلك <em>بشكل منفصل</em> للطب ولطب الأسنان:</span>
                }
                else
                {
                    <span>Count all <b>full-time</b> clinical faculty who hold a <b>PhD</b>. This is calculated <em>separately</em> for Medicine and for Dentistry:</span>
                }
                <ul class="eq-list">
                    <li><b>@(isRtl ? "أستاذ" : "Professor")</b> (@(isRtl ? "دوام كامل، سريري" : "Full-Time, clinical"))</li>
                    <li><b>@(isRtl ? "أستاذ مشارك" : "Associate Professor")</b> (@(isRtl ? "دوام كامل، سريري" : "Full-Time, clinical"))</li>
                    <li><b>@(isRtl ? "أستاذ مساعد" : "Assistant Professor")</b> (@(isRtl ? "دوام كامل، سريري" : "Full-Time, clinical"))</li>
                    <li><b>@(isRtl ? "محاضر حامل للدكتوراه" : "Lecturer with PhD")</b> (@(isRtl ? "دوام كامل، سريري" : "Full-Time, clinical"))</li>
                    <li><b>@(isRtl ? "مدرس مساعد حامل للدكتوراه" : "Assistant Lecturer with PhD")</b> (@(isRtl ? "دوام كامل، سريري" : "Full-Time, clinical"))</li>
                </ul>
                <div class="eq-step-note">@(isRtl ? "لا يشمل هذا الحساب المحاضرين من حاملي الماجستير أو الكادر غير السريري." : "MSc lecturers and non-clinical staff are not included in this count.")</div>
            </div>
        </div>

        <div class="eq-step">
            <div class="eq-step-hd">@(isRtl ? "الخطوة 2 — حساب الحد الأقصى المسموح به للدوام الجزئي" : "Step 2 — Calculate the Allowed Part-Time Limit")</div>
            <div class="eq-step-body">
                @if (isRtl)
                {
                    <span>يعتمد الحد الأقصى لعدد أعضاء هيئة التدريس السريريين بدوام جزئي الذين يمكن احتسابهم على عدد <b>أعضاء هيئة التدريس من حاملي الدكتوراه بدوام كامل (D)</b> في الكلية. يُحسب الحد وفق شرائح:</span>
                }
                else
                {
                    <span>The maximum number of part-time clinical staff that can be counted depends on how many <b>full-time PhD staff (D)</b> the college has. The limit is calculated in tiers:</span>
                }
                <div class="eq-step-formula" style="text-align:left;line-height:2;">
                    If D &lt; 50 &nbsp;&nbsp;&nbsp;→ &nbsp; Allowed PT = D × 0.25<br>
                    If 50 ≤ D ≤ 100 → &nbsp; Allowed PT = (50 × 0.25) + ((D − 50) × 0.35)<br>
                    If D &gt; 100 &nbsp;&nbsp;→ &nbsp; Allowed PT = (50 × 0.25) + (50 × 0.35) + ((D − 100) × 0.50)
                </div>
                <div class="eq-step-note">@(isRtl ? "كلما زاد عدد أعضاء هيئة التدريس من حاملي الدكتوراه بدوام كامل، زاد عدد أعضاء الدوام الجزئي المسموح باحتسابهم — لكن بمعدل متناقص. يمنع ذلك الإفراط في الاعتماد على الدوام الجزئي." : "The more full-time PhD staff a college has, the more part-time staff it is allowed to include — but at a decreasing rate. This prevents over-reliance on part-time staff.")</div>
                @(isRtl ? "ثم يُقيَّد الدوام الجزئي الفعلي المحتسب:" : "Then the actual counted part-time is capped:")
                <div class="eq-step-formula">Counted PT = min( Actual Part-Time Count, Allowed PT Limit )</div>
                <div class="eq-step-note">@(isRtl ? "إذا كانت الكلية توظف أعضاء دوام جزئي أكثر من الحد المسموح، يُحتسب العدد المسموح به فقط — ويُتجاهل الباقي." : "If the college employs more part-time staff than the allowed limit, only the allowed number is counted — the rest are ignored.")</div>
            </div>
        </div>

        <div class="eq-step">
            <div class="eq-step-hd">@(isRtl ? "الخطوة 3 — حساب الطاقة الكلية والنسبة" : "Step 3 — Calculate Total Capacity and Ratio")</div>
            <div class="eq-step-body">
                @(isRtl ? "تجمع الطاقة الكلية لأعضاء هيئة التدريس السريريين بين أعضاء الدوام الكامل من حاملي الدكتوراه وأعضاء الدوام الجزئي المحتسبين:" : "The total clinical faculty capacity combines full-time PhD staff with the counted part-time staff:")
                <div class="eq-step-formula">Capacity = FT PhD Staff (D) + Counted PT Staff</div>
                @(isRtl ? "ثم تُحسب النسبة بشكل منفصل لـ" : "Then the ratio is computed separately for") <b>@(isRtl ? "الطب" : "Medicine")</b> @(isRtl ? "و" : "and") <b>@(isRtl ? "طب الأسنان" : "Dentistry")</b>:
                <div class="eq-step-formula">Ratio = Total Students ÷ Capacity</div>
                <div class="eq-step-note">
                    @(isRtl ? "مثال: 500 طالب طب، D = 40 عضو هيئة تدريس بدوام كامل، عدد الدوام الجزئي الفعلي = 15" : "Example: 500 Medicine students, D = 40 FT PhD, Actual PT = 15")<br>
                    → Allowed PT = 40 × 0.25 = 10 &nbsp;|&nbsp; Counted PT = min(15, 10) = 10<br>
                    → Capacity = 40 + 10 = 50 &nbsp;|&nbsp; Ratio = 500 ÷ 50 = <b>1 : 10 → @(isRtl ? "مقبول" : "Acceptable")</b>
                </div>
            </div>
        </div>

        <div class="eq-step eq-step--result">
            <div class="eq-step-hd">@(isRtl ? "الخطوة 4 — حدود الامتثال" : "Step 4 — Compliance Thresholds")</div>
            <div class="eq-step-body">
                @(isRtl ? "تُقارن النتيجة بمعايير التعليم السريري الدولية الثابتة:" : "The result is compared to fixed international clinical education standards:")
                <div class="eq-threshold-row">
                    <span class="eq-thr-tag eq-thr-green"><i class="bi bi-check-circle-fill"></i> @(isRtl ? "النسبة ≤ 1 : 16.5 — مقبول" : "Ratio ≤ 1 : 16.5 — Acceptable")</span>
                    <span class="eq-thr-tag eq-thr-orange"><i class="bi bi-exclamation-circle-fill"></i> @(isRtl ? "1 : 16.5 < النسبة ≤ 1 : 20.6 — تحذير" : "1 : 16.5 < Ratio ≤ 1 : 20.6 — Warning")</span>
                    <span class="eq-thr-tag eq-thr-red"><i class="bi bi-x-circle-fill"></i> @(isRtl ? "النسبة > 1 : 20.6 — يتجاوز الحد" : "Ratio > 1 : 20.6 — Exceeds Limit")</span>
                </div>
                <div class="eq-step-note" style="margin-top:10px;">@(isRtl ? "تشير <b>النسبة الأدنى</b> (عدد أقل من الطلاب لكل طبيب) إلى جودة إشراف أفضل. يضمن معيار 1 : 16.5 قدرة كل عضو هيئة تدريس سريري على الإشراف الكافي على طلابه في بيئات المستشفيات والعيادات." : "A <b>lower ratio</b> (fewer students per doctor) indicates better supervision quality. The standard of 1 : 16.5 ensures each clinical faculty member can adequately supervise their students in hospital and clinical settings.")</div>
            </div>
        </div>
    </div>
</div>

<script>
    function openEqModal(id) {
        var overlay = document.getElementById('eq-modal-overlay');
        overlay.querySelectorAll('.eq-modal').forEach(function(m) { m.style.display = 'none'; });
        var modal = document.getElementById(id);
        if (modal) { modal.style.display = 'block'; }
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeEqModal() {
        document.getElementById('eq-modal-overlay').classList.remove('open');
        document.body.style.overflow = '';
    }
    function closeEqModalIfOverlay(e) {
        if (e.target === document.getElementById('eq-modal-overlay')) closeEqModal();
    }
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeEqModal();
    });
</script>
</body>
</html>
