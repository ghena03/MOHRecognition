@model IReadOnlyList<MOHRecognition.Services.RecognitionRequestRecord>

@{
    Layout = null;
    ViewData["Title"] = "My Assigned Requests";
    ViewData["ActiveNav"] = "requests";
    var currentMember = ViewBag.CurrentRecognitionMember as string ?? "Recognition Member";
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";

    string AppTypeStyle(string? t) => (t ?? "Bachelor") switch
    {
        "Postgraduate" => "background:#ede9fe;color:#5b21b6;border:1px solid #c4b5fd",
        "Online"       => "background:#dcfce7;color:#166534;border:1px solid #86efac",
        _              => "background:#dbeafe;color:#1e40af;border:1px solid #93c5fd"
    };
    string RowClass(string? t) => (t ?? "Bachelor") switch
    {
        "Postgraduate" => "app-row-postgraduate",
        "Online"       => "app-row-online",
        _              => "app-row-bachelor"
    };
    string TypeLabel(string? t) => isRtl
        ? (t ?? "Bachelor") switch { "Postgraduate" => "دراسات عليا", "Online" => "عبر الإنترنت", _ => "بكالوريوس" }
        : (t ?? "Bachelor");
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "طلباتي المعيّنة" : "My Assigned Requests")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/member/RecognitionMemberDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member/ElectronicRequests.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>

<body class="rm-page@(isRtl ? " rtl-body" : "")">

    <header class="rm-header">
        <div class="rm-brandbar"></div>
        <div class="rm-top">
            <div class="rm-top-inner">
                <div class="rm-brand">
                    <img class="rm-logo" src="@Url.Content("~/images/mohelogo.png")" alt="MOHE Logo" />
                </div>

                <div class="rm-user">
                    <a class="rm-user-card" href="/Home/Profile">
                        <div class="rm-user-avatar">@(currentMember?.Length > 0 ? currentMember.Substring(0,1).ToUpper() : "M")</div>
                        <div class="rm-user-card-text">
                            <strong>@currentMember</strong>
                            <span>@(isRtl ? "عضو لجنة الاعتراف" : "Recognition Committee Member")</span>
                        </div>
                        <i class="bi bi-gear-fill rm-gear-icon"></i>
                    </a>

                    <a class="rm-btn rm-btn-light" href="@Url.Action("Logout", "Home")">
                        <i class="bi bi-box-arrow-right"></i> @(isRtl ? "تسجيل الخروج" : "Logout")
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="rm-shell">

        @await Html.PartialAsync("_MemberSidebar")

        <main class="rm-main">

            <section class="rm-card er-hero">
                <div class="er-hero-top">
                    <div class="er-hero-left">
                        <h1>@(isRtl ? "طلباتي المعيّنة" : "My Assigned Requests")</h1>
                        <p>@(isRtl ? $"تظهر هنا فقط الطلبات المعيّنة إلى {currentMember}." : $"Only requests assigned to {currentMember} appear here.")</p>
                    </div>

                    <div class="er-stats">
                        <div class="er-stat">
                            <span>@(isRtl ? "معيّن" : "Assigned")</span>
                            <b>@Model.Count</b>
                        </div>
                        <div class="er-stat">
                            <span>@(isRtl ? "قيد الانتظار" : "Pending")</span>
                            <b>@Model.Count(x => x.Status == "Pending" || x.Status == "Assigned")</b>
                        </div>
                        <div class="er-stat">
                            <span>@(isRtl ? "مستندات ناقصة" : "Missing Docs")</span>
                            <b>@Model.Count(x => x.Status == "Missing Docs")</b>
                        </div>
                    </div>
                </div>

            </section>

            <section class="rm-card">
                <div class="rm-card-hd row">
                    <div>
                        <h2>@(isRtl ? "الطلبات المعيّنة" : "Assigned Requests")</h2>
                        <p>@(isRtl ? "هذه الطلبات معيّنة إليك من قِبَل المدير." : "These are the requests already assigned to you by admin.")</p>
                    </div>
                </div>

                <div class="rm-tablewrap">
                    <table class="rm-table">
                        <thead>
                            <tr>
                                <th>@(isRtl ? "الرقم المرجعي" : "Reference")</th>
                                <th>@(isRtl ? "النوع" : "Type")</th>
                                <th>@(isRtl ? "الجامعة" : "University")</th>
                                <th>@(isRtl ? "الدولة" : "Country")</th>
                                <th>@(isRtl ? "الحالة" : "Status")</th>
                                <th>@(isRtl ? "تاريخ التقديم" : "Submitted")</th>
                                <th style="text-align:center;">@(isRtl ? "إجراء" : "Action")</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr class="@RowClass(item.ApplicationType)">
                                        <td><b>@item.ReferenceNumber</b></td>
                                        <td><span style="display:inline-block;border-radius:20px;padding:3px 10px;font-size:11px;font-weight:700;@AppTypeStyle(item.ApplicationType)">@TypeLabel(item.ApplicationType)</span></td>
                                        <td>@item.UniversityName</td>
                                        <td>@item.Country</td>
                                        @{
                                        var dec = item.BasicInfoAssessmentDecision ?? "";
                                        string decLabel, decClass;
                                        if (string.IsNullOrWhiteSpace(dec))
                                        {
                                            decLabel = isRtl ? "قيد المراجعة" : "Pending Review";
                                            decClass = "badge-neutral";
                                        }
                                        else if (dec.Contains("Approve", StringComparison.OrdinalIgnoreCase) && !dec.Contains("Conditional", StringComparison.OrdinalIgnoreCase))
                                        {
                                            decLabel = isRtl ? "مقبول" : "Approved";
                                            decClass = "badge-ok";
                                        }
                                        else if (dec.Contains("Conditional", StringComparison.OrdinalIgnoreCase))
                                        {
                                            decLabel = isRtl ? "قبول مشروط" : "Conditional Approval";
                                            decClass = "badge-warn";
                                        }
                                        else if (dec.Contains("Reject", StringComparison.OrdinalIgnoreCase))
                                        {
                                            decLabel = isRtl ? "مرفوض" : "Rejected";
                                            decClass = "badge-returned";
                                        }
                                        else
                                        {
                                            decLabel = dec;
                                            decClass = "badge-neutral";
                                        }
                                    }
                                    <td><span class="badge @decClass">@decLabel</span></td>
                                        <td>@item.SubmittedAt.ToString("yyyy-MM-dd")</td>
                                        <td style="text-align:center;">
                                            @{
                                                var detailAction = (item.ApplicationType ?? "Bachelor") switch
                                                {
                                                    "Postgraduate" => "DetailsPostgraduateRequest",
                                                    "Online"       => "DetailsOnlineRequest",
                                                    _              => "DetailsBasicInfo"
                                                };
                                            }
                                            <a class="rm-mini" href="@Url.Action(detailAction, "Home", new { id = item.Id })">@(isRtl ? "فتح" : "Open")</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" style="text-align:center; padding:24px;">
                                        @(isRtl ? "لا توجد طلبات معيّنة حتى الآن." : "No assigned requests yet.")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="er-footer">
                    <button class="rm-btn rm-btn-light" type="button" disabled>
                        <i class="bi bi-chevron-@(isRtl ? "right" : "left")"></i> @(isRtl ? "السابق" : "Prev")
                    </button>
                    <div class="er-pages">@(isRtl ? "الصفحة" : "Page") <b>1</b> @(isRtl ? "من" : "of") <b>1</b></div>
                    <button class="rm-btn rm-btn-light" type="button" disabled>
                        @(isRtl ? "التالي" : "Next") <i class="bi bi-chevron-@(isRtl ? "left" : "right")"></i>
                    </button>
                </div>
            </section>

        </main>
    </div>

    <script src="~/js/member/ElectronicRequests.js" asp-append-version="true"></script>
</body>
</html>
