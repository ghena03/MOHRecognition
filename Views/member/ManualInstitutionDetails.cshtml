@model MOHRecognition.Services.RecognitionRequestRecord
@{
    Layout = null;
    ViewData["Title"] = "Institution Details";
    var currentMember   = ViewBag.CurrentRecognitionMember as string ?? "Recognition Member";
    var isBachelor      = string.Equals(Model.InstitutionType, "Bachelor",    StringComparison.OrdinalIgnoreCase);
    var isPostgraduate  = string.Equals(Model.InstitutionType, "Postgraduate", StringComparison.OrdinalIgnoreCase);

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl   = culture == "ar";
    var dir     = isRtl ? "rtl" : "ltr";

    string InstitutionTypeLabel(string? t) => isRtl ? (t ?? "") switch {
        "Bachelor"      => "بكالوريوس",
        "Postgraduate"  => "دراسات عليا",
        _               => t ?? ""
    } : (t ?? "");

    string StatusDisplayLabel(string? s) => isRtl ? (s ?? "") switch {
        "Completed" => "مكتمل",
        "Pending"   => "قيد الانتظار",
        "Assigned"  => "معيّن",
        _           => s ?? ""
    } : (s ?? "");
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "تفاصيل المؤسسة" : "Institution Details")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/member/RecognitionMemberDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/member/ElectronicRequests.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
    <style>
        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }

        .detail-item label {
            display: block; font-size: 12px; font-weight: 600; color: #888;
            text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px;
        }
        .detail-item span { font-size: 15px; font-weight: 500; color: #1a1a2e; }

        .type-banner {
            display: flex; align-items: center; gap: 16px;
            padding: 20px 24px; border-radius: 12px; margin-bottom: 24px; border: 2px solid;
        }
        .type-banner.bachelor    { background: #eef6ff; border-color: #3b82f6; color: #1d4ed8; }
        .type-banner.postgraduate{ background: #fdf4ff; border-color: #a855f7; color: #7c3aed; }
        .type-banner i           { font-size: 28px; }
        .type-banner-text h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; }
        .type-banner-text p  { margin: 0; font-size: 13px; opacity: .8; }

        .action-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; border-radius: 8px; font-size: 14px; font-weight: 600;
            text-decoration: none; margin-left: auto; white-space: nowrap;
        }
        html[dir="rtl"] .action-btn { margin-left: 0; margin-right: auto; }
        .action-btn.bachelor    { background: #3b82f6; color: #fff; }
        .action-btn.bachelor:hover { background: #2563eb; color: #fff; }
        .action-btn.postgraduate{ background: #a855f7; color: #fff; }
        .action-btn.postgraduate:hover { background: #7c3aed; color: #fff; }

        .badge-pending   { background: #fff3cd; color: #856404; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }
        .badge-completed { background: #d1fae5; color: #065f46; padding: 3px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }

        .back-link { display: inline-flex; align-items: center; gap: 6px; color: #666; text-decoration: none; font-size: 14px; margin-bottom: 20px; }
        .back-link:hover { color: #1a1a2e; }
    </style>
</head>

<body class="rm-page @(isRtl ? "rtl-body" : "")">

    <header class="rm-header">
        <div class="rm-brandbar"></div>
        <div class="rm-top">
            <div class="rm-top-inner">
                <div class="rm-brand">
                    <img class="rm-logo" src="@Url.Content("~/images/mohelogo.png")" alt="MOHE Logo" />
                </div>
                <div class="rm-user">
                    <a class="rm-user-card" href="/Home/Profile">
                        <div class="rm-user-avatar">@(currentMember?.Length > 0 ? currentMember.Substring(0,1).ToUpper() : "M")</div>
                        <div class="rm-user-card-text">
                            <strong>@currentMember</strong>
                            <span>@(isRtl ? "عضو لجنة الاعتراف" : "Recognition Committee Member")</span>
                        </div>
                        <i class="bi bi-gear-fill rm-gear-icon"></i>
                    </a>
                    <a class="rm-btn rm-btn-light" href="@Url.Action("Logout", "Home")">
                        <i class="bi bi-box-arrow-right"></i> @(isRtl ? "تسجيل الخروج" : "Logout")
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="rm-shell">

        @await Html.PartialAsync("_MemberSidebar")

        <main class="rm-main">

            <a class="back-link" href="@Url.Action("ManualInstitutionRequests", "Home")">
                <i class="bi bi-arrow-@(isRtl ? "right" : "left")"></i>
                @(isRtl ? "العودة إلى طلبات المؤسسات اليدوية" : "Back to Manual Requests")
            </a>

            <!-- Institution Type Banner + Fill Button -->
            @{
                var fillUrl    = Url.Action("StartManualFill", "Home", new { id = Model.Id });
                var bannerClass = isBachelor ? "bachelor" : (isPostgraduate ? "postgraduate" : "bachelor");
                var bannerIcon  = isBachelor ? "bi-mortarboard-fill" : "bi-journal-bookmark-fill";
                var bannerTitle = isRtl
                    ? (isBachelor ? "برنامج البكالوريوس" : (isPostgraduate ? "برنامج الدراسات العليا" : "برنامج الاعتراف"))
                    : (isBachelor ? "Bachelor Program"   : (isPostgraduate ? "Postgraduate Program"   : "Recognition Program"));
                var bannerDesc = isRtl
                    ? (isBachelor
                        ? "هذه المؤسسة معيّنة للاعتراف ببرامج البكالوريوس. أدخل بيانات الطلب من خلال صفحات المراجعة المعيارية."
                        : "هذه المؤسسة معيّنة للاعتراف ببرامج الدراسات العليا. أدخل بيانات الطلب من خلال صفحات المراجعة المعيارية.")
                    : (isBachelor
                        ? "This institution is assigned for Bachelor recognition. Fill the application data through the standard review pages."
                        : "This institution is assigned for Postgraduate recognition. Fill the application data through the standard review pages.");
            }
            <div class="type-banner @bannerClass">
                <i class="bi @bannerIcon"></i>
                <div class="type-banner-text">
                    <h3>@bannerTitle</h3>
                    <p>@bannerDesc</p>
                </div>
                <a class="action-btn @bannerClass" href="@fillUrl">
                    <i class="bi bi-pencil-square"></i>
                    @(isRtl ? "تعبئة الطلب" : "Fill Application")
                </a>
            </div>

            <!-- Details Card -->
            <section class="rm-card">

                <div class="rm-card-hd row" style="margin-bottom:24px;">
                    <div>
                        <h2>@Model.UniversityName</h2>
                        <p>@(isRtl ? "الرقم المرجعي:" : "Reference:") <b>@Model.ReferenceNumber</b></p>
                    </div>
                    <span class="badge-pending">@StatusDisplayLabel(Model.Status)</span>
                </div>

                <div class="detail-grid">

                    <div class="detail-item">
                        <label>@(isRtl ? "اسم المؤسسة" : "Institution Name")</label>
                        <span>@Model.UniversityName</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "الدولة" : "Country")</label>
                        <span>@Model.Country</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "الرقم المرجعي" : "Reference Number")</label>
                        <span>@Model.ReferenceNumber</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "نوع المؤسسة" : "Institution Type")</label>
                        <span>@InstitutionTypeLabel(Model.InstitutionType)</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "العضو المعيّن" : "Assigned Member")</label>
                        <span>@currentMember</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "تاريخ التقديم" : "Submitted On")</label>
                        <span>@Model.SubmittedAt.ToString("yyyy-MM-dd")</span>
                    </div>

                    <div class="detail-item">
                        <label>@(isRtl ? "الحالة" : "Status")</label>
                        <span>
                            @if (Model.Status == "Completed")
                            {
                                <span class="badge-completed">@StatusDisplayLabel(Model.Status)</span>
                            }
                            else
                            {
                                <span class="badge-pending">@StatusDisplayLabel(Model.Status)</span>
                            }
                        </span>
                    </div>

                </div>

            </section>

        </main>
    </div>

</body>
</html>
