@{
    var active = ViewData["ActiveNav"] as string ?? "";
    var scheduledCount = (int)(ViewBag.ScheduledMeetingsCount ?? 0);
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
}
<aside class="rm-sidebar">
    <div class="rm-side-label">@(isRtl ? "مساحة العمل" : "Workspace")</div>
    <nav class="rm-nav">
        <a class="rm-navitem@(active == "dashboard" ? " active" : "")" href="@Url.Action("RecognitionMemberDashboard", "Home")">
            <i class="bi bi-grid-1x2-fill"></i><span>@(isRtl ? "لوحة التحكم" : "Dashboard")</span>
        </a>
        <a class="rm-navitem@(active == "requests" ? " active" : "")" href="@Url.Action("ElectronicRequests", "Home")">
            <i class="bi bi-journal-check"></i><span>@(isRtl ? "طلباتي المعيّنة" : "My Assigned Requests")</span>
        </a>
        <a class="rm-navitem@(active == "manualrequests" ? " active" : "")"
           href="@Url.Action("ManualInstitutionRequests", "Home")">
            <i class="bi bi-building-add"></i>
            <span>@(isRtl ? "طلبات المؤسسات اليدوية" : "Manual Institution Requests")</span>
        </a>
        <a class="rm-navitem@(active == "archive" ? " active" : "")" href="@Url.Action("Archive", "Home")">
            <i class="bi bi-inboxes"></i><span>@(isRtl ? "أرشيف الطلبات" : "Requests Archive")</span>
        </a>
        <a class="rm-navitem@(active == "history" ? " active" : "")" href="@Url.Action("MemberReviewHistory", "Home")">
            <i class="bi bi-clock-history"></i><span>@(isRtl ? "سجل مراجعاتي" : "My Review History")</span>
        </a>
        <a class="rm-navitem@(active == "meetings" ? " active" : "")" href="@Url.Action("RecognitionMemberMeetings", "Home")"
           style="position:relative;">
            <i class="bi bi-calendar2-week"></i>
            <span>@(isRtl ? "الاجتماعات" : "Meetings")</span>
            @if (scheduledCount > 0)
            {
                <span style="
                    display:inline-flex;align-items:center;justify-content:center;
                    background:#7f1627;color:#fff;
                    font-size:10px;font-weight:800;
                    min-width:18px;height:18px;border-radius:9px;padding:0 5px;
                    margin-left:auto;line-height:1;">@scheduledCount</span>
            }
        </a>
        <div class="rm-nav-divider"></div>
        <div style="padding:8px 14px 4px;">
            @await Html.PartialAsync("~/Views/Shared/_LanguageSwitcher.cshtml")
        </div>
        <a class="rm-navitem rm-navitem-danger" href="@Url.Action("Logout", "Home")">
            <i class="bi bi-power"></i><span>@(isRtl ? "تسجيل الخروج" : "Sign Out")</span>
        </a>
    </nav>
</aside>
