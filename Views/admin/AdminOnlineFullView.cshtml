@model MOHRecognition.Services.RecognitionRequestRecord
@using System
@using System.Text.Json
@using MOHRecognition.DTOs
@{
    Layout = null;
    ViewData["Title"] = "Online Recognition — Full View";

    var ol = Model.OnlineEducationData ?? new OnlineEducationDto();

    List<OnlineProgramDto> programs = new();
    if (!string.IsNullOrWhiteSpace(ol.ProgramsJson) && ol.ProgramsJson != "[]")
    {
        try { programs = JsonSerializer.Deserialize<List<OnlineProgramDto>>(ol.ProgramsJson) ?? new(); }
        catch { }
    }

    string YN(bool v)      => v ? "Yes" : "No";
    string YNClass(bool v) => v ? "yn-yes" : "yn-no";
    bool IsImage(string? fn) => fn != null && (fn.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fn.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || fn.EndsWith(".png", StringComparison.OrdinalIgnoreCase));
    string DocIcon(string? fn) => IsImage(fn) ? "bi-file-image-fill" : fn?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) == true ? "bi-file-earmark-pdf-fill" : "bi-file-earmark-word-fill";
    // Strip the 32-char GUID prefix added by SaveFile (e.g. "a1b2c3...d4_original.pdf" → "original.pdf")
    string DisplayName(string? fn)
    {
        if (string.IsNullOrEmpty(fn)) return "";
        var idx = fn.IndexOf('_');
        return idx == 32 ? fn[(idx + 1)..] : fn;
    }

    // ── Duration helpers (data resolved at save time into OnlineProgramDto) ────
    int? TraditionalDur(OnlineProgramDto p) =>
        p.Source == "Manual Entry" ? null : p.TraditionalDurationYears;

    string DurStatusClass(int? trad, int? online)
    {
        if (!trad.HasValue || !online.HasValue) return "dur-missing";
        return online.Value >= trad.Value ? "dur-valid" : "dur-invalid";
    }
    string DurStatusText(int? trad, int? online)
    {
        if (!trad.HasValue || !online.HasValue) return "Missing duration data";
        return online.Value >= trad.Value ? "Valid" : "Invalid — online duration is shorter than traditional";
    }

    int backId    = ViewBag.BackId ?? 0;
    int meetingId = ViewBag.MeetingId ?? 0;
    bool hideDoctorRecommendation = (ViewBag.HideDoctorRecommendation as bool?) == true;
    bool isRequestsSource = hideDoctorRecommendation && meetingId <= 0 && backId <= 0;
    string backUrl = backId > 0 ? $"/Home/SessionDashboard?id={backId}" : isRequestsSource ? "/Home/Requests" : "/Home/SubmittedUniversities";
    var existingDecision = ViewBag.ExistingDecision as MOHRecognition.DTOs.MeetingDecisionDto;
    string fdViewOnly = !string.IsNullOrWhiteSpace(Model?.CommitteeFinalRecommendation) ? "true" : "false";

    var savedDecisionOL      = Model.BasicInfoAssessmentDecision ?? "";
    var savedJustificationOL = Model.BasicInfoAssessmentReason   ?? "";
    bool hasRecommendationOL = !string.IsNullOrWhiteSpace(savedDecisionOL);
    string decCssOL  = savedDecisionOL switch { "Approve" => "approve", "Conditional Approval" => "conditional", _ => hasRecommendationOL ? "reject" : "conditional" };
    string decIconOL = savedDecisionOL switch { "Approve" => "bi-check2-circle", "Conditional Approval" => "bi-arrow-repeat", _ => hasRecommendationOL ? "bi-x-octagon-fill" : "bi-hourglass-split" };
    string displayDecisionOL = hasRecommendationOL ? savedDecisionOL : "Not Yet Submitted";
    string reviewerNameOL = ViewBag.ReviewerDisplayName as string ?? "Recognition Member";
}
<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — #@Model.Id</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --brand: #7f1627; --brand-dark: #5a0e1b; --brand-light: #faf4f5;
            --border: #ede4da; --text: #1a1a1a; --muted: #6b7280;
            --bg: #f3f0eb; --white: #fff; --header-h: 62px;
        }
        body { font-family: 'Segoe UI', Arial, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
        .pg-header { position: fixed; top: 0; left: 0; right: 0; z-index: 200; background: var(--brand); color: #fff; height: var(--header-h); display: flex; align-items: center; justify-content: space-between; padding: 0 24px 0 16px; box-shadow: 0 2px 18px rgba(0,0,0,.25); }
        .hd-left { display: flex; align-items: center; gap: 14px; }
        .pg-header img { height: 38px; }
        .hd-sep { width: 1px; height: 32px; background: rgba(255,255,255,.25); margin: 0 4px; }
        .hd-text h1 { font-size: 16px; font-weight: 700; }
        .hd-text p { font-size: 11px; opacity: .7; margin-top: 2px; }
        .hd-right { display: flex; align-items: center; gap: 8px; }
        .badge-view-only { background: rgba(255,255,255,.18); border: 1.5px solid rgba(255,255,255,.35); border-radius: 999px; padding: 4px 12px; font-size: 11px; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 5px; }
        .badge-online-type { background: rgba(16,185,129,.25); border: 1.5px solid rgba(110,231,183,.5); border-radius: 999px; padding: 4px 12px; font-size: 11px; font-weight: 800; color: #fff; display: flex; align-items: center; gap: 5px; }
        .btn-hd { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.12); color: #fff; border: 1.5px solid rgba(255,255,255,.3); border-radius: 8px; padding: 7px 14px; font-size: 12.5px; font-weight: 600; text-decoration: none; transition: background .15s; white-space: nowrap; }
        .btn-hd:hover { background: rgba(255,255,255,.22); }
        .btn-hd-gold { background: #d97706; color: #fff; border-color: #b45309; font-weight: 700; }
        .btn-hd-gold:hover { background: #b45309; }
        .rm-navitem-final-dec { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%) !important; border: 3px solid #d97706 !important; border-radius: 999px !important; color: #92400e !important; font-weight: 800 !important; margin: 4px 10px !important; }
        .rm-navitem-final-dec:hover { background: linear-gradient(135deg, #fde68a 0%, #fbbf24 100%) !important; color: #78350f !important; border-color: #b45309 !important; }
        .rm-navitem-final-dec i { color: #d97706 !important; }
        .layout { display: flex; gap: 18px; padding-top: var(--header-h); min-height: 100vh; }
        /* ── rm-sidebar base ── */
        .rm-sidebar { background: #f9fafb; border: 1px solid #cbd5e1; border-radius: 28px; box-shadow: 0 6px 24px rgba(15,23,42,.07); padding: 16px 12px 14px; min-height: 100%; overflow: visible; }
        .rm-side-label { font-size: 11px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; padding: 0 16px 12px; white-space: nowrap; }
        .rm-side-label:not(:first-child) { margin-top: 10px; }
        .rm-nav { display: flex; flex-direction: column; gap: 10px; }
        .rm-navitem { display: flex; align-items: center; gap: 12px; margin: 0 8px; border-radius: 999px; border: 3px solid #232833; background: #f8fafc; color: #475569; font-size: 13px; font-weight: 700; text-decoration: none; padding: 11px 14px; min-height: 54px; box-shadow: none; transition: background .12s, color .12s, box-shadow .12s; }
        .rm-navitem:hover { background: #f3f4f6; color: #334155; }
        .rm-navitem.active { background: linear-gradient(90deg, #9a1f33 0 8px, #f9f2f2 8px); color: #8a2f28; font-weight: 700; box-shadow: none; }
        .rm-navitem i { width: 16px; font-size: 15px; color: #94a3b8; text-align: center; line-height: 1; flex-shrink: 0; }
        .rm-navitem.active i { color: #8a2f28; }
        .rm-navitem .rm-step { width: 22px; height: 22px; border-radius: 50%; background: #e7e2db; color: #7f1627; font-size: 10.5px; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .rm-navitem.active .rm-step { color: #8a2f28; }
        .rm-navitem .rm-step i { font-size: 12px; color: inherit; width: auto; }
        .rm-navitem.rm-navitem-rec { background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%) !important; border: 3px solid #4f46e5 !important; border-radius: 999px !important; color: #312e81 !important; box-shadow: 0 2px 8px rgba(79,70,229,.18); margin: 4px 10px !important; }
        .rm-navitem.rm-navitem-rec:hover, .rm-navitem.rm-navitem-rec.active { background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%) !important; color: #1e1b4b !important; border-color: #3730a3 !important; box-shadow: 0 4px 12px rgba(55,48,163,.24) !important; }
        .rm-navitem.rm-navitem-rec i { color: #4f46e5 !important; }
        .rm-navitem.rm-navitem-rec .rm-step { background: #e0e7ff; color: #312e81; }
        .rm-review-divider { display: flex; align-items: center; gap: 8px; padding: 10px 16px 4px; }
        .rm-review-divider-line { flex: 1; height: 1px; background: #e5e7eb; }
        .rm-review-divider-label { font-size: 10px; font-weight: 800; color: #3730a3; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
        .fd-divider { display: flex; align-items: center; gap: 8px; padding: 10px 16px 4px; }
        .fd-divider-line { flex: 1; height: 1px; background: #e5e7eb; }
        .fd-divider-label { font-size: 10px; font-weight: 800; color: #d97706; text-transform: uppercase; letter-spacing: .06em; white-space: nowrap; }
        .final-decision-nav { margin: 0 8px !important; background: #f8fafc !important; border: 3px solid #232833 !important; color: #475569 !important; border-radius: 24px !important; box-shadow: none !important; font-weight: 700 !important; }
        .final-decision-nav i { color: #94a3b8 !important; }
        .final-decision-nav:hover, .final-decision-nav.active { background: linear-gradient(90deg, #9a1f33 0 8px, #f9f2f2 8px) !important; color: #8a2f28 !important; box-shadow: none !important; }
        /* ── pg-legacy-sidebar layout ── */
        .pg-legacy-sidebar .sidebar { position: fixed; top: var(--header-h); left: 0; bottom: 0; width: 312px; min-width: 312px; padding: 20px 0 96px 20px; background: transparent; overflow-y: auto; z-index: 100; }
        .pg-legacy-sidebar .rm-sidebar { background: #f9fafb; border: 1px solid #cbd5e1; border-radius: 30px; box-shadow: 0 6px 24px rgba(15,23,42,.06); padding: 16px 10px 14px; min-height: calc(100vh - var(--header-h) - 20px); }
        .pg-legacy-sidebar .layout { display: block; gap: 0; }
        .pg-legacy-sidebar .main { margin-left: 312px; padding: 28px 28px 60px; width: auto; flex: none; box-sizing: border-box; }
        /* ── Recommendation section ── */
        .sec-hd.sec-hd-rec { background: #dbeafe !important; color: #1e3a8a !important; border-bottom: 1.5px solid #bfdbfe !important; }
        .sec-hd.sec-hd-rec .sec-num { background: rgba(30,58,138,.08) !important; border: 2px solid rgba(30,58,138,.18); color: #1e3a8a; }
        #sec-recommendation.section-card { border: 1.5px solid #bfdbfe; box-shadow: 0 2px 16px rgba(30,58,138,.08); }
        .rec-reviewer { display: flex; align-items: center; gap: 14px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 14px 20px; margin-bottom: 22px; }
        .rec-reviewer-avatar { width: 46px; height: 46px; border-radius: 50%; background: #1e40af; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
        .rec-reviewer-info { flex: 1; min-width: 0; }
        .rec-reviewer-name { font-size: 14.5px; font-weight: 800; color: #1e3a8a; }
        .rec-reviewer-role { font-size: 11.5px; color: #3b82f6; font-weight: 600; margin-top: 2px; }
        .rec-reviewer-date { display: flex; align-items: center; gap: 6px; font-size: 12px; color: #1e40af; font-weight: 700; background: #dbeafe; border-radius: 999px; padding: 5px 12px; white-space: nowrap; }
        .final-rec-decision-label { font-size: 10.5px; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
        .final-rec-decision-value { display: inline-flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 800; border-radius: 10px; padding: 10px 20px; }
        .final-rec-val-approve,
        .final-rec-val-conditional,
        .final-rec-val-reject,
        .final-rec-val-na          { background: #dbeafe; color: #1e3a8a; border: 1.5px solid #bfdbfe; }
        .final-rec-just-label { font-size: 10.5px; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
