        .badge-bach    { background: #eff6ff; color: #2563eb; }
        .badge-pg      { background: #fdf4ff; color: #9333ea; }
        .badge-online  { background: #f0fdf4; color: #15803d; }
        .badge-blended { background: #fff7ed; color: #c2410c; }
        .dur-valid   { display:inline-flex;align-items:center;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#f0fdf4;color:#166534;border:1px solid #bbf7d0; }
        .dur-invalid { display:inline-flex;align-items:center;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#fff1f2;color:#9f1239;border:1px solid #fecdd3; }
        .dur-missing { display:inline-flex;align-items:center;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0; }
        .lms-access-box { border-top: 1px solid var(--border); margin-top: 18px; padding-top: 16px; }
        .lms-access-title { font-size: 11px; font-weight: 800; color: var(--brand); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 12px; }
        .file-grid { display: grid; gap: 8px; }
        .file-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; border: 1px solid #ede4da; border-radius: 8px; padding: 10px 14px; background: #fdfbf8; }
        .file-info .fn { font-size: 13px; font-weight: 700; color: #1f2937; }
        .file-info .fs { font-size: 11.5px; color: var(--muted); margin-top: 2px; }
        .btn-view-file { text-decoration: none; border-radius: 7px; padding: 5px 12px; font-size: 11.5px; font-weight: 700; border: 1.5px solid #d5c9bb; color: #5b4636; background: #fff; white-space: nowrap; }
        .btn-view-file:hover { background: #f9f4ee; }
        .empty-state { text-align: center; padding: 28px; color: var(--muted); font-size: 13px; }
        .empty-state i { font-size: 28px; display: block; margin-bottom: 8px; opacity: .4; }
        .empty-note { color: var(--muted); font-size: 13px; font-style: italic; padding: 20px 0; text-align: center; }
        /* Final Decision */
        .decision-section { background: var(--white); border: 2px solid var(--brand); border-radius: 12px; margin-bottom: 20px; overflow: hidden; scroll-margin-top: calc(var(--header-h) + 16px); }
        .decision-hd { background: var(--brand); color: #fff; padding: 14px 20px; display: flex; align-items: center; gap: 12px; }
        .decision-hd h2 { font-size: 15px; font-weight: 700; }
        .decision-hd p  { font-size: 11px; opacity: .75; margin-top: 2px; }
        .decision-form { padding: 20px; }
        .dec-label { font-size: 11px; font-weight: 800; color: #999; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 6px; display: block; }
        .dec-select { width: 100%; padding: 10px 14px; font-size: 14px; font-weight: 600; border: 1.5px solid #d1d5db; border-radius: 8px; background: #fff; color: #111; outline: none; cursor: pointer; }
        .dec-select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(127,22,39,.12); }
        .dec-textarea { width: 100%; margin-top: 14px; padding: 10px 14px; font-size: 13.5px; border: 1.5px solid #d1d5db; border-radius: 8px; resize: vertical; min-height: 100px; font-family: inherit; color: #111; outline: none; }
        .dec-textarea:focus { border-color: var(--brand); box-shadow: 0 0 0 3px rgba(127,22,39,.12); }
        .dec-save-btn { margin-top: 16px; display: inline-flex; align-items: center; gap: 8px; background: var(--brand); color: #fff; border: none; border-radius: 8px; padding: 10px 24px; font-size: 14px; font-weight: 700; cursor: pointer; transition: background .15s; }
        .dec-save-btn:hover { background: var(--brand-dark); }
        .dec-existing { margin-bottom: 16px; padding: 12px 14px; background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 8px; font-size: 12.5px; color: #166534; }
        .bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 150; background: #fff; border-top: 2px solid var(--border); display: flex; align-items: center; justify-content: flex-end; gap: 10px; padding: 12px 28px; box-shadow: 0 -2px 16px rgba(0,0,0,.08); }
        .btn-bar { display: inline-flex; align-items: center; gap: 6px; border-radius: 8px; padding: 9px 18px; font-size: 13px; font-weight: 600; text-decoration: none; border: 1.5px solid var(--border); background: #fff; color: #374151; transition: background .15s; white-space: nowrap; cursor: pointer; }
        .btn-bar:hover { background: #f5f0ea; }
        /* ── Sidebar collapse ── */
        .layout.sidebar-collapsed .sidebar { width: 108px; min-width: 108px; padding-left: 16px; }
        .layout.sidebar-collapsed .main { margin-left: 108px; }
        .rm-sidebar.collapsed .rm-side-label,
        .rm-sidebar.collapsed .rm-review-divider { display: none; }
        .rm-sidebar.collapsed .rm-navitem span:last-child { display: none; }
        .rm-sidebar.collapsed .rm-navitem { justify-content: center; padding: 10px; min-height: 54px; }
        .rm-sidebar.collapsed .rm-navitem i { width: auto; margin: 0; font-size: 20px; }
        .rm-sidebar.collapsed .rm-step { width: 30px; height: 30px; font-size: 12px; }
        .rm-sidebar.collapsed .rm-navitem .rm-step i { font-size: 15px; }
        /* Match icon sizing from other admin pages exactly */
        .pg-legacy-sidebar .rm-navitem i { width: 16px; font-size: 15px; }
        .pg-legacy-sidebar .rm-sidebar.collapsed .rm-navitem i { width: auto; font-size: 20px; }
        .sidebar-toggle {
            position: fixed;
            left: 322px;
            top: 50%;
            transform: translateY(-50%);
            width: 52px; height: 52px;
            border: none;
            border-radius: 50%;
            background: #981b31;
            color: #fff;
            z-index: 999;
            cursor: pointer;
            font-size: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 20px rgba(0,0,0,.18);
            transition: left .3s ease;
        }
        .layout.sidebar-collapsed .sidebar-toggle { left: 118px; }
        @@media (max-width: 900px) {
            .layout { display: block; }
            .sidebar, .sidebar-toggle { display: none; }
            .main { margin-left: 0; padding: 20px 14px 100px; }
            .fg { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
<body class="pg-legacy-sidebar">

<div class="pg-header">
    <div class="hd-left">
        <img src="/images/mohelogo.png" alt="Ministry Logo" />
        <div class="hd-sep"></div>
        <div class="hd-text">
            <h1>Online Recognition — Full View</h1>
            <p>Read-only · All sections · Request #@Model.Id</p>
        </div>
    </div>
    <div class="hd-right">
        <span class="badge-online-type"><i class="bi bi-laptop"></i> Online Recognition</span>
        <span class="badge-view-only"><i class="bi bi-eye"></i> View Only</span>
        <a class="btn-hd" href="@backUrl">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="layout">

    <nav class="sidebar">
        <aside class="rm-sidebar" id="rmSidebar">

            <div class="rm-side-label">Application</div>
            <div class="rm-nav">
                <a class="rm-navitem" href="#sec-overview">
                    <span class="rm-step"><i class="bi bi-info-circle"></i></span><span>Overview</span>
                </a>
            </div>

            <div class="rm-side-label">Sections</div>
            <div class="rm-nav">
                <a class="rm-navitem active" href="#sec-institution">
                    <span class="rm-step"><i class="bi bi-building"></i></span><span>Institution Information</span>
                </a>
                <a class="rm-navitem" href="#sec-programs">
                    <span class="rm-step"><i class="bi bi-journal-bookmark"></i></span><span>Online Programs</span>
                </a>
                <a class="rm-navitem" href="#sec-numbers">
                    <span class="rm-step"><i class="bi bi-bar-chart"></i></span><span>Recognition Numbers</span>
                </a>
                <a class="rm-navitem" href="#sec-communication">
                    <span class="rm-step"><i class="bi bi-chat-left-text"></i></span><span>Communication</span>
                </a>
                <a class="rm-navitem" href="#sec-exam">
                    <span class="rm-step"><i class="bi bi-file-earmark-check"></i></span><span>Examination System</span>
                </a>
                <a class="rm-navitem" href="#sec-platform">
                    <span class="rm-step"><i class="bi bi-display"></i></span><span>Learning Platform</span>
                </a>
                <a class="rm-navitem" href="#sec-applicant">
                    <span class="rm-step"><i class="bi bi-person-badge"></i></span><span>Applicant Info</span>
                </a>
                @if (!hideDoctorRecommendation)
                {
                    <div class="rm-review-divider">
                        <div class="rm-review-divider-line"></div>
                        <span class="rm-review-divider-label">Reviewer</span>
                        <div class="rm-review-divider-line"></div>
                    </div>
                    <a class="rm-navitem rm-navitem-rec" href="#sec-recommendation">
                        <span class="rm-step"><i class="bi bi-clipboard2-check"></i></span><span>Doctor's Recommendation</span>
                    </a>
                }
                @if (meetingId > 0)
                {
                    <a class="rm-navitem rm-navitem-final-dec" href="/Home/AdminFinalDecision?id=@Model.Id&meetingId=@meetingId&viewOnly=@fdViewOnly">
                        <i class="bi bi-shield-fill-check"></i><span>Final Decision</span>
                    </a>
                }
            </div>

        </aside>
    </nav>
    <button id="sidebarToggle" class="sidebar-toggle" type="button" aria-label="Toggle Sidebar">
        <i class="bi bi-chevron-left"></i>
    </button>

    <main class="main">

        <!-- Summary strip -->
        <div id="sec-overview" class="summary-strip section-card" style="border-radius:12px;">
            <div>
                <div class="uni-title">@(string.IsNullOrWhiteSpace(ol.InstitutionName) ? Model.UniversityName : ol.InstitutionName)</div>
                <div class="uni-sub">@Model.Country · Ref: @Model.ReferenceNumber</div>
                <div class="meta-chips">
                    <span class="chip"><i class="bi bi-laptop"></i> Online Recognition</span>
                    <span class="chip"><i class="bi bi-calendar3"></i> @Model.SubmittedAt.ToString("dd MMM yyyy")</span>
                    @if (!string.IsNullOrWhiteSpace(ol.LanguageOfInstruction)) { <span class="chip"><i class="bi bi-translate"></i> @ol.LanguageOfInstruction</span> }
                </div>
            </div>
            <div>
                @{
                    var sbClass = Model.Status switch { "Pending" => "sb-pending", "Requires Admin Review" => "sb-review", _ => "sb-done" };
                }
                <span class="status-badge @sbClass">@Model.Status</span>
            </div>
        </div>

        <!-- 1: Institution Info -->
        <div id="sec-institution" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">1</span>
                <div><h2>Institution Information</h2><p>Public Info submitted by the applicant</p></div>
            </div>
            <div class="sec-bd">
                <div class="fg">
                    @if (!string.IsNullOrWhiteSpace(ol.InstitutionName))
                    { <div class="field"><div class="lbl">Institution Name</div><div class="val">@ol.InstitutionName</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.OversightRightsEntity))
                    { <div class="field"><div class="lbl">Oversight Entity</div><div class="val">@ol.OversightRightsEntity</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.FoundationDate))
                    { <div class="field"><div class="lbl">Founding Date</div><div class="val">@ol.FoundationDate</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.DateOfEstablishment))
                    { <div class="field"><div class="lbl">Date of Establishment</div><div class="val">@ol.DateOfEstablishment</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.ModeOfStudy))
                    { <div class="field"><div class="lbl">Mode of Study</div><div class="val">@ol.ModeOfStudy</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.LanguageOfInstruction))
                    { <div class="field"><div class="lbl">Language of Instruction</div><div class="val">@ol.LanguageOfInstruction</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.StartOfTeaching))
                    { <div class="field"><div class="lbl">Start of Teaching</div><div class="val">@ol.StartOfTeaching</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.PresidentName))
                    { <div class="field"><div class="lbl">President / Rector</div><div class="val">@ol.PresidentName</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.MailingFullAddress))
                    { <div class="field"><div class="lbl">Mailing Address</div><div class="val">@ol.MailingFullAddress</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.DirectPhoneNumber))
                    { <div class="field"><div class="lbl">Phone</div><div class="val">@ol.DirectPhoneNumber</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.EmailAddress))
                    { <div class="field"><div class="lbl">Email</div><div class="val">@ol.EmailAddress</div></div> }
                    @if (!string.IsNullOrWhiteSpace(Model.Country))
                    { <div class="field"><div class="lbl">Country</div><div class="val">@Model.Country</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.Location))
                    { <div class="field"><div class="lbl">City</div><div class="val">@ol.Location</div></div> }
                </div>
                @if (!string.IsNullOrWhiteSpace(ol.InstitutionalWebAddress))
                {
                    <div class="sub-hd" style="margin-top:14px;">Website</div>
                    <div class="field" style="max-width:500px;">
                        <div class="lbl">Official Website</div>
                        <div class="val"><a href="@ol.InstitutionalWebAddress" target="_blank">@ol.InstitutionalWebAddress</a></div>
                    </div>
                }
            </div>
        </div>

        <!-- 2: Online Programs -->
        <div id="sec-programs" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">2</span>
                <div><h2>Online Programs</h2><p>Submitted program rows only</p></div>
            </div>
            <div class="sec-bd" style="padding:0;">
                @if (!programs.Any())
                {
                    <div class="empty-state"><i class="bi bi-laptop"></i>No online programs were listed.</div>
                }
                else
                {
                    <div class="tbl-wrap" style="overflow-x:auto;">
                        <table class="tbl" style="table-layout:auto;word-break:normal;overflow-wrap:normal;">
                            <thead>
                                <tr>
                                    <th style="white-space:nowrap;">#</th>
                                    <th style="white-space:nowrap;">Category</th>
                                    <th style="min-width:170px;">Program Name</th>
                                    <th style="white-space:nowrap;">Degree Level</th>
                                    <th style="min-width:160px;">College / Faculty</th>
                                    <th style="white-space:nowrap;">Delivery Mode</th>
                                    <th style="text-align:center;white-space:nowrap;">Online Students</th>
                                    <th style="text-align:center;white-space:nowrap;">Traditional Duration</th>
                                    <th style="text-align:center;white-space:nowrap;">Online Duration</th>
                                    <th style="white-space:nowrap;">Duration Status</th>
                                    <th style="white-space:nowrap;">Sync Ratio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (p, i) in programs.Select((p, i) => (p, i + 1)))
                                {
                                    bool isBach    = p.Source == "Bachelor";
                                    int? tradDur   = TraditionalDur(p);
                                    int? onlineDur = p.OnlineDurationYears;
                                    string durClass = DurStatusClass(tradDur, onlineDur);
                                    string durText  = DurStatusText(tradDur, onlineDur);
                                    string syncCls2, syncTxt2;
                                    if (!p.SynchronousRatioPercent.HasValue)
                                    { syncCls2 = "dur-missing"; syncTxt2 = "No data"; }
                                    else if (p.SynchronousRatioPercent.Value >= 33.33m)
                                    { syncCls2 = "dur-valid"; syncTxt2 = p.SynchronousRatioPercent.Value.ToString("0.##") + "%"; }
                                    else
                                    { syncCls2 = "dur-invalid"; syncTxt2 = p.SynchronousRatioPercent.Value.ToString("0.##") + "% — Below 33%"; }
                                    <tr>
                                        <td style="color:#999;white-space:nowrap;">@i</td>
                                        <td style="white-space:nowrap;">
                                            @if (isBach) { <span class="badge badge-bach">Bachelor</span> }
                                            else         { <span class="badge badge-pg">Postgraduate</span> }
                                        </td>
                                        <td style="font-weight:600;word-break:normal;overflow-wrap:anywhere;min-width:170px;">@p.ProgramName</td>
                                        <td style="white-space:nowrap;">@p.DegreeLevel</td>
                                        <td style="color:#6b7280;word-break:normal;overflow-wrap:anywhere;min-width:160px;">@(string.IsNullOrWhiteSpace(p.CollegeOrFaculty) ? "—" : p.CollegeOrFaculty)</td>
                                        <td style="white-space:nowrap;">
                                            <span class="badge @(p.DeliveryMode == "Fully Online" ? "badge-online" : "badge-blended")">@p.DeliveryMode</span>
                                        </td>
                                        <td style="text-align:center;font-weight:600;white-space:nowrap;">@(p.OnlineStudents.HasValue ? p.OnlineStudents.ToString() : "—")</td>
                                        <td style="text-align:center;color:#6b7280;white-space:nowrap;">@(tradDur.HasValue ? tradDur.Value + " yr" : "—")</td>
                                        <td style="text-align:center;font-weight:600;white-space:nowrap;">@(onlineDur.HasValue ? onlineDur.Value + " yr" : "—")</td>
                                        <td style="white-space:nowrap;"><span class="@durClass">@durText</span></td>
                                        <td style="white-space:nowrap;"><span class="@syncCls2">@syncTxt2</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div style="padding:12px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;">
                    <span style="font-size:12.5px;font-weight:700;color:var(--text);">Synchronous Ratio Evidence PDF:</span>
                    @if (!string.IsNullOrWhiteSpace(ol.SynchronousEvidenceFileName))
                    {
                        <a href="/uploads/online/@ol.SynchronousEvidenceFileName" target="_blank"
                           style="display:inline-flex;align-items:center;gap:5px;font-size:12.5px;color:var(--brand);text-decoration:underline;font-weight:700;">
                            <i class="bi bi-file-earmark-pdf-fill"></i> View PDF
                        </a>
                    }
                    else
                    {
                        <span style="font-size:12.5px;color:#9ca3af;font-style:italic;">Not uploaded</span>
                    }
                </div>
            </div>
        </div>

        <!-- 3: Online Recognition Numbers -->
        @{
            var bachProgs = programs.Where(p => string.Equals(p.DegreeLevel?.Trim(), "Bachelor", StringComparison.OrdinalIgnoreCase)).ToList();
            var pgProgs   = programs.Where(p => !string.Equals(p.DegreeLevel?.Trim(), "Bachelor", StringComparison.OrdinalIgnoreCase)).ToList();

            int bachStudents = bachProgs.Sum(p => p.OnlineStudents ?? 0);
            int pgStudents   = pgProgs.Sum(p   => p.OnlineStudents ?? 0);

            int bStaffTotal  = ol.BachelorOnlineStaffProf + ol.BachelorOnlineStaffAssoc + ol.BachelorOnlineStaffAsst;
            int pStaffTotal  = ol.PostgraduateOnlineStaffProf + ol.PostgraduateOnlineStaffAssoc + ol.PostgraduateOnlineStaffAsst;
            int totalStaff   = bStaffTotal + pStaffTotal;
        }
        <div id="sec-numbers" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">3</span>
                <div><h2>Online Recognition Numbers</h2><p>Submitted numbers and program-level totals</p></div>
            </div>
            <div class="sec-bd">
                @if (ol.TotalOnlineStudents.HasValue || ol.Professor.HasValue || ol.AssociateProfessor.HasValue || ol.AssistantProfessor.HasValue || ol.OnlineTrainedStaff.HasValue || programs.Count > 0)
                {
                    <div class="sub-hd">Overall Submitted Numbers</div>
                    <div class="fg">
                        @if (programs.Count > 0)              { <div class="field"><div class="lbl">Total Programs</div><div class="val">@programs.Count</div></div> }
                        @if (bachStudents + pgStudents > 0 || programs.Count > 0) { <div class="field"><div class="lbl">Total Online Students</div><div class="val">@(bachStudents + pgStudents)</div></div> }
                        @if (ol.Professor.HasValue)           { <div class="field"><div class="lbl">Professors</div><div class="val">@ol.Professor</div></div> }
                        @if (ol.AssociateProfessor.HasValue)  { <div class="field"><div class="lbl">Associate Professors</div><div class="val">@ol.AssociateProfessor</div></div> }
                        @if (ol.AssistantProfessor.HasValue)  { <div class="field"><div class="lbl">Assistant Professors</div><div class="val">@ol.AssistantProfessor</div></div> }
                        @if (totalStaff > 0)                  { <div class="field"><div class="lbl">Total Teaching Staff</div><div class="val">@totalStaff</div></div> }
                        @if (ol.OnlineTrainedStaff.HasValue)  { <div class="field"><div class="lbl">Online-Trained Staff</div><div class="val">@ol.OnlineTrainedStaff</div></div> }
                    </div>
                }

                <div class="sub-hd">Academic Level Breakdown</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div style="border:1px solid var(--border);border-radius:10px;padding:16px;">
                        <div style="font-size:12px;font-weight:800;color:var(--brand);margin-bottom:12px;"><i class="bi bi-mortarboard"></i> Bachelor</div>
                        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
                            <div class="field"><div class="lbl">Programs</div><div class="val">@bachProgs.Count</div></div>
                            <div class="field"><div class="lbl">Online Students</div><div class="val">@bachStudents</div></div>
                            <div class="field"><div class="lbl">Total Staff</div><div class="val">@bStaffTotal</div></div>
                            <div class="field"><div class="lbl">Professors</div><div class="val">@ol.BachelorOnlineStaffProf</div></div>
                            <div class="field"><div class="lbl">Assoc. Professors</div><div class="val">@ol.BachelorOnlineStaffAssoc</div></div>
                            <div class="field"><div class="lbl">Asst. Professors</div><div class="val">@ol.BachelorOnlineStaffAsst</div></div>
                        </div>
                    </div>

                    <div style="border:1px solid var(--border);border-radius:10px;padding:16px;">
                        <div style="font-size:12px;font-weight:800;color:var(--brand);margin-bottom:12px;"><i class="bi bi-award"></i> Postgraduate</div>
                        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
                            <div class="field"><div class="lbl">Programs</div><div class="val">@pgProgs.Count</div></div>
                            <div class="field"><div class="lbl">Online Students</div><div class="val">@pgStudents</div></div>
                            <div class="field"><div class="lbl">Total Staff</div><div class="val">@pStaffTotal</div></div>
                            <div class="field"><div class="lbl">Professors</div><div class="val">@ol.PostgraduateOnlineStaffProf</div></div>
                            <div class="field"><div class="lbl">Assoc. Professors</div><div class="val">@ol.PostgraduateOnlineStaffAssoc</div></div>
                            <div class="field"><div class="lbl">Asst. Professors</div><div class="val">@ol.PostgraduateOnlineStaffAsst</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4: Communication -->
        <div id="sec-communication" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">4</span>
                <div><h2>Communication</h2><p>Communication type and methods submitted by the applicant</p></div>
            </div>
            <div class="sec-bd">
                @if (!string.IsNullOrWhiteSpace(ol.CommunicationType))
                {
                    <div class="field" style="max-width:400px;">
                        <div class="lbl">Communication Type</div>
                        <div class="val">@(ol.CommunicationType == "Both" ? "Synchronous & Asynchronous" : ol.CommunicationType)</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(ol.CommunicationMethodsCsv))
                {
                    <div class="sub-hd">Communication Methods</div>
                    <div class="tag-row">
                        @foreach (var m in ol.CommunicationMethodsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        { <span class="tag active">@m.Trim()</span> }
                    </div>
                }
                @if (string.IsNullOrWhiteSpace(ol.CommunicationType) && string.IsNullOrWhiteSpace(ol.CommunicationMethodsCsv))
                {
                    <div class="empty-state" style="padding:16px 0;"><i class="bi bi-chat-dots"></i>No communication details were submitted.</div>
                }
            </div>
        </div>

        <!-- 5: Examination -->
        <div id="sec-exam" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">5</span>
                <div><h2>Examination System</h2><p>Exam type and monitoring methods submitted by the applicant</p></div>
            </div>
            <div class="sec-bd">
                <div class="fg">
                    @if (!string.IsNullOrWhiteSpace(ol.ExamType))
                    { <div class="field"><div class="lbl">Examination Type</div><div class="val" style="font-weight:800;">@ol.ExamType</div></div> }
                    @if (ol.ExamType == "Online Exams" || ol.ExamType == "Hybrid Exams")
                    {
                        <div class="field"><div class="lbl">Online Exams Officially Approved</div><div class="val"><span class="@YNClass(ol.OnlineExamsOfficiallyApproved)">@YN(ol.OnlineExamsOfficiallyApproved)</span></div></div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(ol.ExamLocations))
                {
                    <div class="sub-hd">Examination Locations / Centres</div>
                    <div class="field" style="max-width:600px;"><div class="val">@ol.ExamLocations</div></div>
                }
                @if (!string.IsNullOrWhiteSpace(ol.ProctoringMethodsCsv))
                {
                    <div class="sub-hd">Online Examination Monitoring Methods</div>
                    <div class="tag-row">
                        @foreach (var m in ol.ProctoringMethodsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries))
                        { <span class="tag active">@m.Trim()</span> }
                    </div>
                    @if (ol.ProctoringMethodsCsv.Split(',').Any(m => m.Trim() == "Other") && !string.IsNullOrWhiteSpace(ol.ProctoringOtherText))
                    {
                        <div class="field" style="margin-top:10px;max-width:600px;">
                            <div class="lbl">Other method specified</div>
                            <div class="val">@ol.ProctoringOtherText</div>
                        </div>
                    }
                }
                @if (!string.IsNullOrWhiteSpace(ol.ExamPolicyFileName))
                {
                    <div class="sub-hd" style="margin-top:20px;"><i class="bi bi-file-earmark-check" style="margin-right:5px;"></i>Examination Monitoring Evidence</div>
                    <div class="file-grid">
                        <div class="file-row">
                            <div class="file-info">
                                <div class="fn"><i class="bi @DocIcon(ol.ExamPolicyFileName)" style="color:#e02020;margin-right:6px;"></i>@DisplayName(ol.ExamPolicyFileName)</div>
                                <div class="fs">Exam Monitoring Evidence</div>
                            </div>
                            <a class="btn-view-file" href="/uploads/online/@ol.ExamPolicyFileName" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Open</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 6: Learning Platform -->
        <div id="sec-platform" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">6</span>
                <div><h2>Learning Platform</h2><p>LMS details submitted by the applicant</p></div>
            </div>
            <div class="sec-bd">
                <div class="fg">
                    @if (!string.IsNullOrWhiteSpace(ol.PlatformName))
                    { <div class="field"><div class="lbl">Platform Name</div><div class="val" style="font-weight:800;">@ol.PlatformName</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.PlatformUrl))
                    {
                        <div class="field">
                            <div class="lbl">Platform Website</div>
                            <div class="val"><a href="@ol.PlatformUrl" target="_blank">@ol.PlatformUrl</a></div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(ol.ResponsibleUnit))
                    { <div class="field"><div class="lbl">Responsible Unit / Department</div><div class="val">@ol.ResponsibleUnit</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.PlatformType))
                    { <div class="field"><div class="lbl">Technology Governance Level</div><div class="val">@ol.PlatformType</div></div> }
                    <div class="field"><div class="lbl">Officially Adopted by University</div><div class="val"><span class="@YNClass(ol.PlatformOfficiallyAdopted)">@YN(ol.PlatformOfficiallyAdopted)</span></div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(ol.PlatformAdoptionEvidenceFileName))
                {
                    <div class="sub-hd" style="margin-top:16px;"><i class="bi bi-file-earmark-check" style="margin-right:5px;"></i>LMS / Platform Evidence</div>
                    <div class="file-grid">
                        <div class="file-row">
                            <div class="file-info">
                                <div class="fn"><i class="bi @DocIcon(ol.PlatformAdoptionEvidenceFileName)" style="color:#e02020;margin-right:6px;"></i>@DisplayName(ol.PlatformAdoptionEvidenceFileName)</div>
                                <div class="fs">LMS / Platform Evidence — platform details, access page, ownership, certification, approval, or usage evidence</div>
                            </div>
                            <a class="btn-view-file" href="/uploads/online/@ol.PlatformAdoptionEvidenceFileName" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Open</a>
                        </div>
                    </div>
                }
                <div class="fg" style="margin-top:10px;">
                    <div class="field"><div class="lbl">Technical Support Available</div><div class="val"><span class="@YNClass(ol.TechnicalSupportAvailable)">@YN(ol.TechnicalSupportAvailable)</span></div></div>
                    <div class="field"><div class="lbl">Data Protection &amp; Privacy Policy</div><div class="val"><span class="@YNClass(ol.HasPrivacyPolicy)">@YN(ol.HasPrivacyPolicy)</span></div></div>
                    <div class="field"><div class="lbl">University-Owned / Self-Hosted</div><div class="val"><span class="@YNClass(ol.IsUniversityOwned)">@YN(ol.IsUniversityOwned)</span></div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(ol.PlatformUsername) || !string.IsNullOrWhiteSpace(ol.PlatformPassword))
                {
                    <div style="border-top:1px solid var(--border);margin-top:18px;padding-top:16px;">
                        <div style="font-size:12.5px;font-weight:800;color:var(--brand);margin-bottom:4px;"><i class="bi bi-key-fill"></i> LMS Review Access / Test Account</div>
                        <p style="font-size:11.5px;color:#6b7280;margin:0 0 12px;">For recognition review use only. Do not share externally.</p>
                        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
                            @if (!string.IsNullOrWhiteSpace(ol.PlatformUsername))
                            {
                                <div class="field">
                                    <div class="lbl">Username / Email</div>
                                    <div class="val" style="font-family:monospace;font-weight:700;">@ol.PlatformUsername</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(ol.PlatformPassword))
                            {
                                <div class="field">
                                    <div class="lbl">Password</div>
                                    <div class="val" style="display:flex;align-items:center;gap:8px;">
                                        <span id="lmsPassDisplay" style="letter-spacing:.12em;font-weight:700;flex:1;">••••••••</span>
                                        <button type="button" id="lmsRevealBtn"
                                            onclick="(function(){var d=document.getElementById('lmsPassDisplay'),b=document.getElementById('lmsRevealBtn');if(d.dataset.hidden==='false'){d.textContent='••••••••';d.dataset.hidden='true';b.textContent='Reveal';}else{d.textContent='@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ol.PlatformPassword))';d.dataset.hidden='false';b.textContent='Hide';}})()"
                                            data-pass=""
                                            style="font-size:11px;padding:4px 10px;border:1.5px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;color:#374151;font-weight:600;white-space:nowrap;">Reveal</button>
                                        <button type="button"
                                            onclick="navigator.clipboard.writeText('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(ol.PlatformPassword))').then(function(){var b=event.currentTarget;b.textContent='Copied!';setTimeout(function(){b.textContent='Copy';},1500);});"
                                            style="font-size:11px;padding:4px 10px;border:1.5px solid #d1d5db;border-radius:6px;background:#fff;cursor:pointer;color:#374151;font-weight:600;white-space:nowrap;">Copy</button>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(ol.LmsAccessNotes))
                            {
                                <div class="field" style="grid-column:1/-1;">
                                    <div class="lbl">Access Notes</div>
                                    <div class="val" style="font-weight:700;">@ol.LmsAccessNotes</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 7: Applicant Info -->
        <div id="sec-applicant" class="section-card">
            <div class="sec-hd">
                <span class="sec-num">7</span>
                <div><h2>Applicant Information</h2><p>Contact person details for this submission</p></div>
            </div>
            <div class="sec-bd">
                <div class="fg">
                    @if (!string.IsNullOrWhiteSpace(ol.Name))      { <div class="field"><div class="lbl">Full Name</div><div class="val">@ol.Name</div></div> }
                    @if (!string.IsNullOrWhiteSpace(ol.WorkPlace)) { <div class="field"><div class="lbl">Work Place</div><div class="val">@ol.WorkPlace</div></div> }
                    <div class="field"><div class="lbl">Reference Number</div><div class="val" style="font-family:monospace;">@Model.ReferenceNumber</div></div>
                    <div class="field"><div class="lbl">Submission Date</div><div class="val">@Model.SubmittedAt.ToString("dd MMM yyyy, HH:mm")</div></div>
                </div>
            </div>
        </div>


        @if (!hideDoctorRecommendation)
        {
            <!-- Doctor's Submitted Recommendation -->
            <div class="section-card" id="sec-recommendation">
                <div class="sec-hd sec-hd-rec">
                    <div class="sec-num" style="background:rgba(255,255,255,.2)">R</div>
                    <div>
                        <h2>Doctor's Final Recommendation</h2>
                        <p>Decision and written justification submitted by the reviewing recognition member</p>
                    </div>
                </div>
                <div class="sec-bd" style="display:grid;gap:20px;">

                    <!-- Final verdict -->
                    @{
                        string olValCls = savedDecisionOL switch {
                            "Approve"              => "final-rec-val-approve",
                            "Conditional Approval" => "final-rec-val-conditional",
                            var x when x.Contains("Reject", StringComparison.OrdinalIgnoreCase) => "final-rec-val-reject",
                            _                      => "final-rec-val-na"
                        };
                    }
                    <div>
                        <div class="final-rec-decision-label">Decision</div>
                        <div class="final-rec-decision-value @olValCls">
                            <i class="bi @decIconOL"></i> @displayDecisionOL
                        </div>
                    </div>

                    <!-- Justification -->
                    @if (!string.IsNullOrWhiteSpace(savedJustificationOL))
                    {
                        <div>
                            <div class="final-rec-just-label"><i class="bi bi-chat-quote-fill"></i> Justification / Notes</div>
                            <div class="final-rec-just-body">@savedJustificationOL</div>
                        </div>
                    }
                    else
                    {
                        <p style="color:#9ca3af;font-size:13px;font-style:italic;">No justification note provided.</p>
                    }

                </div>
            </div>
        }

        @if (meetingId > 0)
        {
            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px;padding:16px 0;">
                @if (!string.IsNullOrWhiteSpace(Model.CommitteeFinalRecommendation))
                {
                    <button type="button"
                            onclick="printFinalDecision('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CommitteeFinalRecommendation))')"
                            style="display:inline-flex;align-items:center;gap:8px;background:#f0fdf4;color:#166534;border:1.5px solid #bbf7d0;border-radius:9px;padding:11px 22px;font-size:14px;font-weight:700;cursor:pointer;transition:background .15s;"
                            onmouseover="this.style.background='#dcfce7'" onmouseout="this.style.background='#f0fdf4'">
                        <i class="bi bi-printer-fill"></i> Print Decision
                    </button>
                }
                <a href="/Home/AdminFinalDecision?id=@Model.Id&meetingId=@meetingId&viewOnly=@fdViewOnly"
                   style="display:inline-flex;align-items:center;gap:8px;background:#d97706;color:#fff;border:none;border-radius:9px;padding:11px 26px;font-size:14px;font-weight:700;text-decoration:none;transition:background .15s;"
                   onmouseover="this.style.background='#b45309'" onmouseout="this.style.background='#d97706'">
                    <i class="bi bi-shield-fill-check"></i> Final Decision
                </a>
            </div>
        }

    </main>
</div>


<script>
    function printFinalDecision(text) {
        const win = window.open('', '_blank');
        win.document.write(`<!doctype html><html dir="rtl" lang="ar"><head>
            <meta charset="utf-8"/>
            <title>قرار لجنة الاعتراف</title>
            <style>
                body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 15px; line-height: 2; direction: rtl; text-align: right; color: #000; padding: 60px 80px; margin: 0; }
                .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #7f1627; padding-bottom: 20px; }
                .header h1 { font-size: 18px; font-weight: 800; color: #7f1627; margin: 0 0 6px; }
                .header p  { font-size: 13px; color: #555; margin: 0; }
                .body { white-space: pre-wrap; word-break: break-word; font-size: 15px; }
            </style>
        </head><body>
            <div class="header">
                <h1>المملكة الأردنية الهاشمية — وزارة التعليم العالي والبحث العلمي</h1>
                <p>قرار لجنة الاعتراف بمؤسسات التعليم العالي غير الأردنية</p>
            </div>
            <div class="body">${text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
        </body></html>`);
        win.document.close();
        win.focus();
        win.print();
    }

    (function() {
        var sel = document.getElementById('decSelectOL');
        if (sel) sel.value = '@Html.Raw(((existingDecision?.Decision ?? "") switch { "Recognized" => "Approve", "Not Recognized" => "Reject", "Needs More Information" => "Pending", var x => x }).Replace("'", "\\'"))';
    })();
const links = document.querySelectorAll('.rm-navitem[href^="#"]');
    const sections = Array.from(links)
        .map(l => document.querySelector(l.getAttribute('href')))
        .filter(Boolean);

    function setActive(id) {
        links.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
    }

    let clickLock = null;
    links.forEach(link => {
        link.addEventListener('click', function () {
            const targetId = this.getAttribute('href').slice(1);
            setActive(targetId);
            clearTimeout(clickLock);
            clickLock = setTimeout(() => { clickLock = null; }, 900);
        });
    });

    function onScroll() {
        if (clickLock) return;
        if (!sections.length) return;
        const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 8;
        if (atBottom) { setActive(sections[sections.length - 1].id); return; }
        let current = sections[0];
        for (const section of sections) {
            if (section.getBoundingClientRect().top <= 90) current = section;
        }
        setActive(current.id);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const sidebar = document.getElementById('rmSidebar');
    const toggleBtn = document.getElementById('sidebarToggle');
    const layout = document.querySelector('.layout');
    if (sidebar && toggleBtn && layout) {
        toggleBtn.addEventListener('click', function () {
            sidebar.classList.toggle('collapsed');
            layout.classList.toggle('sidebar-collapsed');
            const icon = toggleBtn.querySelector('i');
            if (!icon) return;
            if (sidebar.classList.contains('collapsed')) {
                icon.classList.remove('bi-chevron-left');
                icon.classList.add('bi-chevron-right');
            } else {
                icon.classList.remove('bi-chevron-right');
                icon.classList.add('bi-chevron-left');
            }
        });
    }
</script>
</body>
</html>
