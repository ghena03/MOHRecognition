@using MOHRecognition.DTOs
@using MOHRecognition.Services

@{
    ViewData["Title"] = "Final Committee Decision";
    Layout = null;

    var meeting          = (MeetingDto)ViewBag.Meeting;
    var request          = (RecognitionRequestRecord)ViewBag.Request;
    var existing         = ViewBag.ExistingDecision as MeetingDecisionDto;
    bool viewOnly        = ViewBag.ViewOnly ?? false;
    int meetingId        = meeting.Id;
    int requestId        = request.Id;

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl   = culture == "ar";
    var dir     = isRtl ? "rtl" : "ltr";

    string selectedDecision = (existing?.Decision ?? "Needs More Information") switch
    {
        "Recognized"             => "Approve",
        "Not Recognized"         => "Reject",
        "Needs More Information" => "Pending",
        var x                    => x
    };
    string existingNotes = existing?.Notes ?? "";
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "قرار اللجنة النهائي" : "Final Committee Decision")</title>
    <link rel="stylesheet" href="~/css/admin/AdminDashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
    <style>
        body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; background: #f8f5f0; }

        .md-header {
            background: #7f1627;
            color: #fff;
            padding: 22px 32px 16px;
            display: flex;
            align-items: center;
            gap: 18px;
        }
        .md-header img.logo  { height: 52px; }
        .md-header .divider  { width: 2px; height: 44px; background: rgba(255,255,255,0.4); margin: 0 10px; }
        .md-header .title-box h1 { margin: 0; font-size: 1.35em; font-weight: 700; }
        .md-header .title-box p  { margin: 2px 0 0; font-size: 0.88em; opacity: .85; }

        .md-container { max-width: 820px; margin: 36px auto; padding: 0 20px 40px; }

        .md-page-title { color: #7f1627; font-size: 1.4em; font-weight: 700; margin-bottom: 18px; }

        .md-pills { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
        .md-pill { background: #f5e8ea; color: #7f1627; border: 1px solid #e0b0bb; border-radius: 20px; padding: 5px 16px; font-size: 0.85em; font-weight: 600; }

        .md-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.07); padding: 22px 26px; margin-bottom: 22px; }
        .md-card-title { font-size: 1em; font-weight: 700; color: #7f1627; margin-bottom: 14px; border-bottom: 2px solid #f5e8ea; padding-bottom: 8px; }

        .rec-block { background: #f9f5f0; border-left: 4px solid #7f1627; padding: 12px 16px; border-radius: 6px; }
        .rec-label { font-size: 0.82em; color: #888; margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }
        .rec-value { font-size: 0.97em; color: #333; font-weight: 600; }
        .rec-reason { font-size: 0.87em; color: #555; margin-top: 6px; font-style: italic; }

        .md-form-group { margin-bottom: 20px; }
        .md-form-group label { display: block; font-weight: 700; color: #444; margin-bottom: 6px; font-size: 0.92em; }
        .md-form-group select,
        .md-form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid #d0b0bb;
            border-radius: 7px;
            font-size: 0.95em;
            color: #333;
            background: #fff;
            box-sizing: border-box;
            font-family: inherit;
        }
        .md-form-group select:focus,
        .md-form-group textarea:focus { outline: none; border-color: #7f1627; box-shadow: 0 0 0 2px rgba(127,22,39,.12); }

        .md-btn-row { display: flex; gap: 14px; margin-top: 10px; flex-wrap: wrap; }
        .md-btn-back { display: inline-block; padding: 10px 26px; border-radius: 7px; font-size: 0.95em; font-weight: 600; text-decoration: none; background: #f0f0f0; color: #333; border: 1.5px solid #ccc; }
        .md-btn-back:hover { background: #e0e0e0; }
        .md-btn-save { padding: 10px 32px; border-radius: 7px; font-size: 0.95em; font-weight: 700; border: none; cursor: pointer; background: #7f1627; color: #fff; }
        .md-btn-save:hover { background: #6a1020; }
        .md-btn-print { display: inline-flex; align-items: center; gap: 7px; padding: 10px 26px; border-radius: 7px; font-size: 0.95em; font-weight: 700; border: 1.5px solid #bbf7d0; cursor: pointer; background: #f0fdf4; color: #166534; font-family: inherit; }
        .md-btn-print:hover { background: #dcfce7; }

        html[dir="rtl"] .rec-block { border-left: none; border-right: 4px solid #7f1627; }
    </style>
</head>
<body class="@(isRtl ? "rtl-body" : "")">

<!-- HEADER -->
<div class="md-header">
    <img src="/images/mohelogo.png" class="logo" />
    <div class="divider">
        @await Html.PartialAsync("~/Views/Shared/_LanguageSwitcher.cshtml")
    </div>
    <div class="title-box">
        <h1>@(isRtl ? "قرار اللجنة النهائي" : "Final Committee Decision")</h1>
        <p>@(isRtl ? "تسجيل قرار اللجنة الرسمي لطلب الاعتراف هذا" : "Record the committee's official decision for this recognition request")</p>
    </div>
</div>

<div class="md-container">

    <div class="md-page-title">@(isRtl ? "قرار اللجنة النهائي" : "Final Committee Decision")</div>

    <!-- INFO PILLS -->
    <div class="md-pills">
        <span class="md-pill">@(isRtl ? "جلسة #" : "Session #")@meeting.SessionNumber</span>
        <span class="md-pill">@(isRtl ? "السنة: " : "Year: ")@meeting.MeetingDate.Year</span>
        <span class="md-pill">@(isRtl ? "الجامعة: " : "University: ")@(string.IsNullOrWhiteSpace(request.UniversityName) ? "—" : request.UniversityName)</span>
        <span class="md-pill">@(isRtl ? "رقم الطلب: " : "Request ID: ")@request.Id</span>
    </div>

    <!-- COMMITTEE DECISION -->
    <div class="md-card">
        <div class="md-card-title">@(isRtl ? "قرار اللجنة" : "Committee Decision")</div>

        @if (viewOnly)
        {
            <!-- View-only mode: no form, no save button -->
            <div class="md-form-group">
                <label>@(isRtl ? "القرار" : "Decision")</label>
                @{
                    string decLabel = selectedDecision switch {
                        "Approve" => isRtl ? "موافقة"       : "Approve",
                        "Reject"  => isRtl ? "رفض"          : "Reject",
                        _         => isRtl ? "قيد الانتظار" : "Pending"
                    };
                    string decColor = selectedDecision switch {
                        "Approve" => "#166534;background:#dcfce7;border:1px solid #86efac",
                        "Reject"  => "#991b1b;background:#fee2e2;border:1px solid #fca5a5",
                        _         => "#92400e;background:#fef3c7;border:1px solid #fcd34d"
                    };
                }
                <div style="display:inline-block;padding:6px 18px;border-radius:20px;font-weight:700;font-size:14px;color:@decColor">@decLabel</div>
            </div>
            <div class="md-form-group">
                <label>@(isRtl ? "ملاحظات اللجنة / التوصية المكتوبة" : "Committee Notes / Written Recommendation")</label>
                <div style="background:#faf7f3;border:1.5px solid #e8ddd4;border-radius:8px;padding:14px 16px;font-size:14px;color:#1f2937;line-height:1.8;white-space:pre-wrap;min-height:80px;direction:rtl;text-align:right;">@(string.IsNullOrWhiteSpace(existingNotes) ? (isRtl ? "لا توجد ملاحظات مسجّلة." : "No notes recorded.") : existingNotes)</div>
            </div>
            <div class="md-btn-row">
                <a href="/Home/AllUniversities" class="md-btn-back">@(isRtl ? "رجوع &#8594;" : "&#8592; Back")</a>
                <button type="button" class="md-btn-print" onclick="printDecision()">
                    <i class="bi bi-printer-fill"></i> @(isRtl ? "طباعة" : "Print")
                </button>
            </div>
        }
        else
        {
            <form method="post" action="/Home/SaveMeetingDecision">
                @Html.AntiForgeryToken()
                <input type="hidden" name="meetingId" value="@meetingId" />
                <input type="hidden" name="requestId" value="@requestId" />

                <div class="md-form-group">
                    <label for="decision">@(isRtl ? "القرار" : "Decision")</label>
                    @{
                        string selApprove = selectedDecision == "Approve" ? " selected" : "";
                        string selReject  = selectedDecision == "Reject"  ? " selected" : "";
                        string selPending = selectedDecision == "Pending" ? " selected" : "";
                        string selectHtml =
                            "<select id=\"decision\" name=\"decision\">" +
                            "<option value=\"Approve\"" + selApprove + ">" + (isRtl ? "موافقة"       : "Approve") + "</option>" +
                            "<option value=\"Reject\""  + selReject  + ">" + (isRtl ? "رفض"          : "Reject")  + "</option>" +
                            "<option value=\"Pending\"" + selPending + ">" + (isRtl ? "قيد الانتظار" : "Pending") + "</option>" +
                            "</select>";
                    }
                    @Html.Raw(selectHtml)
                </div>

                <div class="md-form-group">
                    <label for="notes">@(isRtl ? "ملاحظات اللجنة / التوصية المكتوبة" : "Committee Notes / Written Recommendation")</label>
                    <textarea id="notes" name="notes" rows="8"
                              placeholder="@(isRtl ? "أدخل قرار اللجنة المكتوب أو الملاحظات هنا..." : "Enter the committee's written decision or notes here...")">@existingNotes</textarea>
                </div>

                <div class="md-btn-row">
                    <a href="/Home/SessionDashboard?id=@meetingId" class="md-btn-back">@(isRtl ? "&#8594; العودة إلى الاجتماع" : "&#8592; Back to Meeting")</a>
                    <button type="submit" class="md-btn-save">@(isRtl ? "حفظ القرار" : "Save Decision")</button>
                </div>
            </form>
        }
    </div>

</div>

@if (viewOnly)
{
    <script>
    function printDecision() {
        const text = @Html.Raw($"'{existingNotes.Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "")}'");
        const uni  = '@Html.Raw((request.UniversityName ?? "—").Replace("'", "\\'"))';
        const win  = window.open('', '_blank');
        win.document.write(`<!doctype html><html dir="rtl" lang="ar"><head>
            <meta charset="utf-8"/>
            <title>قرار لجنة الاعتراف</title>
            <style>
                body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; font-size: 15px; line-height: 2; direction: rtl; text-align: right; color: #000; padding: 60px 80px; margin: 0; }
                .header { text-align: center; margin-bottom: 40px; border-bottom: 2px solid #7f1627; padding-bottom: 20px; }
                .header h1 { font-size: 18px; font-weight: 800; color: #7f1627; margin: 0 0 6px; }
                .header p  { font-size: 13px; color: #555; margin: 0; }
                .body { white-space: pre-wrap; word-break: break-word; font-size: 15px; }
            </style>
        </head><body>
            <div class="header">
                <h1>المملكة الأردنية الهاشمية — وزارة التعليم العالي والبحث العلمي</h1>
                <p>قرار لجنة الاعتراف بمؤسسات التعليم العالي غير الأردنية — ${uni}</p>
            </div>
            <div class="body">${text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>
        </body></html>`);
        win.document.close();
        win.focus();
        win.print();
    }
    </script>
}

</body>
</html>
