@using MOHRecognition.Services
@model List<RecognitionRequestRecord>

@{
    Layout = null;

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl   = culture == "ar";
    var dir     = isRtl ? "rtl" : "ltr";

    string AppTypeLabel(string? t) => isRtl
        ? (t ?? "Bachelor") switch { "Postgraduate" => "دراسات عليا", "Online" => "عبر الإنترنت", _ => "بكالوريوس" }
        : (t ?? "Bachelor");

    string DecisionLabel(string? d) => isRtl ? (d ?? "") switch {
        "Approve"                    => "موافقة",
        "Conditional Approval"       => "موافقة مشروطة",
        "Reject / Committee Review"  => "رفض / مراجعة اللجنة",
        _                            => d ?? ""
    } : (d ?? "");

    string AppTypeStyle(string? t) => (t ?? "Bachelor") switch
    {
        "Postgraduate" => "background:#ede9fe;color:#5b21b6;border:1px solid #c4b5fd",
        "Online"       => "background:#dcfce7;color:#166534;border:1px solid #86efac",
        _              => "background:#dbeafe;color:#1e40af;border:1px solid #93c5fd"
    };
    string RowClass(string? t) => (t ?? "Bachelor") switch
    {
        "Postgraduate" => "app-row-postgraduate",
        "Online"       => "app-row-online",
        _              => "app-row-bachelor"
    };
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "القرارات" : "Decisions")</title>
    <link rel="stylesheet" href="~/css/admin/AdminDashboard.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>
<body class="admin-page @(isRtl ? "rtl-body" : "")">

<div class="main-container decisions-page">

    <div class="header">
        <div class="header-left">
            <img src="~/images/mohelogo.png" class="logo" />
            <div class="title-box">
                <h1>@(isRtl ? "القرارات" : "Decisions")</h1>
                <p>@(isRtl ? "النتائج النهائية من أعضاء الاعتراف" : "Final results from recognition members")</p>
            </div>
        </div>
    </div>

    <div class="details-card">

        <h2 class="section-title">@(isRtl ? "نظرة عامة على القرارات" : "Decisions Overview")</h2>

        <table class="modern-table">
            <thead>
                <tr>
                    <th>@(isRtl ? "الجامعة" : "University")</th>
                    <th>@(isRtl ? "النوع" : "Type")</th>
                    <th>@(isRtl ? "القرار" : "Decision")</th>
                    <th>@(isRtl ? "ملاحظات" : "Notes")</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var r in Model)
                {
                    var decisionClass = "badge-default";

                    if (r.BasicInfoAssessmentDecision == "Approve")
                        decisionClass = "badge-approve";
                    else if (r.BasicInfoAssessmentDecision == "Conditional Approval")
                        decisionClass = "badge-conditional";
                    else if (r.BasicInfoAssessmentDecision == "Reject / Committee Review")
                        decisionClass = "badge-reject";

                    <tr class="@RowClass(r.ApplicationType)">
                        <td>@r.UniversityName</td>
                        <td><span style="display:inline-block;border-radius:20px;padding:3px 10px;font-size:11.5px;font-weight:700;@AppTypeStyle(r.ApplicationType)">@AppTypeLabel(r.ApplicationType)</span></td>
                        <td>
                            <span class="decision-badge @decisionClass">
                                @DecisionLabel(r.BasicInfoAssessmentDecision)
                            </span>
                        </td>
                        <td class="note-cell">
                            @r.BasicInfoAssessmentReason
                        </td>
                        <td>
                            <a href="/Home/DecisionDetails/@r.Id" class="view-btn">
                                @(isRtl ? "عرض" : "View")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>

</body>
</html>
