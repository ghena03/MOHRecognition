@using MOHRecognition.DTOs
@model MOHRecognition.DTOs.ManualInstitutionRequestDto

@{
    Layout = null;
    ViewData["Title"] = "Add Educational Institution";

    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl   = culture == "ar";
    var dir     = isRtl ? "rtl" : "ltr";
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isRtl ? "إضافة مؤسسة تعليمية" : "Add Educational Institution")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/admin/AdminDashboard.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>

<body class="admin-page @(isRtl ? "rtl-body" : "")">

    <div class="top-line"></div>
    <div class="top-bar"></div>

    <div class="header">
        <div class="header-left">
            <img src="/images/mohelogo.png" class="logo" />
            <div class="divider"></div>
            <div class="title-box">
                <h1>@(isRtl ? "إضافة مؤسسة تعليمية" : "Add Educational Institution")</h1>
                <p>@(isRtl ? "إنشاء طلب اعتراف يدوي وتعيينه إلى عضو لجنة الاعتراف." : "Create a manual recognition request and assign it to a recognition member.")</p>
            </div>
        </div>

        <div class="header-right">
            <a class="back-btn" href="@Url.Action("AdminDashboard", "Home")">@(isRtl ? "لوحة التحكم &#8594;" : "&#8592; Back to Dashboard")</a>
        </div>
    </div>

    <div class="page">

        <div class="card">

            <div class="card-title">
                @(isRtl ? "معلومات المؤسسة" : "Institution Information")
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-box">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form method="post" asp-controller="Home" asp-action="AddEducationalInstitution">

                <div class="form-grid">

                    <div class="field">
                        <label>@(isRtl ? "اسم المؤسسة" : "Institution Name")</label>
                        <input type="text" name="InstitutionName" required />
                    </div>

                    <div class="field">
                        <label>@(isRtl ? "الدولة" : "Country")</label>
                        <select name="Country" required>
                            <option value="">@(isRtl ? "اختر الدولة" : "Select Country")</option>
                            @if (ViewBag.Countries != null)
                            {
                                foreach (var c in (List<string>)ViewBag.Countries)
                                {
                                    <option value="@c">@c</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="field">
                        <label>@(isRtl ? "المدينة" : "City")</label>
                        <input type="text" name="City" required />
                    </div>

                    <div class="field">
                        <label>@(isRtl ? "نوع المؤسسة" : "Institution Type")</label>
                        <select name="InstitutionType" required>
                            <option value="">@(isRtl ? "اختر النوع" : "Select Type")</option>
                            <option value="Bachelor">@(isRtl ? "بكالوريوس" : "Bachelor")</option>
                            <option value="Postgraduate">@(isRtl ? "دراسات عليا" : "Postgraduate")</option>
                        </select>
                    </div>

                    <div class="field">
                        <label>@(isRtl ? "تعيين عضو الاعتراف" : "Assign Recognition Member")</label>
                        <select name="AssignedMember" required>
                            <option value="">@(isRtl ? "اختر العضو" : "Select Member")</option>
                            @if (ViewBag.RecognitionMembers != null)
                            {
                                foreach (var rm in (IReadOnlyList<AdvisorDto>)ViewBag.RecognitionMembers)
                                {
                                    <option value="@rm.Email">@rm.FullName</option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <div class="actions">
                    <button type="submit" class="submit-btn">
                        <i class="bi bi-building-add"></i>
                        @(isRtl ? "إنشاء الطلب" : "Create Request")
                    </button>
                </div>

            </form>

        </div>

    </div>

</body>
</html>
