@model DTOs.AdminProfileDto

@{
    ViewData["Title"] = "Admin Profile";
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@culture" dir="@dir">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@(isRtl ? "الملف الشخصي للمدير" : "Admin Profile")</title>

    <link rel="stylesheet"
          href="~/css/admin/AdminProfile.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/AdminDashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }

</head>

<body class="@(isRtl ? "rtl-body" : "")">

    <div class="top-bar"></div>

    <div class="header">

        <div class="header-left">

            <img src="/images/mohelogo.png"
                 class="logo" />

            <div class="divider"></div>

            <div class="title-box">
                <h1>@(isRtl ? "الملف الشخصي للمدير" : "Admin Profile")</h1>
            </div>

        </div>

        <div style="display:flex;align-items:center;gap:10px;">
            @await Html.PartialAsync("~/Views/Shared/_LanguageSwitcher.cshtml")
            <a class="back-btn"
           href="@Url.Action("AdminDashboard", "Home")">

            @(isRtl ? "→ العودة إلى لوحة التحكم" : "← Back to Dashboard")

        </a>
        </div>

    </div>


    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="success-alert">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["ProfileSuccess"]

        </div>
    }


    <div class="profile-container">

        <div class="profile-header">

            <div class="profile-avatar">

                @Model.Username.Substring(0, 1).ToUpper()

            </div>

            <div class="profile-name">
                <h1>@Model.Username</h1>
                <p>@(isRtl ? "مدير النظام" : "System Administrator")</p>
            </div>

        </div>

        <div class="profile-grid">

            <!-- ACCOUNT INFO -->
            <div class="profile-card">

                <div class="card-top">

                    <h3>@(isRtl ? "معلومات الحساب" : "Account Information")</h3>

                    <button type="button"
                            class="edit-btn"
                            onclick="toggleEditMode()">

                        <i class="bi bi-pencil-square"></i>
                        @(isRtl ? "تعديل" : "Edit")

                    </button>

                </div>

                <form method="post"
                      asp-action="SaveProfile">

                    <div class="info-row">

                        <div class="info-label">
                            @(isRtl ? "اسم المستخدم" : "Username")
                        </div>

                        <input type="text"
                               id="usernameInput"
                               asp-for="Username"
                               class="profile-input"
                               disabled />

                    </div>

                    <div class="info-row">

                        <div class="info-label">
                            @(isRtl ? "البريد الإلكتروني" : "Email")
                        </div>

                        <input type="email"
                               id="emailInput"
                               asp-for="Email"
                               class="profile-input"
                               disabled />

                    </div>

                    <div class="info-row">

                        <div class="info-label">
                            @(isRtl ? "رقم الهاتف" : "Phone Number")
                        </div>

                        <input type="text"
                               id="phoneInput"
                               asp-for="PhoneNumber"
                               class="profile-input"
                               disabled />

                    </div>

                    <button type="submit"
                            id="saveBtn"
                            class="save-btn"
                            style="display:none;">

                        <i class="bi bi-check-circle"></i>
                        @(isRtl ? "حفظ التغييرات" : "Save Changes")

                    </button>

                </form>

            </div>

            <!-- SYSTEM INFO -->
            <div class="profile-card">

                <h3>@(isRtl ? "معلومات النظام" : "System Information")</h3>

                <div class="info-row">

                    <div class="info-label">
                        @(isRtl ? "مستوى الوصول" : "Access Level")
                    </div>

                    <div class="info-value">
                        @(isRtl ? "وصول كامل" : "Full Access")
                    </div>

                </div>

                <div class="info-row">

                    <div class="info-label">
                        @(isRtl ? "القسم" : "Department")
                    </div>

                    <div class="info-value">
                        @(isRtl ? "لجنة الاعتراف" : "Recognition Committee")
                    </div>

                </div>

                <div class="info-row">

                    <div class="info-label">
                        @(isRtl ? "الحالة" : "Status")
                    </div>

                    <div class="info-value">
                        @(isRtl ? "نشط" : "Active")
                    </div>

                </div>

            </div>

            <!-- PASSWORD -->
            <div class="profile-card password-card">

                <button class="toggle-password-btn"
                        type="button"
                        onclick="togglePasswordSection()">

                    <i class="bi bi-shield-lock"></i>
                    @(isRtl ? "تغيير كلمة المرور" : "Change Password")

                </button>

                <form method="post"
                      asp-action="UpdatePassword">
                    <div id="passwordSection"
                         class="password-section"
                         style="display:@(TempData["Error"] != null || TempData["Success"] != null ? "block" : "none");">

                        @if (TempData["Error"] != null)
                        {
                            <div class="password-error">

                                <i class="bi bi-exclamation-triangle-fill"></i>

                                @TempData["Error"]

                            </div>
                        }

                        @if (TempData["Success"] != null)
                        {
                            <div class="password-success">

                                <i class="bi bi-check-circle-fill"></i>

                                @TempData["Success"]

                            </div>
                        }

                        <div class="info-row">

                            <div class="info-label">
                                @(isRtl ? "كلمة المرور الحالية" : "Current Password")
                            </div>

                            <input type="password"
                                   name="currentPassword"
                                   class="profile-input" />

                        </div>

                        <div class="info-row">

                            <div class="info-label">
                                @(isRtl ? "كلمة المرور الجديدة" : "New Password")
                            </div>

                            <input type="password"
                                   name="newPassword"
                                   class="profile-input" />

                        </div>

                        <div class="info-row">

                            <div class="info-label">
                                @(isRtl ? "تأكيد كلمة المرور" : "Confirm Password")
                            </div>

                            <input type="password"
                                   name="confirmPassword"
                                   class="profile-input" />

                        </div>

                        <button type="submit"
                                class="save-btn">

                            <i class="bi bi-check-circle"></i>
                            @(isRtl ? "تحديث كلمة المرور" : "Update Password")

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script>

        function togglePasswordSection() {

            const section =
                document.getElementById("passwordSection");

            if (section.style.display === "none" ||
                section.style.display === "") {

                section.style.display = "block";

            }
            else {

                section.style.display = "none";

            }
        }

        function toggleEditMode() {

            const username =
                document.getElementById("usernameInput");

            const email =
                document.getElementById("emailInput");

            const phone =
                document.getElementById("phoneInput");

            const saveBtn =
                document.getElementById("saveBtn");

            const isDisabled =
                username.disabled;

            username.disabled = !isDisabled;
            email.disabled = !isDisabled;
            phone.disabled = !isDisabled;

            if (isDisabled) {

                saveBtn.style.display = "block";

            }
            else {

                saveBtn.style.display = "none";

            }
        }
                window.onload = function () {

            const passwordSection =
                document.getElementById("passwordSection");

            const hasMessage =
                document.querySelector(".password-error") ||
                document.querySelector(".password-success");

            if (hasMessage && passwordSection) {

                passwordSection.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

            }
        };
    </script>

</body>
</html>
