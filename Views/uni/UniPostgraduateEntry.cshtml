    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/uni/PostgraduatePrograms.js" asp-append-version="true"></script>

    <script src="~/js/uni/demo-fill.js" asp-append-version="true"></script>

    <script>
        function scrollToNext(sectionId) {
            const el = document.getElementById(sectionId);
            if (el) el.scrollIntoView({ behavior: 'smooth' });
        }

        // ── Sidebar scroll-spy ────────────────────────────────────────────────
        (function () {
            var ids    = ['sec-intro','sec-general','sec-programs','sec-students','sec-faculty','sec-user'];
            var OFFSET = 150;
            var locked = false;

            function activate(id) {
                document.querySelectorAll('.side-item[data-section]').forEach(function (el) {
                    el.classList.toggle('active', el.dataset.section === id);
                });
            }

            function onScroll() {
                if (locked) return;
                var scrollY  = window.pageYOffset;
                var activeId = ids[0];
                ids.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el && el.offsetTop <= scrollY + OFFSET) activeId = id;
                });
                activate(activeId);
            }

            window.addEventListener('scroll', onScroll, { passive: true });

            document.querySelectorAll('.side-item[data-section]').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    e.preventDefault();
                    var target = document.getElementById(el.dataset.section);
                    if (!target) return;
                    locked = true;
                    activate(el.dataset.section);
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    setTimeout(function () { locked = false; }, 700);
                });
            });

            onScroll();
        })();

        // ── PG Programs CRUD (per-level) ──────────────────────────────────────
        var pgLevelData = {
            master:  { key: 'Master',         progs: [], editIdx: -1 },
            phd:     { key: 'PhD',            progs: [], editIdx: -1 },
            diploma: { key: 'Higher Diploma', progs: [], editIdx: -1 }
        };

        function showPgForm(lv) {
            var d = pgLevelData[lv];
            d.editIdx = -1;
            document.getElementById('pgAddPanel_' + lv).style.display = 'block';
            document.getElementById('pgAddBtn_'   + lv).style.display = 'none';
            document.getElementById('pgPanelTitle_' + lv).textContent  = 'Add ' + d.key + ' Program';
            document.getElementById('pgPName_'    + lv).value = '';
            document.getElementById('pgPCollege_' + lv).value = '';
            document.getElementById('pgPSpec_'    + lv).value = '';
            document.getElementById('pgPYears_'   + lv).value = '';
            document.getElementById('pgAddPanel_' + lv).scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showPgFormEdit(lv, idx) {
            var d = pgLevelData[lv];
            d.editIdx = idx;
            var p = d.progs[idx];
            document.getElementById('pgAddPanel_' + lv).style.display = 'block';
            document.getElementById('pgAddBtn_'   + lv).style.display = 'none';
            document.getElementById('pgPanelTitle_' + lv).textContent  = 'Edit ' + d.key + ' Program';
            document.getElementById('pgPName_'    + lv).value = p.name;
            document.getElementById('pgPCollege_' + lv).value = p.college;
            document.getElementById('pgPYears_'   + lv).value = p.years || '';
        }

        function hidePgForm(lv) {
            document.getElementById('pgAddPanel_' + lv).style.display = 'none';
            document.getElementById('pgAddBtn_'   + lv).style.display = 'inline-flex';
            pgLevelData[lv].editIdx = -1;
        }

        function confirmPgAdd(lv) {
            var d       = pgLevelData[lv];
            var name    = (document.getElementById('pgPName_'    + lv).value || '').trim();
            var college = (document.getElementById('pgPCollege_' + lv).value || '').trim();
            var yearsRaw = (document.getElementById('pgPYears_'  + lv).value || '').trim();
            var years   = parseInt(yearsRaw, 10);
            if (!name)              { alert('Program Name is required.');        return; }
            if (!college)           { alert('College / Faculty is required.');   return; }
            if (!yearsRaw || isNaN(years) || years < 1) { alert('Number of Years is required and must be at least 1.'); return; }
            if (d.editIdx >= 0) {
                d.progs[d.editIdx] = { name: name, college: college, years: years };
            } else {
                d.progs.push({ name: name, college: college, years: years });
            }
            hidePgForm(lv);
            renderPgTable(lv);
            serializePgProgs();
        }

        function deletePgProg(lv, idx) {
            if (!confirm('Delete this program?')) return;
            pgLevelData[lv].progs.splice(idx, 1);
            renderPgTable(lv);
            serializePgProgs();
        }

        function renderPgTable(lv) {
            var d     = pgLevelData[lv];
            var empty = document.getElementById('pgEmpty_'     + lv);
            var wrap  = document.getElementById('pgTableWrap_' + lv);
            var tbody = document.getElementById('pgTableBody_' + lv);
            if (!empty || !wrap || !tbody) return;
            if (d.progs.length === 0) {
                empty.style.display = 'block';
                wrap.style.display  = 'none';
                return;
            }
            empty.style.display = 'none';
            wrap.style.display  = 'block';
            tbody.innerHTML = d.progs.map(function(p, i) {
                return '<tr>' +
                    '<td style="padding:9px 11px;border-bottom:1px solid #f0ede8;font-weight:600;">'  + escPg(p.name)    + '</td>' +
                    '<td style="padding:9px 11px;border-bottom:1px solid #f0ede8;">'                  + escPg(p.college) + '</td>' +
                    '<td style="padding:9px 11px;border-bottom:1px solid #f0ede8;text-align:center;font-weight:600;">' + (p.years || '—') + '</td>' +
                    '<td style="padding:9px 11px;border-bottom:1px solid #f0ede8;white-space:nowrap;">' +
                        '<button type="button" onclick="showPgFormEdit(\'' + lv + '\',' + i + ')" style="background:none;border:1px solid #93c5fd;color:#2563eb;border-radius:6px;padding:3px 9px;font-size:11.5px;font-weight:600;cursor:pointer;margin-right:4px;">Edit</button>' +
                        '<button type="button" onclick="deletePgProg(\'' + lv + '\',' + i + ')" style="background:none;border:1px solid #fca5a5;color:#dc2626;border-radius:6px;padding:3px 9px;font-size:11.5px;font-weight:600;cursor:pointer;">Delete</button>' +
                    '</td>' +
                    '</tr>';
            }).join('');
        }

        function serializePgProgs() {
            var all = [];
            ['master', 'phd', 'diploma'].forEach(function(lv) {
                var d = pgLevelData[lv];
                d.progs.forEach(function(p) {
                    all.push({ ProgramName: p.name, DegreeLevel: d.key, CollegeOrFaculty: p.college, Specialization: p.spec || '', NumberOfYears: p.years || null });
                });
            });
            document.getElementById('pgProgramsJson').value = JSON.stringify(all);
        }

        function escPg(s) { return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }

        document.querySelector('form')?.addEventListener('submit', function() { serializePgProgs(); });
    </script>

</body>
</html>
