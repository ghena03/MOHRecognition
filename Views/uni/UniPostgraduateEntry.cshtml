@{
    Layout = null;
}
@model MOHRecognition.DTOs.PostgraduateApplicationDto

<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Postgraduate Instructions</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/uni/UniDashboard.css" asp-append-version="true" />
    <style>
        .field-required-error { color:#dc2626; font-size:12px; font-weight:700; margin:6px 8px 0; }
        .group-required-error { color:#dc2626; font-size:12px; font-weight:700; margin-top:8px; }
        .section-readonly input[readonly],
        .section-readonly select[disabled] {
            background: #f9fafb !important;
            color: #6b7280 !important;
            cursor: default !important;
            border-color: #e5e7eb !important;
        }
        .section-readonly .req { display: none; }
    </style>
</head>

<body class="submitapp-page ltr">

    <!-- HEADER -->
    <header class="top-header en">
        <div class="hdr-grid">
            <div></div>
            <nav class="hdr-nav">
                <a class="hdr-link" href="@Url.Action("UniDashboard", "Home")">← Back</a>
                <a class="hdr-link" href="https://www.mohe.gov.jo/" target="_blank">Ministry Website</a>
            </nav>
            <div class="hdr-logo">
                <img class="rm-logo" src="~/images/mohelogo.png" />
            </div>
        </div>
        <div class="brand-bar"></div>
    </header>

    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <a href="@Url.Action("UniStatus", "Home")" class="side-user">
                <div class="user-avatar">UN</div>
                <div class="user-info">
                    <span class="user-name">University Account</span>
                    <span class="user-link">Show account</span>
                </div>
            </a>
            <a class="side-item" href="#sec-intro"    data-section="sec-intro">Introduction</a>
            <a class="side-item" href="#sec-general"  data-section="sec-general">Public Info</a>
            <a class="side-item" href="#sec-programs" data-section="sec-programs">Postgraduate Programs</a>
            <a class="side-item" href="#sec-students" data-section="sec-students">Number of students</a>
            <a class="side-item" href="#sec-faculty"  data-section="sec-faculty">Academic Staff</a>
            <a class="side-item" href="#sec-user"     data-section="sec-user">Applicant Info</a>
            <div class="side-footer">
                <a class="logout" href="@Url.Action("Logout", "Home")">Logout</a>
            </div>
        </aside>

        <!-- MAIN -->
        <main class="content">

            <!-- WELCOME -->
            <section class="welcome" id="sec-intro">
                <div class="welcome-card">
                    <div class="welcome-icon">📘</div>
                    <h1 class="welcome-title">Postgraduate Recognition Instructions</h1>
                    <p class="welcome-text">
                        To apply for postgraduate recognition (Master / PhD), the institution must meet all the following requirements.
                    </p>
                </div>
            </section>

            @{
                var P = ViewBag.Public as DTOs.PublicInfoDto ?? new DTOs.PublicInfoDto();
                var languageOfInstruction = (P.LanguageOfInstruction ?? "").Trim();
                var languageInstructionOptions = new[]
                {
                        "English only", "Arabic only", "English + Arabic", "English + Spanish",
                        "English + French", "English + Hindi", "English + Turkish", "English + German",
                        "English + Portuguese", "English + Chinese (Mandarin)", "English + Russian",
                        "English + Japanese", "English + Korean", "English + Italian", "English + Urdu",
                        "English + Bengali", "English + Persian", "English + Indonesian", "English + Malay",
                        "English + Dutch", "English + Swahili", "English + Tamil", "English + Punjabi",
                        "English + Vietnamese", "English + Thai", "English + Filipino (Tagalog)",
                        "English + Greek", "English + Polish", "English + Ukrainian"
                        };
                var isKnownLanguageOption = languageInstructionOptions.Any(opt =>
                languageOfInstruction.Equals(opt, StringComparison.OrdinalIgnoreCase));
                var isOtherLanguage = !string.IsNullOrWhiteSpace(languageOfInstruction)
                && !isKnownLanguageOption
                && !languageOfInstruction.Equals("Others", StringComparison.OrdinalIgnoreCase);
                var showOtherLanguageInput = isOtherLanguage || languageOfInstruction.Equals("Others", StringComparison.OrdinalIgnoreCase);
            }

            <!-- ===================== ENTIRE FORM STARTS HERE ===================== -->
            <form method="post"
                  asp-controller="Home"
                  asp-action="SavePostgraduatePrograms"
                  enctype="multipart/form-data"
                  id="mainPostgraduateForm">

                <!-- ================= PUBLIC INFO ================= -->
                <section class="card" id="sec-general">
                    <div class="card-hd">
                        <h2>Public Info</h2>
                        <p>Auto-filled from your bachelor's application. These fields cannot be edited here.</p>
                    </div>
                    <div class="card-bd section-readonly">
                        <!-- Hidden inputs for disabled selects so values are submitted -->
                        <input type="hidden" name="OversightRightsEntity" value="@P.OversightRightsEntity" />
                        <input type="hidden" name="ModeOfStudy" value="@P.ModeOfStudy" />
                        <input type="hidden" name="LanguageOfInstruction" value="@(isOtherLanguage ? languageOfInstruction : languageOfInstruction)" />
                        <div class="grid-2">
                            <div class="field">
                                <label>Name of Institution</label>
                                <input name="InstitutionName" value="@P.InstitutionName" readonly />
                            </div>
                            <div class="field">
                                <label>Official Entity Possessing Oversight Rights</label>
                                <select name="_OversightRightsEntity" disabled>
                                    <option selected="@(P.OversightRightsEntity == "Ministry")">Ministry</option>
                                    <option selected="@(P.OversightRightsEntity == "Accreditation Body")">Accreditation Body</option>
                                    <option selected="@(P.OversightRightsEntity == "Other")">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid-2">
                            <div class="field">
                                <label>Founding Date</label>
                                <input name="FoundationDate" type="date" value="@P.FoundationDate" readonly />
                            </div>
                            <div class="field">
                                <label>Date of Establishment</label>
                                <input name="DateOfEstablishment" type="date" value="@P.DateOfEstablishment" readonly />
                            </div>
                            <div class="field">
                                <label>Mode of Study</label>
                                <select name="_ModeOfStudy" disabled>
                                    <option selected="@(P.ModeOfStudy == "On-campus")">On-campus</option>
                                    <option selected="@(P.ModeOfStudy == "Blended")">Blended</option>
                                    <option selected="@(P.ModeOfStudy == "Online")">Online</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>Language of Instruction</label>
                                <select name="_LanguageOfInstruction" disabled>
                                    @foreach (var languageOption in languageInstructionOptions)
                                    {
                                        <option value="@languageOption" selected="@(languageOfInstruction.Equals(languageOption, StringComparison.OrdinalIgnoreCase))">@languageOption</option>
                                    }
                                    <option value="Others" selected="@showOtherLanguageInput">Others</option>
                                </select>
                                @if (isOtherLanguage)
                                {
                                    <input type="text" name="LanguageOfInstructionOther" value="@languageOfInstruction" readonly style="margin-top:10px;" />
                                }
                            </div>
                            <div class="field">
                                <label>Start of Teaching</label>
                                <input name="StartOfTeaching" type="date" value="@P.StartOfTeaching" readonly />
                            </div>
                        </div>
                        <div class="subhead">Information of President of Institution</div>
                        <div class="grid-3">
                            <div class="field">
                                <label>Name</label>
                                <input name="PresidentName" value="@P.PresidentName" readonly />
                            </div>
                        </div>
                        <div class="subhead">Contact Information</div>
                        <div class="grid-2">
                            <div class="field">
                                <label>Mailing Full Address</label>
                                <input name="MailingFullAddress" value="@P.MailingFullAddress" readonly />
                            </div>
                            <div class="field">
                                <label>Direct Phone Number</label>
                                <input name="DirectPhoneNumber" value="@P.DirectPhoneNumber" inputmode="tel" readonly />
                            </div>
                            <div class="field">
                                <label>Email Address</label>
                                <input name="EmailAddress" value="@P.EmailAddress" type="email" readonly />
                            </div>
                            <div class="field">
                                <label>Institutional Web Address</label>
                                <input name="InstitutionalWebAddress" value="@P.InstitutionalWebAddress" type="url" readonly />
                            </div>
                            <div class="field">
                                <label><i class="fa-solid fa-earth-americas" style="margin-right:4px;"></i> Country</label>
                                <input name="Country" type="text"
                                       value="@(!string.IsNullOrWhiteSpace(Model?.Country) ? Model.Country : (ViewBag.Country as string ?? ""))" readonly />
                            </div>
                            <div class="field">
                                <label><i class="fa-solid fa-location-dot" style="margin-right:4px;"></i> City</label>
                                <input name="City" type="text"
                                       value="@(!string.IsNullOrWhiteSpace(Model?.City) ? Model.City : (ViewBag.City as string ?? ""))" readonly />
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= PROGRAMS ================= -->
                <section class="card" id="sec-programs">
                    <div class="card-hd">
                        <h2>Postgraduate Programs</h2>
                        <p>Select the degree levels offered, then add each program manually.</p>
                    </div>
                    <div class="card-bd">
                        <!-- Degree pills -->
                        <div class="degree-options">
                            <label class="degree-pill">
                                <input type="checkbox" id="chkMaster" hidden />
                                <span>Master</span>
                            </label>
                            <label class="degree-pill">
                                <input type="checkbox" id="chkPhD" hidden />
                                <span>PhD</span>
                            </label>
                            <label class="degree-pill">
                                <input type="checkbox" id="chkDiploma" hidden />
                                <span>Higher Diploma</span>
                            </label>
                        </div>

                        <!-- Programs JSON (submitted with form) -->
                        <input type="hidden" name="PostgraduateProgramsJson" id="pgProgramsJson" value="[]" />

                        <!-- ── MASTER SECTION ── -->
                        <div id="masterProgSection" style="display:none; margin-top:22px;">
                            <div style="background:#fdf4ff; border:1px solid #e9d5ff; border-radius:12px 12px 0 0; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                <div style="font-weight:700; font-size:14px; color:#7e22ce;">
                                    <i class="fa-solid fa-graduation-cap" style="margin-right:8px;"></i> Master Programs
                                </div>
                                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                    <button type="button" id="pgAddBtn_master" onclick="showPgForm('master')"
                                            style="display:inline-flex;align-items:center;gap:7px;padding:8px 18px;background:#fff;border:2px solid #9333ea;color:#9333ea;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
                                        <i class="fa-solid fa-plus"></i> Add Master Program
                                    </button>
                                </div>
                            </div>
                            <div style="border:1px solid #e9d5ff; border-top:none; border-radius:0 0 12px 12px; overflow:hidden;">
                                <div id="pgEmpty_master" style="padding:18px; text-align:center; color:#9ca3af; font-size:13px; background:#fafafa;">
                                    <i class="fa-solid fa-circle-info" style="margin-right:6px; color:#94a3b8;"></i> No Master programs added yet.
                                </div>
                                <div id="pgTableWrap_master" style="display:none; overflow-x:auto;">
                                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                        <thead>
                                            <tr>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">Program Name</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">College / Faculty</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:center;width:72px;">Years</th>
                                                <th style="background:#f1f0ec;padding:9px 11px;border-bottom:2px solid #e2ddd8;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="pgTableBody_master"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="pgAddPanel_master" style="display:none; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-top:10px;">
                                <div style="font-weight:700; font-size:13px; color:#111827; margin-bottom:12px;" id="pgPanelTitle_master">Add Master Program</div>
                                <div class="grid-2">
                                    <div class="field">
                                        <label>Program Name <span class="req">*</span></label>
                                        <input type="text" id="pgPName_master" placeholder="e.g. Business Administration" />
                                    </div>
                                    <div class="field">
                                        <label>College / Faculty <span class="req">*</span></label>
                                        <input type="text" id="pgPCollege_master" placeholder="e.g. Faculty of Commerce" />
                                    </div>
                                    <div class="field">
                                        <label>Number of Years <span class="req">*</span></label>
                                        <input type="number" id="pgPYears_master" min="1" max="10" placeholder="e.g. 2" />
                                    </div>
                                </div>
                                <input type="hidden" id="pgPSpec_master" />
                                <div class="actions" style="justify-content:flex-start; margin-top:12px; gap:10px;">
                                    <button type="button" class="btn-primary" onclick="confirmPgAdd('master')">Save Program</button>
                                    <button type="button" onclick="hidePgForm('master')" style="background:#fff;color:#374151;border:1px solid #d1d5db;padding:8px 18px;border-radius:8px;font-weight:600;cursor:pointer;">Cancel</button>
                                </div>
                            </div>
                        </div>

                        <!-- ── PhD SECTION ── -->
                        <div id="phdProgSection" style="display:none; margin-top:16px;">
                            <div style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:12px 12px 0 0; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                <div style="font-weight:700; font-size:14px; color:#15803d;">
                                    <i class="fa-solid fa-book-open-reader" style="margin-right:8px;"></i> PhD Programs
                                </div>
                                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                    <button type="button" id="pgAddBtn_phd" onclick="showPgForm('phd')"
                                            style="display:inline-flex;align-items:center;gap:7px;padding:8px 18px;background:#fff;border:2px solid #16a34a;color:#16a34a;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
                                        <i class="fa-solid fa-plus"></i> Add PhD Program
                                    </button>
                                </div>
                            </div>
                            <div style="border:1px solid #bbf7d0; border-top:none; border-radius:0 0 12px 12px; overflow:hidden;">
                                <div id="pgEmpty_phd" style="padding:18px; text-align:center; color:#9ca3af; font-size:13px; background:#fafafa;">
                                    <i class="fa-solid fa-circle-info" style="margin-right:6px; color:#94a3b8;"></i> No PhD programs added yet.
                                </div>
                                <div id="pgTableWrap_phd" style="display:none; overflow-x:auto;">
                                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                        <thead>
                                            <tr>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">Program Name</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">College / Faculty</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:center;width:72px;">Years</th>
                                                <th style="background:#f1f0ec;padding:9px 11px;border-bottom:2px solid #e2ddd8;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="pgTableBody_phd"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="pgAddPanel_phd" style="display:none; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-top:10px;">
                                <div style="font-weight:700; font-size:13px; color:#111827; margin-bottom:12px;" id="pgPanelTitle_phd">Add PhD Program</div>
                                <div class="grid-2">
                                    <div class="field">
                                        <label>Program Name <span class="req">*</span></label>
                                        <input type="text" id="pgPName_phd" placeholder="e.g. Computer Science" />
                                    </div>
                                    <div class="field">
                                        <label>College / Faculty <span class="req">*</span></label>
                                        <input type="text" id="pgPCollege_phd" placeholder="e.g. Faculty of Computers and AI" />
                                    </div>
                                    <div class="field">
                                        <label>Number of Years <span class="req">*</span></label>
                                        <input type="number" id="pgPYears_phd" min="1" max="10" placeholder="e.g. 4" />
                                    </div>
                                </div>
                                <input type="hidden" id="pgPSpec_phd" />
                                <div class="actions" style="justify-content:flex-start; margin-top:12px; gap:10px;">
                                    <button type="button" class="btn-primary" onclick="confirmPgAdd('phd')">Save Program</button>
                                    <button type="button" onclick="hidePgForm('phd')" style="background:#fff;color:#374151;border:1px solid #d1d5db;padding:8px 18px;border-radius:8px;font-weight:600;cursor:pointer;">Cancel</button>
                                </div>
                            </div>
                        </div>

                        <!-- ── HIGHER DIPLOMA SECTION ── -->
                        <div id="diplomaProgSection" style="display:none; margin-top:16px;">
                            <div style="background:#fff7ed; border:1px solid #fed7aa; border-radius:12px 12px 0 0; padding:14px 18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                                <div style="font-weight:700; font-size:14px; color:#c2410c;">
                                    <i class="fa-solid fa-scroll" style="margin-right:8px;"></i> Higher Diploma Programs
                                </div>
                                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                    <button type="button" id="pgAddBtn_diploma" onclick="showPgForm('diploma')"
                                            style="display:inline-flex;align-items:center;gap:7px;padding:8px 18px;background:#fff;border:2px solid #ea580c;color:#ea580c;border-radius:8px;font-size:13px;font-weight:700;cursor:pointer;">
                                        <i class="fa-solid fa-plus"></i> Add Higher Diploma Program
                                    </button>
                                </div>
                            </div>
                            <div style="border:1px solid #fed7aa; border-top:none; border-radius:0 0 12px 12px; overflow:hidden;">
                                <div id="pgEmpty_diploma" style="padding:18px; text-align:center; color:#9ca3af; font-size:13px; background:#fafafa;">
                                    <i class="fa-solid fa-circle-info" style="margin-right:6px; color:#94a3b8;"></i> No Higher Diploma programs added yet.
                                </div>
                                <div id="pgTableWrap_diploma" style="display:none; overflow-x:auto;">
                                    <table style="width:100%; border-collapse:collapse; font-size:13px;">
                                        <thead>
                                            <tr>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">Program Name</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:left;">College / Faculty</th>
                                                <th style="background:#f1f0ec;color:#374151;font-weight:700;padding:9px 11px;border-bottom:2px solid #e2ddd8;text-align:center;width:72px;">Years</th>
                                                <th style="background:#f1f0ec;padding:9px 11px;border-bottom:2px solid #e2ddd8;"></th>
                                            </tr>
                                        </thead>
                                        <tbody id="pgTableBody_diploma"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div id="pgAddPanel_diploma" style="display:none; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-top:10px;">
                                <div style="font-weight:700; font-size:13px; color:#111827; margin-bottom:12px;" id="pgPanelTitle_diploma">Add Higher Diploma Program</div>
                                <div class="grid-2">
                                    <div class="field">
                                        <label>Program Name <span class="req">*</span></label>
                                        <input type="text" id="pgPName_diploma" placeholder="e.g. Hospital Pharmacy" />
                                    </div>
                                    <div class="field">
                                        <label>College / Faculty <span class="req">*</span></label>
                                        <input type="text" id="pgPCollege_diploma" placeholder="e.g. Faculty of Pharmacy" />
                                    </div>
                                    <div class="field">
                                        <label>Number of Years <span class="req">*</span></label>
                                        <input type="number" id="pgPYears_diploma" min="1" max="10" placeholder="e.g. 1" />
                                    </div>
                                </div>
                                <input type="hidden" id="pgPSpec_diploma" />
                                <div class="actions" style="justify-content:flex-start; margin-top:12px; gap:10px;">
                                    <button type="button" class="btn-primary" onclick="confirmPgAdd('diploma')">Save Program</button>
                                    <button type="button" onclick="hidePgForm('diploma')" style="background:#fff;color:#374151;border:1px solid #d1d5db;padding:8px 18px;border-radius:8px;font-weight:600;cursor:pointer;">Cancel</button>
                                </div>
                            </div>
                        </div>

                        <div class="actions" style="justify-content:center; margin-top:24px;">
                            <button type="button" id="btnSavePrograms" class="btn-primary">
                                Save Programs →
                            </button>
                        </div>
                    </div>
                </section>

                <!-- ================= STUDENTS ================= -->
                <section class="card" id="sec-students">
                    <div class="card-hd modern-hd">
                        <div class="students-title-wrap">
                            <div>
                                <h2>Number of Students</h2>
                                <p>Enter the total number of enrolled postgraduate students.</p>
                            </div>
                        </div>
                    </div>
                    <div class="card-bd students-modern-body">
                        <div id="masterStudents" class="student-modern-row" style="display:none;">
                            <div class="student-left">
                                <div class="student-mini-icon">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                </div>
                                <div>
                                    <label>Master Students <span class="required">*</span></label>
                                    <small>Total enrolled master students</small>
                                </div>
                            </div>
                            <input asp-for="MasterStudents" type="number" />
                        </div>
                        <div id="phdStudents" class="student-modern-row" style="display:none;">
                            <div class="student-left">
                                <div class="student-mini-icon">
                                    <i class="fa-solid fa-book-open-reader"></i>
                                </div>
                                <div>
                                    <label>PhD Students <span class="required">*</span></label>
                                    <small>Total enrolled PhD students</small>
                                </div>
                            </div>
                            <input asp-for="PhDStudents" type="number" />
                        </div>
                        <div id="diplomaStudents" class="student-modern-row" style="display:none; border-bottom:none;">
                            <div class="student-left">
                                <div class="student-mini-icon">
                                    <i class="fa-solid fa-scroll"></i>
                                </div>
                                <div>
                                    <label>Diploma Students <span class="required">*</span></label>
                                    <small>Total enrolled diploma students</small>
                                </div>
                            </div>
                            <input asp-for="DiplomaStudents" type="number" />
                        </div>
                        <div class="actions" style="justify-content:center; margin-top:20px;">
                            <button type="button" id="btnSaveStudents" class="btn-primary">
                                Save Students →
                            </button>
                        </div>
                    </div>
                </section>

                <!-- ================= FACULTY ================= -->
