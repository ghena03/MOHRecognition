        function selectCategory(cat) {
            addCategory = cat;
            isManual    = false;
            addLevel    = null;
            document.getElementById('catBachBtn').classList.toggle('active', cat === 'Bachelor');
            document.getElementById('catPGBtn').classList.toggle('active',   cat === 'Postgraduate');
            document.getElementById('step2').style.display           = 'block';
            document.getElementById('step3').style.display           = 'none';
            document.getElementById('noMatchMsg').style.display      = 'none';
            document.getElementById('manualEntryLink').style.display = 'none';
            document.getElementById('manualNameWrap').style.display  = 'none';
            document.getElementById('addCollege').value = '';

            if (cat === 'Bachelor') {
                document.getElementById('pgProgWrap').style.display = 'none';
                var sel = document.getElementById('bachProgSel');
                sel.innerHTML = '<option value="">-- Select Bachelor Program --</option>';
                if (bachelorProgs.length === 0) {
                    document.getElementById('bachProgWrap').style.display = 'none';
                    document.getElementById('noMatchMsg').style.display   = 'block';
                } else {
                    bachelorProgs.forEach(function(p) {
                        sel.innerHTML += '<option value="' + escA(p.name) + '" data-college="' + escA(p.college) + '" data-years="' + (p.years || '') + '">' + esc(p.name) + '</option>';
                    });
                    document.getElementById('bachProgWrap').style.display    = 'block';
                    document.getElementById('manualEntryLink').style.display = 'block';
                }
                addLevel = 'Bachelor';
            } else {
                document.getElementById('bachProgWrap').style.display = 'none';
                var pgSel = document.getElementById('pgProgSel');
                pgSel.innerHTML = '<option value="">-- Select Postgraduate Program --</option>';
                if (pgPrograms.length === 0) {
                    document.getElementById('pgProgWrap').style.display = 'none';
                    document.getElementById('noMatchMsg').style.display = 'block';
                } else {
                    var pgGroups = {};
                    pgPrograms.forEach(function(p) {
                        var lv = p.degreeLevel || 'Other';
                        if (!pgGroups[lv]) pgGroups[lv] = [];
                        pgGroups[lv].push(p);
                    });
                    ['Master','PhD','Higher Diploma'].forEach(function(lv) {
                        if (!pgGroups[lv] || pgGroups[lv].length === 0) return;
                        var grp = document.createElement('optgroup');
                        grp.label = lv;
                        pgGroups[lv].forEach(function(p) {
                            var opt = document.createElement('option');
                            opt.value           = p.name;
                            opt.dataset.level   = p.degreeLevel;
                            opt.dataset.college = p.college;
                            opt.dataset.years   = p.years || '';
                            opt.textContent     = p.name;
                            grp.appendChild(opt);
                        });
                        pgSel.appendChild(grp);
                    });
                    document.getElementById('pgProgWrap').style.display      = 'block';
                    document.getElementById('manualEntryLink').style.display = 'block';
                }
            }
        }

        function onBachProgramChange() {
            var sel = document.getElementById('bachProgSel');
            if (!sel.value) { document.getElementById('step3').style.display = 'none'; return; }
            var opt = sel.selectedOptions[0];
            document.getElementById('addCollege').value = opt.dataset.college || '';
            pgTraditionalYears = opt.dataset.years ? parseInt(opt.dataset.years, 10) : null;
            document.getElementById('step3').style.display = 'block';
        }

        var pgTraditionalYears = null;

        function onPgProgramChange() {
            var sel = document.getElementById('pgProgSel');
            if (!sel.value) { document.getElementById('step3').style.display = 'none'; return; }
            var opt = sel.selectedOptions[0];
            addLevel = opt.dataset.level || 'Master';
