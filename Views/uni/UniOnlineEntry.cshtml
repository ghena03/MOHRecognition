        function resetAddForm() {
            addCategory = null; addLevel = null; isManual = false;
            document.getElementById('catBachBtn').classList.remove('active');
            document.getElementById('catPGBtn').classList.remove('active');
            document.getElementById('step2').style.display           = 'none';
