    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ── Server-injected data ──────────────────────────────────────────
        var bachelorProgs = @Html.Raw(bachProgJson);
        var pgPrograms    = @Html.Raw(pgProgsJson);
        var staffLevels   = {
            Bach: { prof: @impProf, assoc: @impAssoc, asst: @impAsst },
            PG:   { prof: @pgTotalProf, assoc: @pgTotalAssoc, asst: @pgTotalAsst }
        };
        staffLevels.Bach.total = staffLevels.Bach.prof + staffLevels.Bach.assoc + staffLevels.Bach.asst;
        staffLevels.PG.total   = staffLevels.PG.prof   + staffLevels.PG.assoc   + staffLevels.PG.asst;

        // ── State ─────────────────────────────────────────────────────────
        var programs    = [];
        var addCategory = null;
        var addLevel    = null;
        var isManual    = false;

        // Expose for dev tool — single function with direct scope access
        window.devFillOnlinePrograms = function(list) {
            programs.length = 0;
            list.forEach(function(p) { programs.push(p); });
            renderTable();
            updateAll();
        };

        // ── Sidebar active highlight ───────────────────────────────────────
        (function () {
            var OFFSET = 150; // px from top of viewport a section must reach before becoming active
            var ids    = ['sec-intro','sec-pubinfo','sec-programs','sec-numbers',
                          'sec-communication','sec-exam','sec-platform','sec-applicant'];
            var links  = document.querySelectorAll('.sidebar .side-item[data-section]');
            var locked = false; // suppresses scroll-spy briefly after a click

            function activate(id) {
                links.forEach(function (a) {
                    a.classList.toggle('active', a.dataset.section === id);
                });
            }

            // Scroll-spy: active = last section whose top <= scrollY + OFFSET
            function onScroll() {
                if (locked) return;
                var scrollY  = window.pageYOffset;
                var activeId = ids[0];
                ids.forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el && el.offsetTop <= scrollY + OFFSET) activeId = id;
                });
                activate(activeId);
            }

            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll(); // set correct item on page load

            // Sidebar click: set active immediately, scroll, then re-enable spy
            links.forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var id = this.dataset.section;
                    activate(id);
                    locked = true;
                    var el = document.getElementById(id);
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    // Re-enable scroll spy after animation finishes (~600 ms)
                    setTimeout(function () { locked = false; }, 700);
                });
            });
        })();

        // ── Scroll helper (used by in-section buttons) ────────────────────
        function getFieldContainer(el) {
            return el?.closest('.field, .applicant-field') || null;
        }

        function clearFieldError(el) {
            if (!el) return;
            el.classList.remove('input-invalid');
            var container = getFieldContainer(el);
            if (!container) return;
            var msg = container.querySelector('.field-required-error');
            if (msg) msg.remove();
        }

        function setFieldError(el, message) {
            if (!el) return;
            el.classList.add('input-invalid');
            var container = getFieldContainer(el);
            if (!container) return;

            var msg = container.querySelector('.field-required-error');
            if (!msg) {
                msg = document.createElement('div');
                msg.className = 'field-required-error';
                container.appendChild(msg);
            }
            msg.textContent = message || 'This field is required.';
        }

        function clearSectionValidation(sectionId) {
            var section = document.getElementById(sectionId);
            if (!section) return;
            section.querySelectorAll('.input-invalid').forEach(function(el) { el.classList.remove('input-invalid'); });
            section.querySelectorAll('.field-required-error, .group-required-error').forEach(function(el) { el.remove(); });
        }

        function focusFirstInvalid(firstInvalid) {
            if (!firstInvalid) return;
            firstInvalid.focus({ preventScroll: true });
            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function appendGroupError(targetEl, message) {
            if (!targetEl) return;
            var msg = targetEl.parentElement?.querySelector('.group-required-error');
            if (!msg) {
                msg = document.createElement('div');
                msg.className = 'group-required-error';
                targetEl.insertAdjacentElement('afterend', msg);
            }
            msg.textContent = message || 'This field is required.';
        }

        function validateRequiredFieldByName(sectionId, fieldName, firstInvalidRef) {
            var el = document.querySelector('[name=\"' + fieldName + '\"]');
            var value = (el?.value || '').toString().trim();
            if (value.length > 0) {
                clearFieldError(el);
                return true;
            }

            setFieldError(el, 'This field is required.');
            if (!firstInvalidRef.value) firstInvalidRef.value = el;
            return false;
        }

        function validatePublicInfoSection() {
            clearSectionValidation('sec-pubinfo');
            var firstInvalidRef = { value: null };
            var ok = true;

            [
                'InstitutionName', 'OversightRightsEntity', 'FoundationDate', 'DateOfEstablishment',
                'ModeOfStudy', 'LanguageOfInstruction', 'StartOfTeaching', 'MailingFullAddress',
                'DirectPhoneNumber', 'EmailAddress', 'InstitutionalWebAddress', 'Country', 'Location'
            ].forEach(function(name) {
                if (!validateRequiredFieldByName('sec-pubinfo', name, firstInvalidRef)) ok = false;
            });

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validateProgramsSection() {
            clearSectionValidation('sec-programs');
            if (programs.length > 0) return { ok: true, firstInvalid: null };

            var target = document.getElementById('addProgBtn');
            appendGroupError(target, 'This field is required.');
            return { ok: false, firstInvalid: target };
        }

        function validateNumbersSection() {
            clearSectionValidation('sec-numbers');
            var firstInvalidRef = { value: null };
            var ok = true;

            var fieldIds = ['bn-count','bn-students','bn-staff','bn-prof','bn-assoc','bn-asst',
                            'pg-count','pg-students','pg-staff','pg-prof','pg-assoc','pg-asst'];

            fieldIds.forEach(function(id) {
                var el = document.getElementById(id);
                if (!el) return;
                var val = parseInt(el.value, 10);
                if (!el.value.trim() || isNaN(val) || val <= 0) {
                    el.classList.add('input-invalid');
                    if (!firstInvalidRef.value) firstInvalidRef.value = el;
                    ok = false;
                }
            });

            if (!ok) {
                var numGrid = document.querySelector('#sec-numbers .num-grid');
                if (numGrid) {
                    var existing = numGrid.parentElement.querySelector('.group-required-error');
                    if (!existing) {
                        var errDiv = document.createElement('div');
                        errDiv.className = 'group-required-error';
                        errDiv.style.marginBottom = '10px';
                        errDiv.textContent = 'All fields must be filled with a value before saving.';
                        numGrid.insertAdjacentElement('beforebegin', errDiv);
                    }
                }
            }

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validateCommunicationSection() {
            clearSectionValidation('sec-communication');
            var firstInvalidRef = { value: null };
            var ok = true;

            var communicationType = document.querySelector('input[name=\"CommunicationType\"]:checked');
            if (!communicationType) {
                var typeAnchor = document.querySelector('#sec-communication .radio-row');
                appendGroupError(typeAnchor, 'This field is required.');
                firstInvalidRef.value = firstInvalidRef.value || document.querySelector('input[name=\"CommunicationType\"]');
                ok = false;
            }

            var commMethods = document.querySelectorAll('.comm-chk:checked');
            if (!commMethods.length) {
                var methodsAnchor = document.querySelector('#sec-communication .check-grid');
                appendGroupError(methodsAnchor, 'This field is required.');
                firstInvalidRef.value = firstInvalidRef.value || document.querySelector('.comm-chk');
                ok = false;
            }

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validateExamSection() {
            clearSectionValidation('sec-exam');
            var firstInvalidRef = { value: null };
            var ok = true;

            var examType = document.querySelector('input[name=\"ExamType\"]:checked');
            if (!examType) {
                var anchor = document.querySelector('#sec-exam .radio-row');
                appendGroupError(anchor, 'This field is required.');
                firstInvalidRef.value = firstInvalidRef.value || document.querySelector('input[name=\"ExamType\"]');
                ok = false;
            } else {
                var value = examType.value || '';
                if ((value === 'Online Exams' || value === 'Hybrid Exams') && !document.querySelector('#proctorChipGroup .circle-opt.selected')) {
                    var proctorAnchor = document.querySelector('#proctorChipGroup');
                    appendGroupError(proctorAnchor, 'Please select at least one monitoring method.');
                    firstInvalidRef.value = firstInvalidRef.value || proctorAnchor;
                    ok = false;
                }
                var otherChip = document.getElementById('proctorOtherChip');
                if (otherChip && otherChip.classList.contains('selected')) {
                    var otherTxt = document.getElementById('proctorOtherText');
                    if (!otherTxt.value.trim()) {
                        appendGroupError(document.getElementById('proctorOtherBox'), 'Please specify the monitoring/proctoring method used.');
                        firstInvalidRef.value = firstInvalidRef.value || otherTxt;
                        ok = false;
                    }
                }
            }

            var onlineExamPanel = document.getElementById('onlineExamFields');
            if (onlineExamPanel && onlineExamPanel.style.display !== 'none') {
                var examFileInput = document.getElementById('ExamPolicyFile');
                if (examFileInput && (!examFileInput.files || !examFileInput.files.length)) {
                    setFieldError(examFileInput, 'Please upload an Exam Monitoring Evidence file.');
                    firstInvalidRef.value = firstInvalidRef.value || examFileInput;
                    ok = false;
                }
            }

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validatePlatformSection() {
            clearSectionValidation('sec-platform');
            var firstInvalidRef = { value: null };
            var ok = true;

            ['PlatformName', 'PlatformUrl', 'ResponsibleUnit'].forEach(function(name) {
                if (!validateRequiredFieldByName('sec-platform', name, firstInvalidRef)) ok = false;
            });

            var platformFileInput = document.getElementById('platformAdoptionEvidenceFile');
            if (platformFileInput && (!platformFileInput.files || !platformFileInput.files.length)) {
                setFieldError(platformFileInput, 'Please upload the LMS / Platform Evidence file.');
                firstInvalidRef.value = firstInvalidRef.value || platformFileInput;
                ok = false;
            }

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validateApplicantSection() {
            clearSectionValidation('sec-applicant');
            var firstInvalidRef = { value: null };
            var ok = true;

            ['Name', 'WorkPlace'].forEach(function(name) {
                if (!validateRequiredFieldByName('sec-applicant', name, firstInvalidRef)) ok = false;
            });

            return { ok: ok, firstInvalid: firstInvalidRef.value };
        }

        function validateFullOnlineForm() {
            var checks = [
                validatePublicInfoSection(),
                validateProgramsSection(),
                validateNumbersSection(),
                validateCommunicationSection(),
                validateExamSection(),
                validatePlatformSection(),
                validateApplicantSection()
            ];

            return {
                ok: checks.every(function(c) { return c.ok; }),
                firstInvalid: checks.map(function(c) { return c.firstInvalid; }).find(Boolean) || null
            };
        }

        function scrollToNext(sectionId) {
            var mapping = {
                'sec-programs': validatePublicInfoSection,
                'sec-numbers': validateProgramsSection,
                'sec-communication': validateNumbersSection,
                'sec-exam': validateCommunicationSection,
                'sec-platform': validateExamSection,
                'sec-applicant': validatePlatformSection
            };

            if (mapping[sectionId]) {
                var result = mapping[sectionId]();
                if (!result.ok) {
                    focusFirstInvalid(result.firstInvalid);
                    return;
                }
            }

            var el = document.getElementById(sectionId);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // ── Compute numbers (staff counted once per level) ─────────────────
        function computeNumbers() {
            var bachProgs = programs.filter(function(p){ return p.category === 'Bachelor'; });
            var pgProgs   = programs.filter(function(p){ return p.category === 'Postgraduate'; });
            var hasBach   = bachProgs.length > 0;
            var hasPG     = pgProgs.length   > 0;

            var bachStudents = bachProgs.reduce(function(s,p){ return s + (p.OnlineStudents||0); }, 0);
            var pgStudents   = pgProgs.reduce(function(s,p){   return s + (p.OnlineStudents||0); }, 0);

            var bProf  = hasBach ? staffLevels.Bach.prof  : 0;
            var bAssoc = hasBach ? staffLevels.Bach.assoc : 0;
            var bAsst  = hasBach ? staffLevels.Bach.asst  : 0;
            var bTotal = bProf + bAssoc + bAsst;

            var pProf  = hasPG ? staffLevels.PG.prof  : 0;
            var pAssoc = hasPG ? staffLevels.PG.assoc : 0;
            var pAsst  = hasPG ? staffLevels.PG.asst  : 0;
            var pTotal = pProf + pAssoc + pAsst;

            return {
                bachCount: bachProgs.length,    pgCount: pgProgs.length,
                bachStudents: bachStudents,       pgStudents: pgStudents,
                bProf: bProf, bAssoc: bAssoc, bAsst: bAsst, bTotal: bTotal,
                pProf: pProf, pAssoc: pAssoc, pAsst: pAsst, pTotal: pTotal,
                totalProgs:    programs.length,
                totalStudents: bachStudents + pgStudents,
                totalStaff:    bTotal + pTotal
            };
        }

function updateOverallTotals() {
    var bnCount    = parseInt(document.getElementById('bn-count')?.value)    || 0;
    var bnStudents = parseInt(document.getElementById('bn-students')?.value) || 0;
    var bnStaff    = parseInt(document.getElementById('bn-staff')?.value)    || 0;
    var bnProf     = parseInt(document.getElementById('bn-prof')?.value)     || 0;
    var bnAssoc    = parseInt(document.getElementById('bn-assoc')?.value)    || 0;
    var bnAsst     = parseInt(document.getElementById('bn-asst')?.value)     || 0;
    var pgCount    = parseInt(document.getElementById('pg-count')?.value)    || 0;
    var pgStudents = parseInt(document.getElementById('pg-students')?.value) || 0;
    var pgStaff    = parseInt(document.getElementById('pg-staff')?.value)    || 0;
    var pgProf     = parseInt(document.getElementById('pg-prof')?.value)     || 0;
    var pgAssoc    = parseInt(document.getElementById('pg-assoc')?.value)    || 0;
    var pgAsst     = parseInt(document.getElementById('pg-asst')?.value)     || 0;

    document.getElementById('ov-count').textContent    = bnCount + pgCount;
    document.getElementById('ov-students').textContent = bnStudents + pgStudents;
    document.getElementById('ov-staff').textContent    = bnProf + bnAssoc + bnAsst + bnStaff + pgProf + pgAssoc + pgAsst + pgStaff;
}


function updateAll() { updateOverallTotals(); }


