@{
    Layout = null;
}
@model MOHRecognition.DTOs.OnlineEducationDto
<!doctype html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Online / Blended Learning Recognition — Ministry of Higher Education</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/uni/UniDashboard.css" asp-append-version="true" />
    <style>
        /* ── Category select buttons ── */
        .cat-row { display: flex; gap: 12px; }
        .cat-btn {
            flex: 1;
            padding: 14px 16px;
            border: 2px solid #e2ddd6;
            border-radius: 14px;
            background: #fff;
            cursor: pointer;
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            transition: all .12s;
        }
        .cat-btn:hover, .cat-btn.active {
            border-color: #9e1b32;
            background: #fdf5f6;
            color: #9e1b32;
        }

        /* ── Add program panel ── */
        .add-panel {
            background: #faf7f2;
            border: 1px solid #eee7dd;
            border-radius: 14px;
            padding: 18px;
            margin-top: 16px;
        }
        .add-panel-title {
            font-size: 15px;
            font-weight: 900;
            color: #9e1b32;
            margin-bottom: 18px;
            padding-bottom: 12px;
            border-bottom: 1px solid #eee7dd;
        }
        .step-lbl {
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #9e1b32;
            margin-bottom: 10px;
        }

        /* ── No-match message ── */
        .no-match-msg {
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
            padding: 12px 16px;
            color: #991b1b;
            font-size: 13.5px;
            margin-top: 8px;
        }

        /* ── Delivery / category badges ── */
        .badge {
            display: inline-flex;
            align-items: center;
            font-size: 11.5px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            white-space: nowrap;
        }
        .badge-bach    { background: #fdf5f6; color: #9e1b32;  border: 1px solid #f5c6ce; }
        .badge-pg      { background: #faf7f2; color: #7b2030;  border: 1px solid #eee7dd; }
        .badge-online  { background: #f0fdf4; color: #15803d;  border: 1px solid #86efac; }
        .badge-blended { background: #fff7ed; color: #c2410c;  border: 1px solid #fed7aa; }
        .badge-src     { background: #faf7f2; color: #5a4a43;  border: 1px solid #eee7dd; font-size: 11px; }
        .badge-sync-pass { background:#f0fdf4; color:#15803d; border:1px solid #86efac; }
        .badge-sync-fail { background:#fff1f2; color:#b91c1c; border:1px solid #fca5a5; }
        .badge-sync-warn { background:#fffbeb; color:#92400e; border:1px solid #fcd34d; }

        /* ── File upload success indicator ── */
        .file-input-wrap { position: relative; display: block; }
        .file-success {
            display: none;
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #16a34a;
            font-size: 15px;
            font-weight: 700;
            pointer-events: none;
        }

        /* ── Inline field hint ── */
        .field-hint {
            display: inline-flex;
            align-items: baseline;
            gap: 5px;
            margin-top: 5px;
            font-size: 11.5px;
            font-weight: 600;
            color: #7a6248;
            background: #fdf8f0;
            border-radius: 5px;
            padding: 3px 7px;
        }

        /* ── Checkbox / radio items ── */
        .check-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }

        /* ── Circle choice (multi-select) ── */
        .circle-opt {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 6px 4px;
            border: none;
            background: none;
            font-size: 14px;
            font-weight: 600;
            color: #4b4540;
            cursor: pointer;
            outline: none;
            user-select: none;
            transition: color .15s;
        }
        .circle-opt:hover { color: #9e1b32; }
        .circle-opt:hover .circle-ring { border-color: #9e1b32; }
        .circle-ring {
            width: 15px; height: 15px;
            border-radius: 50%;
            border: 2px solid #c5b8af;
            background: #fff;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .15s;
        }
        .circle-opt.selected .circle-ring {
            background: #9e1b32;
            border-color: #9e1b32;
        }
        .circle-opt.selected .circle-ring::after {
            content: '';
            display: block;
            width: 3px; height: 6px;
            border: 2px solid #fff;
            border-top: none;
            border-left: none;
            transform: rotate(45deg) translate(-1px, -1px);
        }
        .circle-opt.selected { color: #9e1b32; }
        .chk-item {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 8px;
            background: #faf7f2;
            border: 1px solid #e6ddd1;
            border-radius: 10px;
            padding: 9px 14px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: border-color .1s;
        }
        .chk-item:hover { border-color: #9e1b32; background: #fdf5f6; }
        .chk-item input[type=checkbox] {
            accent-color: #9e1b32;
            width: 15px; height: 15px;
            flex-shrink: 0;
            display: inline-block;
            margin: 0;
        }
        .radio-row { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 10px; }
        .radio-row label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
        }
        .radio-row input[type=radio] { accent-color: #9e1b32; width: 15px; height: 15px; }

        /* ── Academic level numbers ── */
        .num-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 14px;
        }
        @@media (max-width: 640px) { .num-grid { grid-template-columns: 1fr; } }
        .num-box {
            background: #faf7f2;
            border: 1px solid #eee7dd;
            border-radius: 14px;
            padding: 16px 18px;
        }
        .num-box-hd {
            font-size: 13px;
            font-weight: 900;
            color: #9e1b32;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee7dd;
        }
        .num-stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .ns {
            text-align: center;
            background: #fff;
            border: 1px solid #eee7dd;
            border-radius: 10px;
            padding: 10px 6px;
        }
        .ns-lbl {
            font-size: 10px;
            color: #6b7280;
            font-weight: 700;
            margin-bottom: 3px;
            line-height: 1.3;
            text-transform: uppercase;
            letter-spacing: .02em;
        }
        .ns-val { font-size: 22px; font-weight: 900; color: #9e1b32; }
        .overall-box {
            background: #faf7f2;
            border: 1px solid #eee7dd;
            border-radius: 14px;
            padding: 16px 18px;
        }
        .overall-box-hd {
            font-size: 13px;
            font-weight: 900;
            color: #374151;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee7dd;
        }

        /* ── Import badge ── */
        .import-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: #15803d;
            font-weight: 700;
            background: rgba(21,128,61,.08);
            border: 1px solid rgba(21,128,61,.25);
            border-radius: 8px;
            padding: 3px 10px;
        }

        /* ── Section separator ── */
        .form-sep { border: none; border-top: 1px solid #eee7dd; margin: 18px 0; }

        /* ── Programs table (softer than global .tbl) ── */
        .prog-tbl { width: 100%; border-collapse: collapse; }
        .prog-tbl th {
            background: #faf7f2;
            color: #6b7280;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            padding: 10px 14px;
            border-bottom: 1px solid #eee7dd;
            text-align: left;
            white-space: nowrap;
        }
        .prog-tbl td {
            padding: 12px 14px;
            border-bottom: 1px solid #f5f0ea;
            vertical-align: middle;
            font-size: 13.5px;
            color: #111;
        }
        .prog-tbl tbody tr:hover td { background: #fdf9f5; }
        .prog-tbl tbody tr:last-child td { border-bottom: none; }
        .prog-tbl .col-act { width: 72px; text-align: center; white-space: nowrap; }
        .prog-tbl .col-students { text-align: center; }
        .del-btn {
            display: inline-block;
            padding: 4px 12px;
            border: 1px solid #f5c6ce;
            background: #fdf5f6;
            color: #9e1b32;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: background .1s;
        }
        .del-btn:hover { background: #fbe8ea; border-color: #e8a0aa; }
        .field-required-error { color:#dc2626; font-size:12px; font-weight:700; margin:6px 8px 0; }
        .group-required-error { color:#dc2626; font-size:12px; font-weight:700; margin-top:8px; }
        .section-readonly input[readonly],
        .section-readonly select[disabled] {
            background: #f9fafb !important;
            color: #6b7280 !important;
            cursor: default !important;
            border-color: #e5e7eb !important;
        }
        .section-readonly .req { display: none; }
        .ns-input {
    width: 100%;
    border: 1.5px solid #e2d9d0;
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 20px;
    font-weight: 900;
    color: #9e1b32;
    text-align: center;
    background: #fff;
    outline: none;
    box-sizing: border-box;
    transition: border-color .15s;
}
.ns-input:focus {
    border-color: #9e1b32;
    background: #fdf5f6;
}
.ns-input::placeholder { color: #ccc; font-weight: 400; font-size: 16px; }
    </style>
</head>

<body class="submitapp-page ltr">

    <header class="top-header en">
        <div class="hdr-grid">
            <div></div>
            <nav class="hdr-nav">
                <a class="hdr-link" href="@Url.Action("UniStatus","Home")">← Back</a>
                <a class="hdr-link" href="https://www.mohe.gov.jo/" target="_blank">Ministry Website</a>
            </nav>
            <div class="hdr-logo"><img class="rm-logo" src="~/images/mohelogo.png" /></div>
        </div>
        <div class="brand-bar"></div>
    </header>

    <div class="layout">

        <aside class="sidebar">
            <a href="@Url.Action("UniStatus","Home")" class="side-user">
                <div class="user-avatar">UN</div>
                <div class="user-info">
                    <span class="user-name">University Account</span>
                    <span class="user-link">Show account</span>
                </div>
            </a>
            <a class="side-item" href="#sec-intro"         data-section="sec-intro">Introduction</a>
            <a class="side-item" href="#sec-pubinfo"       data-section="sec-pubinfo">Public Info</a>
            <a class="side-item" href="#sec-programs"      data-section="sec-programs">Online Programs</a>
            <a class="side-item" href="#sec-numbers"       data-section="sec-numbers">Online Recognition Numbers</a>
            <a class="side-item" href="#sec-communication" data-section="sec-communication">Communication</a>
            <a class="side-item" href="#sec-exam"          data-section="sec-exam">Examination System</a>
            <a class="side-item" href="#sec-platform"      data-section="sec-platform">Learning Platform</a>
            <a class="side-item" href="#sec-applicant"     data-section="sec-applicant">Applicant Info</a>
            <div class="side-footer">
                <a class="logout" href="@Url.Action("Logout","Home")">Logout</a>
            </div>
        </aside>

        <main class="content">

            <section class="welcome" id="sec-intro">
                <div class="welcome-card">
                    <div class="welcome-icon">🌐</div>
                    <h1 class="welcome-title">Online / Blended Learning Recognition</h1>
                    <p class="welcome-text">Declare which existing Bachelor or Postgraduate programs are delivered fully online or blended.</p>
                </div>
            </section>

            @{
                var pub = ViewBag.Public as DTOs.PublicInfoDto ?? new DTOs.PublicInfoDto();
            }

            <!-- ── PUBLIC INFO ────────────────────────────────────────────── -->
            <section class="card" id="sec-pubinfo">
                <div class="card-hd">
                    <h2>Public Info</h2>
                    <p>Auto-filled from your bachelor's application. These fields cannot be edited here.</p>
                </div>
                <div class="card-bd section-readonly">
                    <!-- Hidden inputs for disabled selects so values are submitted -->
                    <input type="hidden" name="OversightRightsEntity" value="@pub.OversightRightsEntity" />
                    <input type="hidden" name="ModeOfStudy" value="@pub.ModeOfStudy" />
                    <input type="hidden" name="LanguageOfInstruction" value="@pub.LanguageOfInstruction" />
                    <div class="grid-2">
                        <div class="field">
                            <label>Name of Institution</label>
                            <input name="InstitutionName" value="@pub.InstitutionName" readonly />
                        </div>
                        <div class="field">
                            <label>Official Entity Possessing Oversight Rights</label>
                            <select name="_OversightRightsEntity" disabled>
                                <option selected="@(pub.OversightRightsEntity == "Ministry")">Ministry</option>
                                <option selected="@(pub.OversightRightsEntity == "Accreditation Body")">Accreditation Body</option>
                                <option selected="@(pub.OversightRightsEntity == "Other")">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Founding Date</label>
                            <input name="FoundationDate" type="date" value="@pub.FoundationDate" readonly />
                        </div>
                        <div class="field">
                            <label>Date of Establishment</label>
                            <input name="DateOfEstablishment" type="date" value="@pub.DateOfEstablishment" readonly />
                        </div>
                        <div class="field">
                            <label>Mode of Study</label>
                            <select name="_ModeOfStudy" disabled>
                                <option selected="@(pub.ModeOfStudy == "On-campus")">On-campus</option>
                                <option selected="@(pub.ModeOfStudy == "Blended")">Blended</option>
                                <option selected="@(pub.ModeOfStudy == "Online")">Online</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>Language of Instruction</label>
                            <select name="_LanguageOfInstruction" disabled>
                                @foreach (var opt in new[]{"English only","Arabic only","English + Arabic","English + French","English + German","English + Spanish","English + Turkish","English + Hindi","English + Portuguese","English + Chinese (Mandarin)","English + Russian","English + Japanese","English + Korean","English + Italian","English + Urdu","Others"})
                                {
                                    <option value="@opt" selected="@(pub.LanguageOfInstruction == opt)">@opt</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label>Start of Teaching</label>
                            <input name="StartOfTeaching" type="date" value="@pub.StartOfTeaching" readonly />
                        </div>
                    </div>
                    <div class="subhead">Information of President of Institution</div>
                    <div class="grid-3">
                        <div class="field">
                            <label>Name</label>
                            <input name="PresidentName" value="@pub.PresidentName" readonly />
                        </div>
                    </div>
                    <div class="subhead">Contact Information</div>
                    <div class="grid-2">
                        <div class="field">
                            <label>Mailing Full Address</label>
                            <input name="MailingFullAddress" value="@pub.MailingFullAddress" readonly />
                        </div>
                        <div class="field">
                            <label>Direct Phone Number</label>
                            <input name="DirectPhoneNumber" value="@pub.DirectPhoneNumber" inputmode="tel" readonly />
                        </div>
                        <div class="field">
                            <label>Email Address</label>
                            <input name="EmailAddress" value="@pub.EmailAddress" type="email" readonly />
                        </div>
                        <div class="field">
                            <label>Institutional Web Address</label>
                            <input name="InstitutionalWebAddress" value="@pub.InstitutionalWebAddress" type="url" readonly />
                        </div>
                        <div class="field">
                            <label><i class="fa-solid fa-earth-americas" style="margin-right:4px;"></i> Country</label>
                            <input name="Country" type="text" value="@pub.Country" readonly />
                        </div>
                        <div class="field">
                            <label><i class="fa-solid fa-location-dot" style="margin-right:4px;"></i> City</label>
                            <input name="Location" type="text" value="@pub.City" readonly />
                        </div>
                    </div>
                </div>
            </section>

            @{
                var bachelorProgs = ViewBag.BachelorPrograms as List<DTOs.ProgramRowDto> ?? new List<DTOs.ProgramRowDto>();

                int impProf  = ViewBag.ImportedProfessor          is int a ? a : 0;
                int impAssoc = ViewBag.ImportedAssociateProfessor is int b ? b : 0;
                int impAsst  = ViewBag.ImportedAssistantProfessor is int c ? c : 0;

                int pgMasterProf   = ViewBag.PgMasterProf   is int l  ? l  : 0;
                int pgMasterAssoc  = ViewBag.PgMasterAssoc  is int m  ? m  : 0;
                int pgMasterAsst   = ViewBag.PgMasterAsst   is int n  ? n  : 0;
                int pgPhDProf      = ViewBag.PgPhDProf      is int o  ? o  : 0;
                int pgPhDAssoc     = ViewBag.PgPhDAssoc     is int p2 ? p2 : 0;
                int pgPhDAsst      = ViewBag.PgPhDAsst      is int q  ? q  : 0;
                int pgDiplomaProf  = ViewBag.PgDiplomaProf  is int r  ? r  : 0;
                int pgDiplomaAssoc = ViewBag.PgDiplomaAssoc is int s  ? s  : 0;
                int pgDiplomaAsst  = ViewBag.PgDiplomaAsst  is int t2 ? t2 : 0;

                int pgTotalProf  = pgMasterProf  + pgPhDProf  + pgDiplomaProf;
                int pgTotalAssoc = pgMasterAssoc + pgPhDAssoc + pgDiplomaAssoc;
                int pgTotalAsst  = pgMasterAsst  + pgPhDAsst  + pgDiplomaAsst;

                string applicantName      = ViewBag.ApplicantName as string ?? "";
                string applicantWorkPlace = ViewBag.WorkPlace     as string ?? "";
                string pgProgsJson        = ViewBag.PostgraduateProgramsJson as string ?? "[]";

                var bachProgJson = System.Text.Json.JsonSerializer.Serialize(
                    bachelorProgs.Select(p => new { name = p.Program ?? "", college = p.FacultyName ?? "", years = p.NumberOfYears > 0 ? (int?)p.NumberOfYears : null }).ToList()
                );
            }

            <form method="post" asp-controller="Home" asp-action="SaveOnlineApplication"
                  enctype="multipart/form-data" id="mainForm">

                <!-- Hidden computed fields populated by JS before submit -->
                <input type="hidden" name="ProgramsJson"                id="programsJsonInput" value="[]" />
                <input type="hidden" name="TotalOnlineStudents"          id="hTotalStudents"    value="0" />
                <input type="hidden" name="BachelorOnlineStaffProf"      id="hBachProf"         value="0" />
                <input type="hidden" name="BachelorOnlineStaffAssoc"     id="hBachAssoc"        value="0" />
                <input type="hidden" name="BachelorOnlineStaffAsst"      id="hBachAsst"         value="0" />
                <input type="hidden" name="PostgraduateOnlineStaffProf"  id="hPgProf"           value="0" />
                <input type="hidden" name="PostgraduateOnlineStaffAssoc" id="hPgAssoc"          value="0" />
                <input type="hidden" name="PostgraduateOnlineStaffAsst"  id="hPgAsst"           value="0" />
                <input type="hidden" name="Professor"                    id="hTotalProf"        value="0" />
                <input type="hidden" name="AssociateProfessor"           id="hTotalAssoc"       value="0" />
                <input type="hidden" name="AssistantProfessor"           id="hTotalAsst"        value="0" />
                <input type="hidden" name="SynchronousEvidenceFileName"  id="syncEvidenceFileNameHidden" value="" />

                <!-- ── 1. ONLINE PROGRAMS ─────────────────────────────────── -->
                <section class="card" id="sec-programs">
                    <div class="card-hd">
                        <h2>Online Programs</h2>
                        <p>Select from your existing Bachelor or Postgraduate programs. Staff numbers are shown at academic level, not per program.</p>
                    </div>
                    <div class="card-bd">

                        <!-- Note -->
                        <div style="display:flex; align-items:flex-start; gap:10px; background:#fef9ec; border:1px solid #fde68a; border-radius:10px; padding:12px 16px; margin-bottom:18px;">
                            <span style="font-size:16px; flex-shrink:0;">📌</span>
                            <span style="font-size:13px; color:#78350f; line-height:1.6;">
                                Online programs must be selected from existing <strong>Bachelor</strong> or <strong>Postgraduate</strong> programs already entered in the request.
                            </span>
                        </div>

                        <!-- Empty state -->
                        <div id="emptyState" class="empty-state">
                            No online programs added yet. Use <strong>Add Online Program</strong> below to begin.
                        </div>

                        <!-- Programs table -->
                        <div style="overflow-x:auto;margin-top:4px;" id="progTableWrap">
                            <table class="prog-tbl" id="progTable">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th>Program Name</th>
                                        <th>Degree Level</th>
                                        <th>College / Faculty</th>
                                        <th>Delivery Mode</th>
                                        <th class="col-students">Online Students</th>
                                        <th style="text-align:center;">Years</th>
                                        <th style="text-align:center;white-space:nowrap;">Sync Ratio</th>
                                        <th class="col-act"></th>
                                    </tr>
                                </thead>
                                <tbody id="progTableBody"></tbody>
                            </table>
                        </div>

                        <!-- Add button -->
                        <div class="actions" style="margin-top:14px;">
                            <button type="button" class="btn-ghost" id="addProgBtn" onclick="showAddForm()">
                                + Add Online Program
                            </button>
                        </div>

                        <!-- Add panel -->
                        <div id="addPanel" style="display:none;">
                            <div class="add-panel">
                                <div class="add-panel-title">Add Online Program</div>

                                <!-- Step 1: Category -->
                                <div class="field">
                                    <div class="step-lbl">Step 1 — Select Category</div>
                                    <div class="cat-row">
                                        <button type="button" class="cat-btn" id="catBachBtn" onclick="selectCategory('Bachelor')">Bachelor</button>
                                        <button type="button" class="cat-btn" id="catPGBtn"   onclick="selectCategory('Postgraduate')">Postgraduate</button>
                                    </div>
                                </div>

                                <!-- Step 2: Program -->
                                <div id="step2" style="display:none;">
                                    <div class="field">
                                        <div class="step-lbl">Step 2 — Select Program</div>

                                        <div id="bachProgWrap" style="display:none;">
                                            <select id="bachProgSel" onchange="onBachProgramChange()"
                                                    style="width:calc(100% - 16px);margin-left:8px;padding:11px 12px;border:1px solid #e2ddd6;border-radius:12px;font-size:14px;background:#fff;outline:none;">
                                                <option value="">-- Select Bachelor Program --</option>
                                            </select>
                                        </div>

                                        <div id="pgProgWrap" style="display:none;">
                                            <select id="pgProgSel" onchange="onPgProgramChange()"
