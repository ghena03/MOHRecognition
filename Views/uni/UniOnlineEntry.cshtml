        // ── Pre-submit: populate hidden inputs ─────────────────────────────
       function buildSubmitData() {
    // Copy Public Info fields (outside the form) into hidden inputs inside the form
    ['InstitutionName', 'OversightRightsEntity', 'FoundationDate', 'DateOfEstablishment',
     'ModeOfStudy', 'LanguageOfInstruction', 'StartOfTeaching', 'PresidentName',
     'MailingFullAddress', 'DirectPhoneNumber', 'EmailAddress', 'InstitutionalWebAddress',
     'Country', 'Location'].forEach(function(fieldName) {
        var src = document.querySelector('#sec-pubinfo [name="' + fieldName + '"]');
        if (!src) return;
        var form = document.getElementById('mainForm');
        var hidden = form.querySelector('input[type="hidden"][name="' + fieldName + '"]');
        if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = fieldName;
            form.appendChild(hidden);
        }
        hidden.value = src.value;
    });

    // Read manually entered values from the number inputs
    var bnProf  = parseInt(document.getElementById('bn-prof')?.value)  || 0;
    var bnAssoc = parseInt(document.getElementById('bn-assoc')?.value) || 0;
    var bnAsst  = parseInt(document.getElementById('bn-asst')?.value)  || 0;
    var pgProf  = parseInt(document.getElementById('pg-prof')?.value)  || 0;
    var pgAssoc = parseInt(document.getElementById('pg-assoc')?.value) || 0;
    var pgAsst  = parseInt(document.getElementById('pg-asst')?.value)  || 0;

    var bnStudents = parseInt(document.getElementById('bn-students')?.value) || 0;
    var pgStudents = parseInt(document.getElementById('pg-students')?.value) || 0;

    document.getElementById('hBachProf').value      = bnProf;
    document.getElementById('hBachAssoc').value     = bnAssoc;
    document.getElementById('hBachAsst').value      = bnAsst;
    document.getElementById('hPgProf').value        = pgProf;
    document.getElementById('hPgAssoc').value       = pgAssoc;
    document.getElementById('hPgAsst').value        = pgAsst;
    document.getElementById('hTotalProf').value     = bnProf  + pgProf;
    document.getElementById('hTotalAssoc').value    = bnAssoc + pgAssoc;
    document.getElementById('hTotalAsst').value     = bnAsst  + pgAsst;
    document.getElementById('hTotalStudents').value = programs.reduce(function(s,p){ return s + (p.OnlineStudents||0); }, 0);

    document.getElementById('programsJsonInput').value = JSON.stringify(
        programs.map(function(p) {
            return {
                ProgramName:             p.ProgramName,
                DegreeLevel:             p.DegreeLevel,
                Source:                  p.Source,
                CollegeOrFaculty:        p.CollegeOrFaculty,
                DeliveryMode:            p.DeliveryMode,
                OnlineStudents:          p.OnlineStudents,
                OnlineDurationYears:     p.OnlineDurationYears || null,
                TraditionalDurationYears: p.TraditionalDurationYears || null,
                SynchronousRatioPercent: p.SynchronousRatioPercent != null ? p.SynchronousRatioPercent : null,
                Professor:               null,
                AssociateProfessor:      null,
                AssistantProfessor:      null,
                StudyPlanFileName:       null,
                AccreditationEvidenceFileName: null
            };
        })
    );
}


        function uploadSharedSyncEvidence(input) {
            var statusEl = document.getElementById('syncEvidenceStatus');
            var hiddenEl = document.getElementById('syncEvidenceFileNameHidden');
            function setStatus(text, type) {
                var colors = { success: '#16a34a', error: '#b91c1c', info: '#6b7280' };
                statusEl.setAttribute('style', 'font-size:14px;font-weight:600;white-space:nowrap;color:' + (colors[type] || colors.info));
                statusEl.textContent = text;
            }
            if (!input.files || !input.files[0]) { hiddenEl.value = ''; statusEl.textContent = ''; return; }
            var file = input.files[0];
            if (!file.name.toLowerCase().endsWith('.pdf')) {
                setStatus('✗ Only PDF files accepted', 'error');
                hiddenEl.value = '';
                return;
            }
            setStatus('Uploading…', 'info');
            var fd = new FormData();
            fd.append('file', file);
            fetch('/Home/UploadSynchronousEvidence', { method: 'POST', body: fd })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.success) {
                        hiddenEl.value = data.fileName;
                        setStatus('✔', 'success');
                    } else {
                        hiddenEl.value = '';
                        setStatus('✗ ' + (data.message || 'Upload failed'), 'error');
                    }
                })
                .catch(function() {
                    hiddenEl.value = '';
                    setStatus('✗ Upload error', 'error');
                });
        }

        function esc(s)  { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
        function escA(s) { return (s||'').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

        // ── Submit confirmation ────────────────────────────────────────────
        document.getElementById('mainForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var validation = validateFullOnlineForm();
            if (!validation.ok) {
                focusFirstInvalid(validation.firstInvalid);
                Swal.fire({
                    icon: 'error',
                    title: 'Incomplete Form',
                    text: 'Please complete all required fields before submitting.'
                });
                return;
            }

            buildSubmitData();
            var form = this;
            Swal.fire({
                icon: 'question',
                title: 'Submit Application?',
                html: "<p style='font-size:14px;color:#555;margin:0'>Your Online Education application will be submitted to the Ministry for review.</p>",
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Review First',
                showCancelButton: true,
                confirmButtonColor: '#9e1b32'
            }).then(function(r){ if (r.isConfirmed) form.submit(); });
        });
    </script>

