        function confirmAdd() {
            clearSectionValidation('sec-programs');
            if (!addCategory) {
                appendGroupError(document.querySelector('.cat-row'), 'This field is required.');
                return;
            }

            var progName;
            if (isManual) {
                progName = (document.getElementById('manualProgName').value || '').trim();
                if (!progName) {
                    setFieldError(document.getElementById('manualProgName'), 'This field is required.');
                    focusFirstInvalid(document.getElementById('manualProgName'));
                    return;
                }
            } else if (addCategory === 'Bachelor') {
                progName = document.getElementById('bachProgSel').value;
                if (!progName) {
                    appendGroupError(document.getElementById('bachProgWrap'), 'This field is required.');
                    focusFirstInvalid(document.getElementById('bachProgSel'));
                    return;
                }
            } else {
                progName = document.getElementById('pgProgSel').value;
                if (!progName) {
                    appendGroupError(document.getElementById('pgProgWrap'), 'This field is required.');
                    focusFirstInvalid(document.getElementById('pgProgSel'));
                    return;
                }
                if (!addLevel) addLevel = 'Master';
            }

            var collegeInput   = document.getElementById('addCollege');
            var studentsInput  = document.getElementById('addStudents');
            var durationInput  = document.getElementById('addDuration');
            var college     = collegeInput.value.trim();
            var studentsRaw = studentsInput.value.trim();
            var students    = parseInt(studentsRaw, 10) || 0;
            var durationRaw = durationInput.value.trim();
            var duration    = parseInt(durationRaw, 10);

            if (!college) {
                setFieldError(collegeInput, 'This field is required.');
                focusFirstInvalid(collegeInput);
                return;
            }
            clearFieldError(collegeInput);

            if (!studentsRaw) {
                setFieldError(studentsInput, 'This field is required.');
                focusFirstInvalid(studentsInput);
                return;
            }
            clearFieldError(studentsInput);

            if (!durationRaw || isNaN(duration) || duration < 1) {
                setFieldError(durationInput, 'Duration is required and must be at least 1 year.');
                focusFirstInvalid(durationInput);
                return;
            }
            clearFieldError(durationInput);

            // Synchronous ratio (required, 0–100)
            var syncRatioInput = document.getElementById('addSyncRatio');
            var syncRatioRaw   = syncRatioInput.value.trim();
            var syncRatio      = parseFloat(syncRatioRaw);
            if (syncRatioRaw === '' || isNaN(syncRatio)) {
                setFieldError(syncRatioInput, 'Synchronous learning ratio is required.');
                focusFirstInvalid(syncRatioInput);
                return;
            }
            if (syncRatio < 0 || syncRatio > 100) {
                setFieldError(syncRatioInput, 'Ratio must be between 0 and 100.');
                focusFirstInvalid(syncRatioInput);
                return;
            }
            clearFieldError(syncRatioInput);

            var delivery = (document.querySelector('[name=addDelivery]:checked') || {}).value || 'Fully Online';
            var src      = isManual ? 'Manual Entry'
                         : addCategory === 'Bachelor' ? 'Bachelor' : 'Postgraduate';

            programs.push({
                ProgramName:             progName,
                DegreeLevel:             addLevel || (addCategory === 'Bachelor' ? 'Bachelor' : 'Master'),
                Source:                  src,
                CollegeOrFaculty:        college,
                DeliveryMode:            delivery,
                OnlineStudents:          students,
                OnlineDurationYears:     duration,
                TraditionalDurationYears: pgTraditionalYears || null,
                SynchronousRatioPercent: syncRatio,
                category:                addCategory,
                isManual:                isManual
            });

            hideAddForm();
            renderTable();
updateOverallTotals();
        }

        function removeProgram(idx) {
            programs.splice(idx, 1);
           renderTable();
updateOverallTotals();
        }

        function renderTable() {
            var empty = document.getElementById('emptyState');
            var wrap  = document.getElementById('progTableWrap');
            var tbody = document.getElementById('progTableBody');

            if (programs.length === 0) {
                empty.style.display = 'block';
                wrap.style.display  = 'none';
                return;
            }
            empty.style.display = 'none';
            wrap.style.display  = 'block';

            tbody.innerHTML = programs.map(function(p, i) {
                var catBadge = p.category === 'Bachelor'
                    ? '<span class="badge badge-bach">Bachelor</span>'
                    : '<span class="badge badge-pg">Postgraduate</span>';

                var modeBadge = p.DeliveryMode === 'Fully Online'
                    ? '<span class="badge badge-online">Fully Online</span>'
                    : '<span class="badge badge-blended">Blended</span>';

                var ratio = p.SynchronousRatioPercent;
                var syncBadge;
                if (ratio === null || ratio === undefined) {
                    syncBadge = '<span class="badge badge-sync-warn">—</span>';
                } else if (ratio >= 33.33) {
                    syncBadge = '<span class="badge badge-sync-pass">' + ratio + '%</span>';
                } else {
                    syncBadge = '<span class="badge badge-sync-fail">' + ratio + '%</span>';
                }

                return '<tr>' +
                    '<td>' + catBadge + '</td>' +
                    '<td style="font-weight:700;">' + esc(p.ProgramName) + '</td>' +
                    '<td>' + esc(p.DegreeLevel) + '</td>' +
                    '<td style="color:#5b6472;">' + esc(p.CollegeOrFaculty || '—') + '</td>' +
                    '<td>' + modeBadge + '</td>' +
                    '<td style="text-align:center;font-weight:700;">' + (p.OnlineStudents || 0) + '</td>' +
                    '<td style="text-align:center;font-weight:600;">' + (p.OnlineDurationYears || '—') + '</td>' +
                    '<td style="text-align:center;">' + syncBadge + '</td>' +
                    '<td class="col-act"><button type="button" class="del-btn" onclick="removeProgram(' + i + ')">Delete</button></td>' +
                    '</tr>';
            }).join('');
        }

