@model DTOs.MedicineDentistryDto

@{
    string N(int? v) => v.HasValue ? v.Value.ToString() : "";
    bool hasMed = Model.HasMedicine;
    bool hasDen = Model.HasDentistry;
    var tsClass = ((!hasMed ? "hide-medicine " : "") + (!hasDen ? "hide-dentistry" : "")).Trim();
}

<style>
    .hide-medicine  .sst-col-medicine  { display: none !important; }
    .hide-dentistry .sst-col-dentistry { display: none !important; }

    /* ── College selection ───────────────────────────────────── */
    .medden-cs-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 8px; }
    .medden-cs-row .cs-field-label { font-size: 12px; font-weight: 600; color: #9ca3af; white-space: nowrap; }
    .medden-cs-row .cs-options { display: flex; gap: 16px; flex-wrap: wrap; }
    .medden-cs-row .cs-option { display: flex; align-items: center; gap: 5px; cursor: pointer; }
    .medden-cs-row .cs-option input[type=checkbox] { width: 13px; height: 13px; accent-color: #9f1239; cursor: pointer; margin: 0; }
    .medden-cs-row .cs-option span { font-size: 12.5px; font-weight: 500; color: #374151; user-select: none; }
    .medden-no-colleges { background: #fef9c3; border: 1px solid #fde68a; color: #78350f; border-radius: 8px; padding: 12px 16px; font-size: 13px; text-align: center; margin: 4px 0 16px; }
</style>

<div class="duration-wrap medden-wrap" style="margin-top:0;">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <div class="medden-page-hd">
        <div class="medden-page-hd-icon">🩺</div>
        <div>
            <div class="medden-page-hd-title">Doctors / Medicine Colleges</div>
            <div class="medden-page-hd-sub">Fill in the academic staff counts for the selected clinical colleges.</div>
            <div class="medden-cs-row">
                <span class="cs-field-label">Clinical Colleges:</span>
                <div class="cs-options">
                    <label id="lbl_medicine" class="cs-option medden-cs-med">
                        <input type="checkbox" id="chk_medicine" @(hasMed ? "checked" : "") />
                        <span>Medicine</span>
                    </label>
                    <label id="lbl_dentistry" class="cs-option medden-cs-den">
                        <input type="checkbox" id="chk_dentistry" @(hasDen ? "checked" : "") />
                        <span>Dentistry</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div id="medDenBanner" class="banner warn medden-banner" style="display:none;">
        <span class="dot"></span>
        <span class="txt"></span>
        <button type="button" class="x" onclick="document.getElementById('medDenBanner').style.display='none'">×</button>
    </div>

    <!-- ── Academic Staff Table ───────────────────────────────── -->
    <div id="medden-table-section" class="@tsClass">
        <div class="medden-table-wrap">
            <table class="tbl staff-split-table">
                <thead>
                    <tr>
                        <th class="sst-cat-col">Category</th>
                        <th class="sst-coll-col sst-col-medicine">🏥 College of Medicine</th>
                        <th class="sst-coll-col sst-col-dentistry">🦷 College of Dentistry</th>
                    </tr>
                </thead>
                <tbody>

                    <tr class="sst-total-row">
                        <td class="sst-cat">Total Students</td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row">
                                    <span class="irow-lbl">Students</span>
                                    <input class="num" id="med_totalStudents" type="number" min="0" step="1" value="@N(Model.Med_TotalStudents)" />
                                </div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row">
                                    <span class="irow-lbl">Students</span>
                                    <input class="num" id="den_totalStudents" type="number" min="0" step="1" value="@N(Model.Den_TotalStudents)" />
                                </div>
                            </div>
                        </td>
                    </tr>

                    <tr class="sst-phd-row">
                        <td class="sst-cat">Professor</td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimeProfessor" type="number" min="0" step="1" value="@N(Model.Med_FullTimeProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="med_partTimeClinicalProfessor" type="number" min="0" step="1" value="@N(Model.Med_PartTimeClinicalProfessor)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimeProfessor" type="number" min="0" step="1" value="@N(Model.Den_FullTimeProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="den_partTimeClinicalProfessor" type="number" min="0" step="1" value="@N(Model.Den_PartTimeClinicalProfessor)" /></div>
                            </div>
                        </td>
                    </tr>

                    <tr class="sst-phd-row">
                        <td class="sst-cat">Associate Professor</td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimeAssociateProfessor" type="number" min="0" step="1" value="@N(Model.Med_FullTimeAssociateProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="med_partTimeClinicalAssociateProfessor" type="number" min="0" step="1" value="@N(Model.Med_PartTimeClinicalAssociateProfessor)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimeAssociateProfessor" type="number" min="0" step="1" value="@N(Model.Den_FullTimeAssociateProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="den_partTimeClinicalAssociateProfessor" type="number" min="0" step="1" value="@N(Model.Den_PartTimeClinicalAssociateProfessor)" /></div>
                            </div>
                        </td>
                    </tr>

                    <tr class="sst-phd-row">
                        <td class="sst-cat">Assistant Professor</td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimeAssistantProfessor" type="number" min="0" step="1" value="@N(Model.Med_FullTimeAssistantProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="med_partTimeClinicalAssistantProfessor" type="number" min="0" step="1" value="@N(Model.Med_PartTimeClinicalAssistantProfessor)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimeAssistantProfessor" type="number" min="0" step="1" value="@N(Model.Den_FullTimeAssistantProfessor)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="den_partTimeClinicalAssistantProfessor" type="number" min="0" step="1" value="@N(Model.Den_PartTimeClinicalAssistantProfessor)" /></div>
                            </div>
                        </td>
                    </tr>

                    <tr class="sst-phd-row">
                        <td class="sst-cat">Lecturer and Assistant Lecturer <span class="sst-qual">(PhD)</span>
                            <div style="font-size:10.5px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:4px;padding:3px 6px;margin-top:5px;line-height:1.45;">
                                <i class="bi bi-exclamation-triangle-fill" style="font-size:9px;"></i> <em>Medicine only:</em> must hold Double Board / Consultant-level qualification
                            </div>
                        </td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimeLecturerAssistantPhd" type="number" min="0" step="1" value="@N(Model.Med_FullTimeLecturerAssistantPhd)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="med_partTimeClinicalLecturerAssistantPhd" type="number" min="0" step="1" value="@N(Model.Med_PartTimeClinicalLecturerAssistantPhd)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimeLecturerAssistantPhd" type="number" min="0" step="1" value="@N(Model.Den_FullTimeLecturerAssistantPhd)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="den_partTimeClinicalLecturerAssistantPhd" type="number" min="0" step="1" value="@N(Model.Den_PartTimeClinicalLecturerAssistantPhd)" /></div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="sst-cat">Lecturer and Assistant Lecturer <span class="sst-qual">(MSc)</span>
                            <div style="font-size:10.5px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:4px;padding:3px 6px;margin-top:5px;line-height:1.45;">
                                <i class="bi bi-exclamation-triangle-fill" style="font-size:9px;"></i> <em>Medicine only:</em> must hold First Board / Specialist-level qualification
                            </div>
                        </td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimeLecturerAssistantMsc" type="number" min="0" step="1" value="@N(Model.Med_FullTimeLecturerAssistantMsc)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="med_partTimeClinicalLecturerAssistantMsc" type="number" min="0" step="1" value="@N(Model.Med_PartTimeClinicalLecturerAssistantMsc)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimeLecturerAssistantMsc" type="number" min="0" step="1" value="@N(Model.Den_FullTimeLecturerAssistantMsc)" /></div>
                                <div class="input-row"><span class="irow-lbl pt">Part-Time</span><input class="num" id="den_partTimeClinicalLecturerAssistantMsc" type="number" min="0" step="1" value="@N(Model.Den_PartTimeClinicalLecturerAssistantMsc)" /></div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="sst-cat">Practitioner <span class="sst-qual">(MSc)</span>
                            <div style="font-size:10.5px;color:#065f46;background:#d1fae5;border:1px solid #6ee7b7;border-radius:4px;padding:3px 6px;margin-top:5px;line-height:1.45;">
                                <i class="bi bi-stethoscope" style="font-size:9px;"></i> Clinical/practical training only — not counted as lecturer for theoretical teaching
                            </div>
                            <div style="font-size:10.5px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:4px;padding:3px 6px;margin-top:4px;line-height:1.45;">
                                <i class="bi bi-exclamation-triangle-fill" style="font-size:9px;"></i> <em>Medicine only:</em> must hold First Board / Specialist-level qualification
                            </div>
                            <div style="font-size:10.5px;color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:4px;padding:3px 6px;margin-top:4px;line-height:1.45;">
                                <i class="bi bi-exclamation-triangle-fill" style="font-size:9px;"></i> must have at least 3 years of clinical experience
                            </div>
                        </td>
                        <td class="sst-cell sst-col-medicine">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="med_fullTimePractitionerMsc" type="number" min="0" step="1" value="@N(Model.Med_FullTimePractitionerMsc)" /></div>
                            </div>
                        </td>
                        <td class="sst-cell sst-col-dentistry">
                            <div class="input-stack">
                                <div class="input-row"><span class="irow-lbl ft">Full-Time</span><input class="num" id="den_fullTimePractitionerMsc" type="number" min="0" step="1" value="@N(Model.Den_FullTimePractitionerMsc)" /></div>
                            </div>
                        </td>
                    </tr>

                    <!-- Practitioner (BSc) row removed — not applicable for Medicine; not used for Dentistry entry -->
                    <input type="hidden" id="med_fullTimePractitionerPsc" value="0" />
                    <input type="hidden" id="den_fullTimePractitionerPsc" value="0" />

                </tbody>
            </table>
        </div>

        <!-- ── Computed Read-Only Summary ─────────────────────────── -->
        <div class="medden-summary-wrap">
            <div class="medden-summary-title">Computed Read-Only Summary</div>
            <div class="medden-summary-sub">Totals are automatically calculated for each selected college.</div>

            <!-- Hidden legacy elements kept for JS compat -->
            <input type="hidden" id="med_pscHolders" value="0" />
            <input type="hidden" id="den_pscHolders" value="@Model.Den_PscHolders" />
            <input type="hidden" id="med_mscHolders" value="@Model.Med_MscHolders" />
            <input type="hidden" id="den_mscHolders" value="@Model.Den_MscHolders" />

            <!-- No-colleges message (shown when neither Medicine nor Dentistry is selected) -->
            <div id="medden-summary-empty" class="medden-no-colleges" style="display:@(!Model.HasMedicine && !Model.HasDentistry ? "flex" : "none"); align-items:center; gap:8px; justify-content:center; margin-bottom:0;">
                <i class="bi bi-dash-circle"></i> No clinical college selected — summary not applicable.
            </div>

            <div class="medden-summary-grid" id="medden-summary-grid">
                <!-- Medicine cards -->
                <div class="medden-summary-item sst-col-medicine">
                    <div class="medden-summary-label">Full-Time PhD (Medicine)</div>
                    <input class="medden-summary-value" id="med_phdHolders" type="number" value="@Model.Med_PhdHolders" readonly />
                </div>
                <div class="medden-summary-item sst-col-medicine">
                    <div class="medden-summary-label">Full-Time MSc (Medicine)</div>
                    <input class="medden-summary-value" id="med_mscLecturers" type="number" value="@Model.Med_MscLecturers" readonly />
                </div>
                <div class="medden-summary-item sst-col-medicine">
                    <div class="medden-summary-label">Full-Time Practitioner (Medicine)</div>
                    <input class="medden-summary-value" id="med_practitionerTotal" type="number" value="@Model.Med_PractitionerTotal" readonly />
                </div>
                <div class="medden-summary-item medden-summary-item--pt sst-col-medicine">
                    <div class="medden-summary-label">Part-Time Total (Medicine)</div>
                    <input class="medden-summary-value" id="med_totalPartTime" type="number" value="@Model.Med_TotalPartTime" readonly />
                </div>

                <!-- Dentistry cards -->
                <div class="medden-summary-item sst-col-dentistry">
                    <div class="medden-summary-label">Full-Time PhD (Dentistry)</div>
                    <input class="medden-summary-value" id="den_phdHolders" type="number" value="@Model.Den_PhdHolders" readonly />
                </div>
                <div class="medden-summary-item sst-col-dentistry">
                    <div class="medden-summary-label">Full-Time MSc (Dentistry)</div>
                    <input class="medden-summary-value" id="den_mscLecturers" type="number" value="@Model.Den_MscLecturers" readonly />
                </div>
                <div class="medden-summary-item sst-col-dentistry">
                    <div class="medden-summary-label">Full-Time Practitioner (Dentistry)</div>
                    <input class="medden-summary-value" id="den_practitionerTotal" type="number" value="@Model.Den_PractitionerTotal" readonly />
                </div>
                <div class="medden-summary-item medden-summary-item--pt sst-col-dentistry">
                    <div class="medden-summary-label">Part-Time Total (Dentistry)</div>
                    <input class="medden-summary-value" id="den_totalPartTime" type="number" value="@Model.Den_TotalPartTime" readonly />
                </div>
            </div>

        </div>
    </div><!-- #medden-table-section -->

</div>
