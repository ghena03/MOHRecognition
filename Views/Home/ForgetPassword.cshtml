@model DTOs.ForgetPasswordDto
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <title>@(isRtl ? "نسيت كلمة المرور" : "Forgot Password")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/ForgetPassword.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>

<body class="@(isRtl ? "rtl-body" : "")">
    <div class="page">

        <div class="admin-header">
            <h2>@(isRtl ? "نسيت كلمة المرور" : "Forgot Password")</h2>
            <p>@(isRtl ? "أعد التعيين عبر البريد الإلكتروني أو الهاتف، ثم أدخل رمز التحقق" : "Reset using Email or Phone, then enter the verification code")</p>
        </div>

        <div class="card">

            <div class="sign">
                <img src="https://rnji.mohe.gov.jo/AppLogin/images/SIGN.jpg" alt="MOHE">
            </div>

            <div class="panel">
                <h1>@(isRtl ? "التحقق" : "Verification")</h1>
                <p class="subtext">
                    @(isRtl ? "اختر طريقة، ثم أدخل الرمز المكوّن من 6 أرقام الذي سنرسله إليك." : "Choose a method, then enter the 6-digit code we send you.")
                </p>

                <div asp-validation-summary="All" class="error"></div>

                <form asp-controller="Home" asp-action="ForgetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="role" value="@(ViewBag.Role ?? "admin")" />

                    <div class="method">
                        <input type="radio" id="mEmail" name="Method" value="email" checked>
                        <label for="mEmail" class="pill">@(isRtl ? "البريد الإلكتروني" : "Email")</label>

                        <input type="radio" id="mPhone" name="Method" value="phone">
                        <label for="mPhone" class="pill">@(isRtl ? "الهاتف" : "Phone")</label>
                    </div>

                    <div class="row method-email">
                        <span class="icon">📧</span>
                        <input asp-for="Email" type="email" placeholder="@(isRtl ? "عنوان البريد الإلكتروني" : "Email address")">
                    </div>
                    <span class="field-error" asp-validation-for="Email"></span>

                    <div class="row method-phone">
                        <span class="icon">📱</span>
                        <input asp-for="Phone" type="tel" placeholder="@(isRtl ? "رقم الهاتف (مثال: 079xxxxxxx)" : "Phone number (e.g. 079xxxxxxx)")">
                    </div>
                    <span class="field-error" asp-validation-for="Phone"></span>

                    <button class="secondary" type="button">@(isRtl ? "إرسال الرمز" : "Send Code")</button>

                    <div class="code-block">
                        <div class="code-title">@(isRtl ? "رمز التحقق" : "Verification Code")</div>

                        <input asp-for="Code" type="hidden" id="Code" />

                        <div class="code-inputs" aria-label="@(isRtl ? "رمز مكوّن من 6 أرقام" : "6 digit code")">
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 1" : "Digit 1")" required>
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 2" : "Digit 2")" required>
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 3" : "Digit 3")" required>
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 4" : "Digit 4")" required>
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 5" : "Digit 5")" required>
                            <input class="code-box" type="text" inputmode="numeric" maxlength="1" aria-label="@(isRtl ? "الرقم 6" : "Digit 6")" required>
                        </div>

                        <span class="field-error" asp-validation-for="Code"></span>

                        <div class="code-hint">
                            @(isRtl ? "لم تستلمه؟" : "Didn't get it?") <a href="#">@(isRtl ? "إعادة الإرسال" : "Resend")</a>
                        </div>
                    </div>

                    <button class="primary" type="submit">@(isRtl ? "تحقق ومتابعة" : "Verify & Continue")</button>

                    <div class="actions">
                        <a class="link" asp-controller="Home" asp-action="AdminLogIn">@(isRtl ? "→ العودة إلى تسجيل الدخول" : "← Back to Login")</a>
                    </div>

                </form>
            </div>

        </div>
    </div>

    <script>
        function updateMethodUI() {
            const useEmail = document.getElementById("mEmail").checked;
            document.querySelector(".method-email").style.display = useEmail ? "flex" : "none";
            document.querySelector(".method-phone").style.display = useEmail ? "none" : "flex";
            document.querySelector('input[name="Email"]').required = useEmail;
            document.querySelector('input[name="Phone"]').required = !useEmail;
        }

        document.getElementById("mEmail").addEventListener("change", updateMethodUI);
        document.getElementById("mPhone").addEventListener("change", updateMethodUI);
        window.addEventListener("load", updateMethodUI);

        const inputs = Array.from(document.querySelectorAll(".code-box"));
        const hidden = document.getElementById("Code");

        function syncHidden() {
            hidden.value = inputs.map(i => i.value).join("");
        }

        inputs.forEach((input, idx) => {
            input.addEventListener("input", () => {
                input.value = input.value.replace(/\D/g, "");
                if (input.value && idx < inputs.length - 1) inputs[idx + 1].focus();
                syncHidden();
            });

            input.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !input.value && idx > 0) inputs[idx - 1].focus();
            });

            input.addEventListener("paste", (e) => {
                const text = (e.clipboardData || window.clipboardData).getData("text");
                const digits = (text || "").replace(/\D/g, "").slice(0, inputs.length);
                if (!digits) return;
                e.preventDefault();
                digits.split("").forEach((d, i) => inputs[i].value = d);
                inputs[Math.min(digits.length, inputs.length) - 1].focus();
                syncHidden();
            });
        });

        window.addEventListener("load", () => inputs[0].focus());
    </script>
</body>
</html>
