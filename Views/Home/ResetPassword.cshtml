@model DTOs.ResetPasswordDto
@{
    Layout = null;
    var role = (ViewBag.Role as string ?? "admin").ToLower();
    var culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = culture == "ar";
    var dir = isRtl ? "rtl" : "ltr";
}

<!doctype html>
<html lang="@culture" dir="@dir">
<head>
    <meta charset="utf-8" />
    <title>@(isRtl ? "إعادة تعيين كلمة المرور" : "Reset Password")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/ResetPassword.css" asp-append-version="true" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" asp-append-version="true" />
    }
</head>

<body class="@(isRtl ? "rtl-body" : "")">
    <main class="page">
        <section class="shell">

            <header class="heroBar">
                <h2>@(isRtl ? "إعادة تعيين كلمة المرور" : "Reset Password")</h2>
                <p>@(isRtl ? "أنشئ كلمة مرور جديدة لحسابك" : "Create a new password for your account")</p>
            </header>

            <div class="card">
                <aside class="brand">
                    <img src="https://rnji.mohe.gov.jo/AppLogin/images/SIGN.jpg" alt="MOHE" />
                </aside>

                <section class="content">
                    <div class="title">
                        <h1>@(isRtl ? "كلمة المرور الجديدة" : "New Password")</h1>
                        <p>@(isRtl ? "أدخل كلمة المرور الجديدة وأكّدها." : "Enter your new password and confirm it.")</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert--error" role="alert"></div>
                    }

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert--success" role="alert">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <div class="hint">
                        <span class="hint__badge">@(isRtl ? "تنبيه" : "Tip")</span>
                        @(isRtl ? "يجب أن تحتوي كلمة المرور على 8 أحرف على الأقل، وحرف كبير، وحرف خاص." : "Password must be 8+ chars, include 1 uppercase, and 1 special character.")
                    </div>

                    <form id="resetForm" asp-controller="Home" asp-action="ResetPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="@role" />

                        <div class="field">
                            <label asp-for="NewPassword">@(isRtl ? "كلمة المرور الجديدة" : "New Password")</label>

                            <div class="input">
                                <span class="input__icon" aria-hidden="true">🔒</span>

                                <input asp-for="NewPassword"
                                       type="password"
                                       id="newPass"
                                       placeholder="@(isRtl ? "أدخل كلمة المرور الجديدة" : "Enter new password")"
                                       minlength="8"
                                       autocomplete="new-password" />

                                <button type="button" class="input__action" id="eyeNew"
                                        aria-label="@(isRtl ? "إظهار كلمة المرور" : "Show password")"
                                        data-show="@(isRtl ? "إظهار" : "Show")"
                                        data-hide="@(isRtl ? "إخفاء" : "Hide")">
                                    @(isRtl ? "إظهار" : "Show")
                                </button>
                            </div>

                            <span class="field-error" asp-validation-for="NewPassword"></span>
                            <small class="field__help">
                                @(isRtl ? "8 أحرف على الأقل • حرف كبير واحد • حرف خاص (!@#$%^&*)" : "8+ chars • 1 uppercase • 1 special (!&#64;#$%^&*)")
                            </small>
                        </div>

                        <div class="field">
                            <label asp-for="ConfirmPassword">@(isRtl ? "تأكيد كلمة المرور" : "Confirm Password")</label>

                            <div class="input">
                                <span class="input__icon" aria-hidden="true">✅</span>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       id="confirmPass"
                                       placeholder="@(isRtl ? "أعد إدخال كلمة المرور الجديدة" : "Re-enter new password")"
                                       minlength="8"
                                       autocomplete="new-password" />

                                <button type="button" class="input__action" id="eyeConfirm"
                                        aria-label="@(isRtl ? "إظهار كلمة المرور" : "Show password")"
                                        data-show="@(isRtl ? "إظهار" : "Show")"
                                        data-hide="@(isRtl ? "إخفاء" : "Hide")">
                                    @(isRtl ? "إظهار" : "Show")
                                </button>
                            </div>

                            <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                            <small class="field__help">@(isRtl ? "يجب أن تتطابق تماماً." : "Must match exactly.")</small>
                        </div>

                        <div class="alert alert--error" id="errorBox" style="display:none;" aria-live="polite"></div>

                        <button class="btn" type="submit">@(isRtl ? "تحديث كلمة المرور" : "Update Password")</button>

                        <div class="footer">
                            <a class="link"
                               asp-controller="Home"
                               asp-action="StaffLogIn"
                               asp-route-role="@role">
                                @(isRtl ? "العودة إلى تسجيل الدخول" : "Back to Login")
                            </a>
                        </div>
                    </form>
                </section>
            </div>

        </section>
    </main>

    <script>
        const isRtl = @(isRtl ? "true" : "false");
        const newPass = document.getElementById("newPass");
        const confirmPass = document.getElementById("confirmPass");
        const errorBox = document.getElementById("errorBox");

        function toggle(btn, input) {
            const hidden = input.type === "password";
            input.type = hidden ? "text" : "password";
            btn.textContent = hidden ? btn.dataset.hide : btn.dataset.show;
            btn.setAttribute("aria-label", hidden ? (isRtl ? "إخفاء كلمة المرور" : "Hide password") : (isRtl ? "إظهار كلمة المرور" : "Show password"));
            input.focus();
        }

        document.getElementById("eyeNew").addEventListener("click", function () {
            toggle(this, newPass);
        });

        document.getElementById("eyeConfirm").addEventListener("click", function () {
            toggle(this, confirmPass);
        });

        function isStrongPassword(p) {
            return p.length >= 8 && /[A-Z]/.test(p) && /[^A-Za-z0-9]/.test(p);
        }

        document.getElementById("resetForm").addEventListener("submit", function (e) {
            const p1 = (newPass.value || "").trim();
            const p2 = (confirmPass.value || "").trim();

            if (!p1 || !p2) {
                e.preventDefault();
                errorBox.textContent = isRtl ? "يرجى ملء حقلَي كلمة المرور." : "Please fill both password fields.";
                errorBox.style.display = "block";
                return;
            }

            if (!isStrongPassword(p1)) {
                e.preventDefault();
                errorBox.textContent = isRtl
                    ? "يجب أن تحتوي كلمة المرور على 8 أحرف على الأقل، وحرف كبير واحد، وحرف خاص واحد."
                    : "Password must be 8+ characters and include 1 uppercase letter and 1 special character.";
                errorBox.style.display = "block";
                return;
            }

            if (p1 !== p2) {
                e.preventDefault();
                errorBox.textContent = isRtl ? "كلمتا المرور غير متطابقتين." : "Passwords do not match.";
                errorBox.style.display = "block";
                return;
            }

            errorBox.style.display = "none";
        });
    </script>
</body>
</html>
